<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- 仓库内直接构建指向 artifacts/sdk-packages；发布 SDK 时由脚本改写为 ../../packages。 -->
    <add key="hyw-sdk" value="../../artifacts/sdk-packages" />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
</configuration>
