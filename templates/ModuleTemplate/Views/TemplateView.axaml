<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:local="using:HYWDebugAssistant.Template.MyModule"
               x:Class="HYWDebugAssistant.Template.MyModule.Views.TemplateView"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               InitialWidth="360" InitialHeight="180"
               MinWidth="360" MinHeight="180">

  <!-- 模板视图：标题 / 一个配置字段 / 两个读数 / 一个命令。 -->
  <Grid RowDefinitions="Auto,Auto,Auto,*,Auto" Margin="12">

    <ui:ModuleLabel Grid.Row="0" Classes="caption" Text="{loc:Tr view.title}" />

    <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="Auto,120" HorizontalAlignment="Left">
      <ui:ModuleLabel Grid.Column="0" Classes="caption right" Width="84" Height="24"
                      Field="{x:Static local:TemplateModule.IntervalField}" />
      <ui:ModuleConfigField Grid.Column="1" Width="120" Height="24"
                            Field="{x:Static local:TemplateModule.IntervalField}" />
    </Grid>

    <Grid Grid.Row="2" Margin="0,10,0,0" ColumnDefinitions="Auto,Auto,*" HorizontalAlignment="Left">
      <ui:ModuleLabel Grid.Column="0" Classes="caption" Text="{loc:Tr view.count}" VerticalAlignment="Center" />
      <ui:ModuleNumeric Grid.Column="1" Margin="10,0,0,0" Source="{x:Static local:TemplateModule.CountSource}"
                        Text="0" VerticalAlignment="Center" />
      <ui:ModuleLabel Grid.Column="2" Margin="16,0,0,0" Classes="hint"
                      Source="{x:Static local:TemplateModule.StateSource}"
                      Text="{loc:Tr state.ready}" VerticalAlignment="Center" />
    </Grid>

    <ui:ModuleButton Grid.Row="4" Width="88" Height="27" HorizontalAlignment="Left"
                     CommandName="{x:Static local:TemplateModule.ResetCommand}"
                     Content="{loc:Tr view.reset}" />
  </Grid>
</ui:ModuleView>
