{
  "schemaVersion": 1,
  "documentVersion": 1,
  "doc": "模块界面声明面 schema 草案（待裁）。全部默认值与约束的**唯一事实源**：读取器与控件代码里不得再出现默认值字面量（Q2）。用户 m03520 的 Q1C / Q2 / Q3 / Q4 / Q5 / Q6 / Q7 / Q8；配套说明见 .dsh/drafts/view-declaration-design.md。",
  "window": {
    "width": { "type": "number", "min": 1, "default": 320, "doc": "模块窗口标准宽（DIP）" },
    "height": { "type": "number", "min": 1, "default": 220, "doc": "模块窗口标准高（DIP）" },
    "minWidth": { "type": "number", "min": 1, "default": 180 },
    "minHeight": { "type": "number", "min": 1, "default": 160 },
    "maxWidth": { "type": "number", "min": 1, "default": null, "doc": "null = 无上限" },
    "maxHeight": { "type": "number", "min": 1, "default": null, "doc": "null = 无上限" }
  },
  "axes": {
    "doc": "每个轴一个尺寸对象；pixels / fill / adaptive 三选一。缺省规则见 defaultGeometry（C-14 建议 B：省略 = 用该 kind 的默认口径，默认值写在 schema 里而不是代码里）；absolute 容器里的元素两轴必须显式给 pixels。",
    "strategies": {
      "pixels": { "type": "number", "min": 1 },
      "fill": { "type": "bool", "const": true },
      "adaptive": { "type": "bool", "const": true }
    },
    "min": { "type": "number", "min": 0 },
    "max": { "type": "number", "min": 1 }
  },
  "defaultGeometry": {
    "doc": "每个 kind 的缺省尺寸口径（Q2：默认值只在这里给出，读取器与控件代码零默认）。声明里显式给出则覆盖。'*' = 所有节点的基线。容器那一档要与今天的 ArrangeOverride 实测对齐后再定稿（见设计草案 §13 待补）。",
    "*": { "width": { "fill": true }, "height": { "adaptive": true } },
    "textLog": { "height": { "fill": true }, "doc": "今天由代码里的 IsFill 类型判定决定，改为本表" },
    "textInput": { "height": { "adaptive": true }, "heightWhenMultiline": { "fill": true }, "doc": "多行时填满、单行时按内容" }
  },
  "tracks": {
    "doc": "列 / 行规格（仅 grid 容器）：'*'（等分）· 'N*'（权重）· 'auto'（按内容）· '≥1 的数值'（固定像素）",
    "forms": ["*", "N*", "auto", "number>=1"]
  },
  "commonProperties": {
    "doc": "所有节点都可用的键（容器与原子控件共用）。",
    "kind": { "type": "string", "required": true, "doc": "节点种类，必须是 nodes 里登记的 kind" },
    "title": { "type": "string", "default": "" },
    "stateKey": { "type": "string", "default": null, "doc": "折叠态 / 选中页等运行时状态的存储键；只被容器与 textInput 消费" },
    "width": { "$ref": "axes" },
    "height": { "$ref": "axes" },
    "scaleWithWindow": { "type": "bool", "default": false, "doc": "absolute 元素是否随窗口缩放" },
    "x": { "type": "number", "default": 0, "doc": "仅 absolute 容器内有效" },
    "y": { "type": "number", "default": 0, "doc": "仅 absolute 容器内有效" },
    "column": { "type": "integer", "default": null, "doc": "仅 grid：与 auto 只能选一条" },
    "row": { "type": "integer", "default": null },
    "columnSpan": { "type": "integer", "min": 1, "default": 1 },
    "rowSpan": { "type": "integer", "min": 1, "default": 1 },
    "auto": { "type": "bool", "default": false, "doc": "仅 grid：自动放置；不得与 column/row 混用（同一容器内两种写法也不能混用）" },
    "align": { "type": "enum", "values": ["stretch", "left", "center", "right"], "default": "stretch", "doc": "grid 格子内的横向对齐；与 textInput 的文本对齐（textAlign）不是同一个键 —— 命名冲突见草案 §14" },
    "verticalAlign": { "type": "enum", "values": ["stretch", "top", "center", "bottom"], "default": "stretch" },
    "showInlineResult": { "type": "bool", "default": true, "doc": "是否就地显示该元素的输入/保存结果行（关掉后结果只能去别的元素的 feedbackSource）" },
    "feedbackSource": { "type": "string", "default": null, "doc": "把该数据源的输入/保存反馈显示在本元素左下角（如 fileSelector 的 savePath 结果显示在 textLog 左下角）" }
  },
  "containers": {
    "doc": "4 种容器（C-1 建议：显式 kind；删除原 Scroll=17 —— 滚动是容器的 overflow）。容器可含子节点。",
    "container": {
      "layout": { "type": "enum", "values": ["flow", "grid", "absolute"], "default": "flow" },
      "overflow": { "type": "enum", "values": ["scroll", "clip"], "default": "scroll" },
      "padding": { "type": "number", "min": 0, "default": 0 },
      "spacing": { "type": "number", "min": 0, "default": 2, "doc": "默认 2（今天写死在 ModuleElementPanel 的 DefaultSpacing，按 Q2 移进 schema）" },
      "columns": { "type": "array", "items": "tracks", "default": [] },
      "rows": { "type": "array", "items": "tracks", "default": [] },
      "columnSpacing": { "type": "number", "min": 0, "default": 0 },
      "rowSpacing": { "type": "number", "min": 0, "default": 0 },
      "children": { "type": "array", "required": true }
    },
    "group": {
      "title": { "type": "string", "default": "" },
      "padding": { "type": "number", "min": 0, "default": 0 },
      "spacing": { "type": "number", "min": 0, "default": 2 },
      "children": { "type": "array", "required": true }
    },
    "tabs": {
      "title": { "type": "string", "default": "" },
      "stateKey": { "type": "string", "default": null, "doc": "模块靠它回读当前选中页" },
      "children": { "type": "array", "required": true, "doc": "每个子容器一个页签，页签名取子容器的 title" }
    },
    "collapsible": {
      "title": { "type": "string", "default": "" },
      "expanded": { "type": "bool", "default": true },
      "stateKey": { "type": "string", "default": null },
      "children": { "type": "array", "required": true }
    }
  },
  "atoms": {
    "doc": "15 种原子控件（不可含子节点）。roleKeys = 该控件允许的绑定键角色，只能出现一个，写错键 = 硬伤（C-10）。rendered=false 的 kind **允许声明、不拒绝加载**，读取时按警告报出来（C-2 用户裁决 m04188：现在禁了、后面实现时又要改回去）。",
    "numeric": {
      "rendered": true, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true, "doc": "数值数据源名" },
        "unit": { "type": "string", "default": "" }
      }
    },
    "statusLight": {
      "rendered": false, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true },
        "states": { "type": "array", "default": null, "doc": "未渲染：专有键待实现时定" }
      }
    },
    "curve": {
      "rendered": true, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true },
        "capacity": { "type": "integer", "min": 1, "default": 256, "doc": "C-5 建议：做成声明键" }
      }
    },
    "table": {
      "rendered": false, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true },
        "columns": { "type": "array", "default": null, "doc": "未渲染：专有键待实现时定" }
      }
    },
    "textLog": {
      "rendered": true, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true },
        "capacity": { "type": "integer", "min": 1, "default": 20000, "doc": "C-5 建议：做成声明键；超出丢最旧" },
        "wrap": { "type": "bool", "default": true },
        "showNewlineMark": { "type": "bool", "default": true, "doc": "是否画 ↵ 空行标记" }
      }
    },
    "hexView": {
      "rendered": false, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true },
        "bytesPerRow": { "type": "integer", "default": null, "doc": "未渲染：专有键待实现时定" }
      }
    },
    "gauge": {
      "rendered": false, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true },
        "min": { "type": "number", "default": 0 },
        "max": { "type": "number", "default": 100 },
        "unit": { "type": "string", "default": "" }
      }
    },
    "image": {
      "rendered": false, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true },
        "stretch": { "type": "enum", "values": ["none", "uniform", "fill"], "default": null, "doc": "未渲染：专有键待实现时定" }
      }
    },
    "configurationEditor": {
      "rendered": true, "roleKeys": ["data"],
      "properties": {
        "data": { "type": "string", "required": true, "doc": "配置对象数据源名；字段仍由 [ConfigurationField] 推出（今日无使用实例）" }
      }
    },
    "commandButton": {
      "rendered": true, "roleKeys": ["command"],
      "properties": {
        "command": { "type": "string", "required": true, "doc": "命令名（模块在声明里登记处理器）" },
        "title": { "type": "string", "default": "命令名", "doc": "按钮文案；C-9：命令即入口，不再另设 commands 表" },
        "icon": { "type": "string", "default": null }
      }
    },
    "toggleSlider": {
      "rendered": true, "roleKeys": ["input"],
      "properties": { "input": { "type": "string", "required": true } }
    },
    "enumSelector": {
      "rendered": false, "roleKeys": ["input"],
      "properties": {
        "input": { "type": "string", "required": true },
        "options": { "type": "array", "default": null, "doc": "未渲染：专有键待实现时定" }
      }
    },
    "textInput": {
      "rendered": true, "roleKeys": ["input"],
      "properties": {
        "input": { "type": "string", "required": true },
        "multiline": { "type": "bool", "default": false },
        "inputKind": { "type": "enum", "values": ["text", "number", "hex"], "default": "text", "doc": "框架只按此过滤按键；范围与合法性校验归模块" },
        "textAlign": { "type": "enum", "values": ["default", "left", "center", "right"], "default": "default", "doc": "文本对齐；C-13 建议由 alignment 改名而来（与 grid 格子的 align 区分）。单行文本框的默认高为 0（按内容），多行按 defaultGeometry 填满" }
      }
    },
    "fileSelector": {
      "rendered": true, "roleKeys": ["input"],
      "properties": {
        "input": { "type": "string", "required": true },
        "fileMode": { "type": "enum", "values": ["open", "save", "folder"], "default": "open" },
        "filter": { "type": "string", "default": null, "doc": "形如 '文本文件 (*.txt)|*.txt'" },
        "suggestedFileName": { "type": "string", "default": null }
      }
    },
    "toggleSwitch": {
      "rendered": true, "roleKeys": ["input"],
      "properties": { "input": { "type": "string", "required": true } }
    }
  },
  "document": {
    "doc": "声明文件的顶层形状（`view.json`）。按用户裁决（m04188）分**两段**：`frame` = 框架级个性化声明（极少量、非解释型：模块窗口尺寸与约束、网络标签默认位置），`sources` + `views` = 控件级声明（大量、解释型完备：控件树 + 语义键 + 几何）。仍是**一个文件**——拆成两个文件会造出两个事实源、两条加载路径、两条错误通道，而框架级那几行不值得。外观类不进这里（Q3）。",
    "version": { "type": "integer", "const": 1, "required": true },
    "frame": {
      "doc": "框架级段：框架与模块共有、但模块有个性化需求的那几行。",
      "window": { "$ref": "window" },
      "ports": {
        "type": "array", "required": false, "default": [],
        "doc": "网络标签（端口）的**默认位置**；正式名 = 网络标签。不声明 = 用框架惯例（模块窗口：接收顶 / 发送底；主壳：发送右 / 接收左）。用户拖动覆盖仍优先于它。标记几何（宽 20 / 长 150 / 固定件 49 …）、可拖动性、吸附阈值都不在这里（框架固定项）。",
        "item": {
          "name": { "type": "string", "required": true, "doc": "与数据面注册的口名一致" },
          "edge": { "type": "enum", "values": ["auto", "left", "right", "top", "bottom"], "default": "auto", "doc": "默认在哪条边；auto = 走框架惯例" },
          "offset": { "type": "number", "min": 0, "max": 1, "default": 0.5, "doc": "边上的默认位置，0..1" }
        }
      },
      "theme": {
        "type": "object", "default": null, "reserved": true,
        "doc": "**预留、本轮不实现、默认不出现**：Q3 规定颜色/字体只由全局主题决定，任何按模块的外观覆盖都与「整体观感一致性」冲突（那 238 处字面量要归零也是同一个理由）。将来若真需要一个例外，必须在这里显式登记，并同时登记进护栏例外清单。"
      }
    },
    "sources": {
      "type": "array", "required": true,
      "item": {
        "name": { "type": "string", "required": true },
        "kind": { "type": "enum", "values": ["Text", "Value", "Sequence", "RowSet", "ByteBlock", "Frame"], "default": "Text" },
        "valueType": { "type": "enum", "values": ["Bool", "I32", "U32", "U64", "F64", "Text", "Bytes"], "default": null },
        "unit": { "type": "string", "default": null }
      }
    },
    "views": {
      "type": "array", "required": true,
      "item": { "title": { "type": "string", "default": "" }, "root": { "type": "node", "required": true } },
      "doc": "框架当前只渲染第 0 个视图（与今日一致）；其余条目按警告忽略"
    }
  },
  "validation": {
    "hard": [
      "version 缺失或 ≠ 1",
      "未知键 / 未知 kind / 未知枚举字面量",
      "frame.ports[] 的口名缺失或重名；edge 不认识；offset 不在 0..1",
      "类型不符；数值小于 min 或大于 max；同轴 min > max",
      "某个轴给了多个策略 / 未知策略；absolute 容器里的元素缺任一个轴，或该轴不是 pixels",
      "容器没有 children 或 children 为空",
      "grid 里既没给 column+row、也没写 auto:true；或两者同时写；或同一容器混用两种写法",
      "column/row 越界（含 span 越界）；columnSpan / rowSpan < 1",
      "引用不存在的 sources 名字；同一角色键写错（如 data 写在 commandButton 上）",
      "sources 里 name 缺失或重名"
    ],
    "warning": [
      "非 grid 容器声明了 columns / rows / column/row / span / auto（该条忽略）",
      "grid 容器里元素声明了 x / y（该条忽略）",
      "省略了某个轴（按 defaultGeometry 的 kind 默认口径填；不报也算合法 —— C-14 建议 B）",
      "负的 padding / spacing / columnSpacing / rowSpacing（按 0 处理）",
      "window.max 小于有效下限（该条忽略）",
      "声明了 rendered:false 的 kind（已登记、框架尚未渲染 ⇒ 界面会缺这一块，但不拒绝加载）",
      "frame.ports[] 里的口名在数据面不存在（声明了却接不上，须宿主加载时对账）",
      "sources 里未被任何元素引用的条目（声明了却接不上）",
      "views[] 里第 0 个以外的条目（今日只渲染第 0 个）",
      "showInlineResult:false 但整份声明没有任何 feedbackSource（反馈无处显示）"
    ]
  }
}
