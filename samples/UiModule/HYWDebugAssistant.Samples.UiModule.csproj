<Project Sdk="Microsoft.NET.Sdk">

  <!--
    带界面样例：只引用作者包（Sdk / Sdk.Ui / Module.Build），不引用仓库内任何工程。
    演示：视图工厂 + ModuleView + 模块自己的文本表；打包与其它样例同一套规则。
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <!-- 固定输出平台名：机器上被别的软件设置的 Platform 环境变量不应把产物目录带歪。 -->
    <PlatformName>AnyCPU</PlatformName>
    <AssemblyName>HYWDebugAssistant.Samples.UiModule</AssemblyName>
    <RootNamespace>HYWDebugAssistant.Samples.UiModule</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HYWDebugAssistant.Sdk" Version="$(Version)" />
    <PackageReference Include="HYWDebugAssistant.Sdk.Ui" Version="$(Version)" />
    <PackageReference Include="HYWDebugAssistant.Module.Build" Version="$(Version)" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- 文本表随构建输出：预览器与行为测试都按“程序集旁”的 resources 读取。 -->
    <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
