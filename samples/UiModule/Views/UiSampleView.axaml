<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:HYWDebugAssistant.Samples.UiModule"
               x:Class="HYWDebugAssistant.Samples.UiModule.Views.UiSampleView"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               d:DesignWidth="340" d:DesignHeight="168">

  <!--
    带界面的最小视图：标题 / 计数 / 状态 / 一个命令按钮。
    根是 `ModuleView`：它把控件库主题与设计时 token 带进 XAML 预览器（运行时不会重复挂）。
    控件全部来自 Sdk.Ui；文案只写键，表在本模块的 resources/i18n 下。
  -->
  <Grid RowDefinitions="Auto,*,Auto" Margin="12">

    <ui:ModuleLabel Grid.Row="0" Classes="caption" Text="{loc:Tr view.title}" />

    <Grid Grid.Row="1" Margin="0,10,0,0" ColumnDefinitions="Auto,Auto,*"
          RowDefinitions="Auto,Auto" VerticalAlignment="Top">

      <ui:ModuleLabel Grid.Row="0" Grid.Column="0" Classes="caption"
                      Text="{loc:Tr view.count}" VerticalAlignment="Center" />

      <ui:ModuleNumeric Grid.Row="0" Grid.Column="1" Margin="10,0,0,0"
                        Source="{x:Static local:UiSampleModule.CountSource}"
                        VerticalAlignment="Center" />

      <ui:ModuleStatusLight Grid.Row="0" Grid.Column="2"
                            Source="{x:Static local:UiSampleModule.StateSource}"
                            HorizontalAlignment="Right" VerticalAlignment="Center" />

      <ui:ModuleLabel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,8,0,0" Classes="hint"
                      Source="{x:Static local:UiSampleModule.StateSource}" />
    </Grid>

    <ui:ModuleButton Grid.Row="2" Width="88" Height="27" HorizontalAlignment="Left"
                     CommandName="{x:Static local:UiSampleModule.ResetCommand}"
                     Content="{loc:Tr view.reset}" />
  </Grid>
</ui:ModuleView>
