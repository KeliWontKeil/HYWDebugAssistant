<Project Sdk="Microsoft.NET.Sdk">

  <!--
    **截图工具（不是判据）**：在**真实渲染栈（Skia）**下把窗口渲染成 PNG，交给人眼验收。
    · 三个生成入口：叠加层 / 调色板 / 八个模块视图；输出 `artifacts\snapshots\`，**没有断言**。
    · 不进任何自动化门禁：`dev.ps1 -Mode Snapshots` 按需运行（或 -IncludeSnapshots 临时进门禁）。
    · 载体仍是 xUnit（`dotnet test` 跑 `[Fact]`），但它的成功只表示“画出来了”，不表示“画得对”。
    · **为什么必须单独一个项目**：`AvaloniaHeadlessPlatform` 的配置是**进程级**的
      （`UseHeadlessDrawing` 一旦初始化就不能换）。主测试项目用的是"空绘制"无头会话，
      若在同一进程里再开"真实渲染"会话，会把主项目的无头会话一起弄坏。进程隔离是最省心的边界。
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <NoWarn>$(NoWarn);CA1707;CA1859;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Avalonia.Headless" />
    <!--
      真实渲染栈：`RenderTargetBitmap` 需要 Skia（无头默认是"空绘制"，出不了像素）。
      **刻意不引用 App 项目**：引用它就会在构建时重新拷贝 `src/App/bin` 的输出 ⇒ 应用一开着（文件被锁）快照工具就不可用，
      而调 UI 恰恰发生在应用开着的时候。资源装载由本项目的 `SnapshotApp` 复刻（见其注释）。
    -->
    <PackageReference Include="Avalonia.Skia" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ui\HYWDebugAssistant.Ui.csproj" />
    <ProjectReference Include="..\..\src\FrameworkUi\HYWDebugAssistant.FrameworkUi.csproj" />
    <ProjectReference Include="..\..\src\Sdk\HYWDebugAssistant.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Sdk.Testing\HYWDebugAssistant.Sdk.Testing.csproj" />
    <ProjectReference Include="..\..\src\Hosting\HYWDebugAssistant.Hosting.csproj" />
    <ProjectReference Include="..\..\src\DataPlane\HYWDebugAssistant.DataPlane.csproj" />
    <ProjectReference Include="..\..\src\Core\HYWDebugAssistant.Core.csproj" />
    <ProjectReference Include="..\..\src\Core.Api\HYWDebugAssistant.Core.Api.csproj" />
    <!-- 外部接入参数类型（四个外部模块的视图契约逐字段对账/设计数据注册）。 -->
    <ProjectReference Include="..\..\src\Access\HYWDebugAssistant.Access.csproj" />
    <!-- 八个业务模块的视图契约：真造 XAML 控件，再按控件上的键对代码声明。 -->
    <ProjectReference Include="..\..\src\Modules\Business\Serial\HYWDebugAssistant.Modules.Serial.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\TcpClient\HYWDebugAssistant.Modules.TcpClient.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\TcpServer\HYWDebugAssistant.Modules.TcpServer.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\Udp\HYWDebugAssistant.Modules.Udp.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\TextSender\HYWDebugAssistant.Modules.TextSender.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\HexSender\HYWDebugAssistant.Modules.HexSender.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\DataMonitor\HYWDebugAssistant.Modules.DataMonitor.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\HexStringConverter\HYWDebugAssistant.Modules.HexStringConverter.csproj" />
  </ItemGroup>

</Project>
