<Project Sdk="Microsoft.NET.Sdk">

  <!--
    T1 判据测试（AC-1~6）：**四个基础模块**（判据载体，2026-09 起）+ 框架 —— 口径见 dev/workflow.md
    测试项目可跨层引用（AR 规则只约束 src/ 下的产品程序集）
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- 测试专用豁免（须注明原因）：xUnit 测试方法名用中文场景描述 -->
    <NoWarn>$(NoWarn);CA1707;CA1859;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="NSubstitute" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Sdk\HYWDebugAssistant.Sdk.csproj" />
    <!-- T6 契约测试套件：在真实模块的声明面上做自检（与模块作者用法一致） -->
    <ProjectReference Include="..\..\src\Sdk.Testing\HYWDebugAssistant.Sdk.Testing.csproj" />
    <ProjectReference Include="..\..\src\Infrastructure\HYWDebugAssistant.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\Hosting\HYWDebugAssistant.Hosting.csproj" />
    <ProjectReference Include="..\..\src\DataPlane\HYWDebugAssistant.DataPlane.csproj" />
    <ProjectReference Include="..\..\src\Core\HYWDebugAssistant.Core.csproj" />
    <ProjectReference Include="..\..\src\Core.Api\HYWDebugAssistant.Core.Api.csproj" />
    <!--
      【2026-09 用户裁定"完全删除旧的模块和数据结构，新测试全部转入新的四个模块"】
      判据载体 = **四个正式模块**（文本发送器 / HEX 发送器 / 数据显示器 / 转换器）+ **本项目内的测试桩**
      （`Stubs/`：多源融合 / 定值数据源 / 判据接收）——参考模块独有的能力（仲裁 / 阈值断言 / 记录统计 /
      定时出数）由桩承载，**框架能力与接口一个都不删**。
    -->
    <ProjectReference Include="..\..\src\Modules\Business\TextSender\HYWDebugAssistant.Modules.TextSender.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\HexSender\HYWDebugAssistant.Modules.HexSender.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\DataMonitor\HYWDebugAssistant.Modules.DataMonitor.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\HexStringConverter\HYWDebugAssistant.Modules.HexStringConverter.csproj" />
  </ItemGroup>

</Project>
