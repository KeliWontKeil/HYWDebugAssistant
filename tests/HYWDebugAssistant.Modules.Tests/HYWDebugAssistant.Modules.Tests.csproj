<Project Sdk="Microsoft.NET.Sdk">

  <!--
    业务模块测试（**集中一个项目**）—— B/C3 裁定（2026-09 · 用户裁决"②"）：
      · 模块的 T6 契约自检 + 模块级测试都放这里，**不再每个模块起一个测试项目**（项目数可控）；
      · 参考模块的判据测试仍在 Tests.Reference（那是"判据载体"项目，与本项目分工不同）；
      · 模块间测试隔离由本项目的用例组织自行守（按模块分文件 / 分 Collection）。
    规范见 docs/implementation/06-module-standard-and-development-process.md §C.4。
  -->
  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- 测试专用豁免（须注明原因）：xUnit 测试方法名用中文场景描述 -->
    <NoWarn>$(NoWarn);CA1707;CA1859;CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
    <PackageReference Include="coverlet.collector" />
  </ItemGroup>

  <ItemGroup>
    <!-- T6 契约自检套件（模块作者视角：只引 Sdk + Sdk.Testing） -->
    <ProjectReference Include="..\..\src\Sdk\HYWDebugAssistant.Sdk.csproj" />
    <ProjectReference Include="..\..\src\Sdk.Testing\HYWDebugAssistant.Sdk.Testing.csproj" />
    <ProjectReference Include="..\..\src\Sdk.AccessKit\HYWDebugAssistant.Sdk.AccessKit.csproj" />
    <!-- 框架侧外部接入（适配器 + 参数类型）：适配件逻辑用例直接驱动它们（模块本身不再引用）。 -->
    <ProjectReference Include="..\..\src\Access\HYWDebugAssistant.Access.csproj" />
    <!-- 业务模块：随第一个模块落地时在此逐个加入（模块只引 Sdk；测试项目可跨层引用） -->
    <ProjectReference Include="..\..\src\Modules\Business\TextSender\HYWDebugAssistant.Modules.TextSender.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\CommandSender\HYWDebugAssistant.Modules.CommandSender.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\HexSender\HYWDebugAssistant.Modules.HexSender.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\DataMonitor\HYWDebugAssistant.Modules.DataMonitor.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\HexStringConverter\HYWDebugAssistant.Modules.HexStringConverter.csproj" />
    <!-- 第二批（外部接入）：串口 / TCP 客户端 / TCP 服务端 / UDP —— 与四个基础模块同型，契约自检同口径 -->
    <ProjectReference Include="..\..\src\Modules\Business\Serial\HYWDebugAssistant.Modules.Serial.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\TcpClient\HYWDebugAssistant.Modules.TcpClient.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\TcpServer\HYWDebugAssistant.Modules.TcpServer.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\Udp\HYWDebugAssistant.Modules.Udp.csproj" />
    <!-- 第三批（波形）：显示器/发生器；两者以 WaveformFrame 约定互连。 -->
    <ProjectReference Include="..\..\src\Modules\Business\WaveformDisplay\HYWDebugAssistant.Modules.WaveformDisplay.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\WaveformGenerator\HYWDebugAssistant.Modules.WaveformGenerator.csproj" />
    <!-- 第四批（波形桥）：原始 ↔ 波形 双向转换；与显示器/监视器同契约。 -->
    <ProjectReference Include="..\..\src\Modules\Business\RawToWaveform\HYWDebugAssistant.Modules.RawToWaveform.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\WaveformToRaw\HYWDebugAssistant.Modules.WaveformToRaw.csproj" />
    <!-- 第五批（终端显示）：四个 WaveformFrame 消费方共用同一套帧路由与目标值解析。 -->
    <ProjectReference Include="..\..\src\Modules\Business\GaugeDisplay\HYWDebugAssistant.Modules.GaugeDisplay.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\ScaleBarHorizontal\HYWDebugAssistant.Modules.ScaleBarHorizontal.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\ScaleBarVertical\HYWDebugAssistant.Modules.ScaleBarVertical.csproj" />
    <ProjectReference Include="..\..\src\Modules\Business\AttitudeDisplay\HYWDebugAssistant.Modules.AttitudeDisplay.csproj" />
    <!-- 样板模块（开发样板 · 声明面演示箱）：与四个正式模块同型，契约自检同口径 -->
  </ItemGroup>

</Project>
