<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <!--
      测试代码豁免（ADR-0025 §8 例外机制，原因注明）：
      · CA1707：xUnit 测试方法采用“规则编号_场景_期望”命名，可读性优先
      · CA1859 / CS1591：性能与注释非测试关注点
    -->
    <NoWarn>$(NoWarn);CA1707;CA1859;CS1591</NoWarn>
  </PropertyGroup>

  <!--
    架构约束测试：**AR-1 ~ AR-16**（唯一来源 docs/architecture/06 §6.3；ADR-0032）
    · 依赖类（AR-1~AR-12）：读取已编译程序集的 AssemblyRef 表（覆盖间接依赖）
    · 源码类（AR-13~AR-16）：源码扫描
    · **目标程序集缺失即失败**（禁止"无对象则跳过"）
    本测试**不引用任何产品项目**（以"被分析对象"身份读取其程序集与源码，避免影响依赖图）。
  -->
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Shouldly" />
  </ItemGroup>

</Project>
