<Project>

  <!-- 中央包管理（CPM）：所有包版本在此统一锁定；ADR-0024 要求锁定版本 -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="UI（Avalonia）">
    <!-- 版本需保持同步（Avalonia 各包同版本） -->
    <PackageVersion Include="Avalonia" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Controls.DataGrid" Version="12.1.2" />
    <!-- 调色板窗口【ADR-0054】：Avalonia 官方 ColorView（MIT，与 Avalonia 同版本同源） -->
    <PackageVersion Include="Avalonia.Controls.ColorPicker" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Headless" Version="12.1.2" />
    <PackageVersion Include="Avalonia.Skia" Version="12.1.2" />
    <!--
      注：**不引 Avalonia.Headless.XUnit**——它在 12.1.2 依赖 xunit **v3**，与本工程 xunit v2 冲突
      （CS0433：FactAttribute 同时存在于 xunit.core 与 xunit.v3.core）。
      改用 `Avalonia.Headless.HeadlessUnitTestSession`（自带独立调度线程，不绑定测试框架）。
    -->
    <!--
      注：Avalonia.Fonts.Inter 已移除——视觉基线采用**系统字体**（docs/architecture/09 §3，V4 裁决），
      无需内置字体包；数据区等宽字体使用系统自带 Cascadia Mono / Consolas。
    -->
  </ItemGroup>

  <ItemGroup Label="MVVM">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
  </ItemGroup>

  <ItemGroup Label="组合根（仅 App 使用；ADR-0024 选型清单内）">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup Label="外部接入（模块侧）">
    <!-- 串口访问：MIT（.NET 平台扩展）；版本与运行时大版本一致 -->
    <PackageVersion Include="System.IO.Ports" Version="10.0.2" />
  </ItemGroup>

  <ItemGroup Label="测试">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
  </ItemGroup>

  <ItemGroup Label="基准测试">
    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>

  <!-- 明确排除（ADR-0024）：MediatR / AutoMapper / FluentAssertions / Moq / Qt / 商业控件 / 无许可声明包 -->

</Project>
