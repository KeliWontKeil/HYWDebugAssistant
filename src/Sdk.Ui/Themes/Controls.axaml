<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls">
  <!--
    控件库的**默认观感**（只这一处）。

    颜色全部走主题 token（宿主提供：`TextPrimary` / `TextMuted` / `Semantic*` …），
    于是换深浅主题、用户改配色时这里一个像素都不用动。
    字号与间距也在这里 —— 控件代码里不写字面量。

    **视觉结构也在这一份 XAML 里**：每个控件一个 ControlTheme，用命名部件（PART_*）
    把内部结构画出来；C# 控件只取部件、管行为，不再 `new Grid/TextBlock`。
  -->
  <Styles.Resources>

    <ControlTheme x:Key="{x:Type ui:ModuleStatusLight}" TargetType="ui:ModuleStatusLight">
      <Setter Property="Template">
        <ControlTemplate>
          <Ellipse Name="PART_Dot" Classes="module-status-light" />
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!--
      图标：画面由 `Viewbox` 按 SVG 的 `viewBox` 等比缩放（留白一起保留），显示尺寸取 `Glyph.icon` 的声明；
      填充色跟随控件前景 ⇒ 按钮的 `:pointerover` / `:pressed` 换前景时图标自动跟着走。
      缺键/缺表时显示**键名**（界面字体）——宁可露出缺的是哪个键，也不要一块看不见的空白。
    -->
    <ControlTheme x:Key="{x:Type ui:Icon}" TargetType="ui:Icon">
      <Setter Property="Width" Value="16" />
      <Setter Property="Height" Value="16" />
      <Setter Property="Template">
        <ControlTemplate>
          <Panel>
            <Viewbox Name="PART_Svg" Stretch="Uniform" IsVisible="False">
              <Canvas Name="PART_Canvas" Width="20" Height="20">
                <Path Name="PART_Path" Fill="{TemplateBinding Foreground}"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1"
                      IsHitTestVisible="False" />
                <!-- 线条图标：只描边、不填充；线宽由控件统一，不读 SVG 的 stroke-width。 -->
                <Path Name="PART_StrokePath" Fill="{x:Null}"
                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.8"
                      StrokeLineCap="Round" StrokeJoin="Round"
                      IsVisible="False" IsHitTestVisible="False" />
              </Canvas>
            </Viewbox>
            <TextBlock Name="PART_Fallback"
                       IsVisible="False"
                       FontSize="10"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{TemplateBinding Foreground}" />
          </Panel>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:ModuleTextSurface}" TargetType="ui:ModuleTextSurface">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid>
            <Border Name="PART_Frame" Classes="module-text-frame"
                    BorderThickness="1" CornerRadius="2"
                    Background="{DynamicResource SurfaceControlBrush}">
              <Grid>
                <TextBox Name="PART_Input" Classes="module-text-editor chrome-bare"
                         BorderThickness="0" Background="Transparent"
                         HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                         IsVisible="False" />
                <ScrollViewer Name="PART_ReadScroll"
                              HorizontalScrollBarVisibility="Disabled"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalContentAlignment="Stretch"
                              IsVisible="False">
                  <ui:IncrementalTextView Name="PART_ReadText" Classes="module-text-read"
                                          HorizontalAlignment="Stretch" />
                </ScrollViewer>
              </Grid>
            </Border>
            <Border Name="PART_FocusRing" BorderThickness="2" CornerRadius="2"
                    BorderBrush="{DynamicResource AccentPrimary}"
                    IsVisible="False" IsHitTestVisible="False" />
            <ui:NewlineMarkOverlay Name="PART_Marks" IsHitTestVisible="False" />
            <Border Name="PART_ErrorRing" BorderThickness="2" CornerRadius="2"
                    BorderBrush="{DynamicResource SemanticError}"
                    IsVisible="False" IsHitTestVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:ModuleToggle}" TargetType="ui:ModuleToggle">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- 开关只有轨道与圆钮：文字是旁边的独立 ModuleLabel，不再长在控件里。 -->
          <Grid VerticalAlignment="Center" HorizontalAlignment="Left">
            <Border Name="PART_Track" Width="36" Height="18" CornerRadius="9"
                    Background="{DynamicResource SurfaceToggleTrackOffBrush}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Border Name="PART_Knob" Width="14" Height="14" CornerRadius="7"
                      Background="{DynamicResource SurfaceToggleKnobBrush}"
                      BorderBrush="{DynamicResource SurfaceToggleKnobEdgeBrush}" BorderThickness="1"
                      HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,2,0" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:ModuleCheckBox}" TargetType="ui:ModuleCheckBox">
      <Setter Property="Template">
        <ControlTemplate>
          <!-- 方框 + 勾形 + 右侧文字：勾选态由控件的 :checked 伪类驱动。 -->
          <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            <Border Name="PART_Box" Width="14" Height="14" CornerRadius="2"
                    Background="{DynamicResource SurfaceControlBrush}"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                    VerticalAlignment="Center">
              <Path Name="PART_Check"
                    Data="M 2,6 L 5,9 L 10,3"
                    Stroke="{DynamicResource TextOnAccent}"
                    StrokeThickness="1.6"
                    StrokeLineCap="Round"
                    StrokeJoin="Round"
                    IsVisible="False" />
            </Border>
            <ContentPresenter Grid.Column="1" Margin="2,0,0,0"
                              Content="{TemplateBinding Content}"
                              ContentTemplate="{TemplateBinding ContentTemplate}"
                              Foreground="{TemplateBinding Foreground}"
                              FontSize="{TemplateBinding FontSize}"
                              VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>



    <ControlTheme x:Key="{x:Type ui:ModuleSegmentedControl}" TargetType="ui:ModuleSegmentedControl">
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="2"
                  Padding="1">
            <ScrollViewer HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Left">
              <StackPanel Name="PART_Items" Orientation="Horizontal" Spacing="1" />
            </ScrollViewer>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <ControlTheme x:Key="{x:Type ui:ModuleConfigField}" TargetType="ui:ModuleConfigField">
      <Setter Property="Template">
        <ControlTemplate>
          <Grid RowDefinitions="*,Auto">
            <Grid Grid.Row="0">
              <ContentControl Name="PART_EditorHost" />
              <Border Name="PART_ErrorRing" BorderThickness="2" CornerRadius="2"
                      IsVisible="False" IsHitTestVisible="False" />
            </Grid>
            <TextBlock Name="PART_Notice" Grid.Row="1" Classes="module-notice"
                       TextWrapping="Wrap" IsVisible="False" />
          </Grid>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!--
      页签本体：选中态 = 淡主题色圆角底 + 主题色下沿（下沿厚度由声明给出），未选中透明 + 次文字。
      这组属性必须住在 ControlTheme 里：Fluent 的 TabItem 主题会盖掉外部
      `TabItem` 样式；`TabControl.ItemContainerTheme` 才是容器主题的入口。
    -->
    <ControlTheme x:Key="ModuleTabItemTheme" TargetType="TabItem">
      <Setter Property="MinWidth" Value="0" />
      <Setter Property="MinHeight" Value="20" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="Margin" Value="0,0,2,0" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="Template">
        <ControlTemplate>
          <!--
            下沿必须在**Padding 之外**、铺满页签本体：放在带 Padding 的内层 Grid 里时，
            它只会横过文字的宽度，看起来像一个小点。
          -->
          <Grid>
            <Border Name="PART_Root"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="0"
                    Padding="{TemplateBinding Padding}">
              <TextBlock Text="{TemplateBinding Header}"
                         Foreground="{TemplateBinding Foreground}"
                         FontSize="{TemplateBinding FontSize}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <Border Name="PART_Underline" Height="2"
                    VerticalAlignment="Bottom"
                    HorizontalAlignment="Stretch"
                    Background="Transparent" />
          </Grid>
        </ControlTemplate>
      </Setter>

      <Style Selector="^:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceTabHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
      </Style>

      <Style Selector="^:selected">
        <Setter Property="Background" Value="{DynamicResource SurfaceTabSelectedBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
      </Style>

      <Style Selector="^:selected:pointerover">
        <Setter Property="Background" Value="{DynamicResource SurfaceTabSelectedHoverBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
      </Style>

      <Style Selector="^:selected /template/ Border#PART_Underline">
        <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
      </Style>
    </ControlTheme>
  </Styles.Resources>

  <Style Selector="ScrollViewer">
    <Setter Property="ui:WheelScroll.HorizontalFallback" Value="True" />
  </Style>

  <Style Selector="ui|ModuleStatusLight">
    <Setter Property="Theme" Value="{DynamicResource {x:Type ui:ModuleStatusLight}}" />
  </Style>

  <Style Selector="ui|ModuleTextSurface">
    <Setter Property="Theme" Value="{DynamicResource {x:Type ui:ModuleTextSurface}}" />
  </Style>

  <Style Selector="ui|ModuleToggle">
    <Setter Property="Theme" Value="{DynamicResource {x:Type ui:ModuleToggle}}" />
  </Style>

  <Style Selector="ui|ModuleCheckBox">
    <Setter Property="Theme" Value="{DynamicResource {x:Type ui:ModuleCheckBox}}" />
  </Style>



  <Style Selector="ui|ModuleSegmentedControl">
    <Setter Property="Theme" Value="{DynamicResource {x:Type ui:ModuleSegmentedControl}}" />
    <Setter Property="Height" Value="24" />
    <Setter Property="Background" Value="{DynamicResource SurfaceControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="Button.module-segment">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="6,1" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="Button.module-segment:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="Button.module-segment.selected">
    <Setter Property="Background" Value="{DynamicResource SurfaceTabSelectedBackgroundBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="Button.module-segment.selected:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceTabSelectedHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="Button.module-segment:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>

  <Style Selector="Button.module-color-swatch">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="Button.module-row-action">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="Button.module-row-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!-- 行内切换按钮：同一个控件既是按钮又显示选中态（隐藏曲线、适应 Y 等）。 -->
  <Style Selector="ToggleButton.module-row-action">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource SurfaceControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="ToggleButton.module-row-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceTabHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ToggleButton.module-row-action:checked">
    <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="Button.module-color-swatch.selected">
    <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <Style Selector="ui|ModuleConfigField">
    <Setter Property="Theme" Value="{DynamicResource {x:Type ui:ModuleConfigField}}" />
  </Style>

  <!--
    **标签只有一套排印**：字号/墨色/省略号都在这里；视图用类选档位，不自己写字号。
    默认档 = 事实/状态（正文墨）；`caption` = 标题类（次级墨）；`hint` = 说明（更小、更弱）；
    `micro` = 更紧凑的辅助读数；`right` = 在自己的矩形里右对齐；`wrap` = 显式换行（默认单行省略）。
  -->
  <Style Selector="ui|ModuleLabel">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="ui|ModuleLabel.caption">
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector="ui|ModuleLabel.hint">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <Style Selector="ui|ModuleLabel.micro">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
  </Style>

  <!-- 读数标签在组内贴住值：在自己的矩形里右对齐，右缘不动。 -->
  <Style Selector="ui|ModuleLabel.right">
    <Setter Property="TextAlignment" Value="Right" />
  </Style>

  <Style Selector="ui|ModuleLabel.wrap">
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="TextTrimming" Value="None" />
  </Style>

  <Style Selector="ui|ModuleNumeric">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontFamily" Value="{DynamicResource FontData}" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style Selector="TextBlock.module-notice">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource SemanticError}" />
  </Style>

  <Style Selector="Ellipse.module-status-light">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>

  <!--
    模块控件库的**尺寸**也在这里：视图只摆结构，不逐格写高度/字号。
    数值与全局控件高对齐（同一档 token），避免"同一种控件在不同模块里高矮不一"。
  -->
  <Style Selector="ui|ModuleButton">
    <Setter Property="MinHeight" Value="26" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="FontSize" Value="11" />
  </Style>

  <!--
    图标按钮：一格小方框里放**一个图标**（显式 SVG，见 `IconCatalog`）。
    必须把上面那条的最小尺寸与内边距放开，否则尺寸下限会把方框撑大、内边距会把图标挤偏；
    图标在框里居中，不参与文本基线对齐。
    **面 / 边 / 指针态不在这里**：宿主 App 的 `ButtonChrome.axaml` 对 `:is(Button)` 统一给
    （图标按钮不再排除），这里只收窄尺寸与图标颜色——否则模块视图里的清空按钮会"没有面"。
  -->
  <Style Selector="ui|ModuleButton.icon">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="CornerRadius" Value="4" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
  </Style>

  <!-- 按钮里那枚图标的尺寸（清空按钮比普通按钮更小，图标相应收窄才不挤） -->
  <Style Selector="ui|ModuleButton.icon ui|Icon">
    <Setter Property="Width" Value="14" />
    <Setter Property="Height" Value="14" />
  </Style>

  <Style Selector="ui|ModuleButton.icon:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ui|ModuleButton.icon:pressed">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ui|ModuleToggle">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ui|ModuleCheckBox">
    <Setter Property="MinHeight" Value="24" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ui|ModuleCheckBox:pointerover /template/ Border#PART_Box">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleCheckBox:checked /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleCheckBox:checked /template/ Path#PART_Check">
    <Setter Property="IsVisible" Value="True" />
  </Style>

  <Style Selector="ui|ModuleCheckBox:checked:pointerover /template/ Border#PART_Box">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleCheckBox:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="ui|ModuleToggle:pointerover /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource SurfaceToggleTrackOffHoverBrush}" />
  </Style>

  <Style Selector="ui|ModuleToggle:checked /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleToggle:checked:pointerover /template/ Border#PART_Track">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleToggle /template/ Border#PART_Knob">
    <Setter Property="Transitions">
      <Transitions>
        <ThicknessTransition Property="Margin" Duration="0:0:0.16" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ui|ModuleToggle:checked /template/ Border#PART_Knob">
    <Setter Property="Margin" Value="18,0,2,0" />
  </Style>

  <Style Selector="ui|ModuleToggle:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="ui|ModuleTabs">
    <!-- 派生自 TabControl：类型选择器只匹配精确类型，必须显式把默认页签主题指回来。 -->
    <Setter Property="Theme" Value="{DynamicResource {x:Type TabControl}}" />
    <Setter Property="ItemContainerTheme" Value="{DynamicResource ModuleTabItemTheme}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Padding" Value="0" />
    <!-- 选中页的模块控件必须填满页签内容区：默认 ContentPresenter 的左上对齐会让文本框按内容宽收缩。 -->
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ui|ModuleTabs /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="VerticalAlignment" Value="Stretch" />
  </Style>

  <!-- 页签条：紧凑档；选中 = 淡主题色底 + 主题色下沿。 -->
  <Style Selector="ui|ModuleStatusLight">
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!--
    文本面只有一个边框来源：模板里的 PART_Frame。
    内层 TextBox 固定无边框，Fluent 的悬停/聚焦边框就不会再和 frame 打架。
  -->
  <Style Selector="Border.module-text-frame">
    <Setter Property="Background" Value="{DynamicResource SurfaceControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="2" />
  </Style>

  <Style Selector="TextBox.module-text-editor">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="SelectionBrush" Value="{DynamicResource OverlaySelection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="SelectableTextBlock.module-text-read">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="SelectionBrush" Value="{DynamicResource OverlaySelection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimary}" />
  </Style>

  <Style Selector="ui|IncrementalTextView.module-text-read">
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="4,2" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="SelectionBrush" Value="{DynamicResource OverlaySelection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource TextPrimary}" />
    <Setter Property="MarkerBrush" Value="{DynamicResource SemanticWarn}" />
    <Setter Property="NewlineMarkBrush" Value="{DynamicResource TextMuted}" />
  </Style>
  <!-- 字段编辑器：统一高度与字号，避免"一行高一行矮"（三档自然高本来各不相同）。 -->
  <!--
    配置格的内层编辑器**必须改掉全局 TextBox/ComboBox 的固定高**：
    模块内容区按紧凑行高排，沿用全局高度会让参数行比内容区还高（最后一格被裁）。
    高度只在这里给，视图不再逐格写。
  -->
  <Style Selector="ui|ModuleConfigField TextBox">
    <Setter Property="Height" Value="{Binding Height, RelativeSource={RelativeSource AncestorType=ui:ModuleConfigField}}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="4,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ui|ModuleConfigField ComboBox">
    <Setter Property="Height" Value="{Binding Height, RelativeSource={RelativeSource AncestorType=ui:ModuleConfigField}}" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <!-- 模块配置格通常只有一百来像素宽：箭头只占它真正需要的宽度，不能沿用全局箭头的宽松留白。 -->
  <Style Selector="ComboBox.compact /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <Style Selector="ui|ModuleConfigField ui|ModuleToggle">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Left" />
  </Style>

  <!-- 通用图表：只给默认观感；曲线色由调用方显式给出，缺省用主题强调色。 -->
  <Style Selector="ui|ChartSurface">
    <Setter Property="PlotBackground" Value="{DynamicResource SurfaceControlBrush}" />
    <Setter Property="AxisBrush" Value="{DynamicResource BorderStrong}" />
    <Setter Property="GridBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="TextBrush" Value="{DynamicResource TextSecondary}" />
    <Setter Property="CursorBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="CursorLabelBackground" Value="{DynamicResource BgModule}" />
    <Setter Property="CursorLabelBorder" Value="{DynamicResource BorderDefault}" />
    <Setter Property="CursorLabelText" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="10" />
  </Style>

  <!-- 通用线性范围选择：轨道 / 范围带 / 手柄各一支 token。 -->
  <Style Selector="ui|RangeSelector">
    <Setter Property="TrackBrush" Value="{DynamicResource SurfaceControlBrush}" />
    <Setter Property="RangeBrush" Value="{DynamicResource OverlaySelection}" />
    <Setter Property="HandleBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="FrameBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="TickBrush" Value="{DynamicResource TextPrimary}" />
    <Setter Property="TickLabelBrush" Value="{DynamicResource TextPrimary}" />
  </Style>

  <!--
    通用下拉：紧凑行高，与模块字段一致；不重造 ComboBox 模板。
    `ModuleSelect` 的 `StyleKey` 是 `ComboBox`，所以这里必须按 `ComboBox.module-select` 选；
    若写成 `ui|ModuleSelect`，选择器不会命中，全局 ComboBox 的 MinHeight 会悄悄变成高度下限。
  -->
  <Style Selector="ComboBox.module-select">
    <Setter Property="Height" Value="24" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="2,0" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="Background" Value="{DynamicResource SurfaceControlBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
  </Style>

  <Style Selector="ComboBox.module-select /template/ PathIcon#DropDownGlyph">
    <Setter Property="Width" Value="10" />
    <Setter Property="Height" Value="10" />
    <Setter Property="Margin" Value="0,0,6,0" />
  </Style>

  <!--
    **模块窗口外框**：运行时 `ModuleWindow`、IDE 预览外壳与快照共用这一处外观。
    只放外观（背景/描边/圆角）；内外预留带与内容尺寸仍由 `ModuleSurfaceMetrics` 决定。
  -->
  <Style Selector="Border.moduleFrame">
    <Setter Property="Background" Value="{DynamicResource BgModule}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource ModuleCornerRadius}" />
  </Style>

  <!--
    **预览外壳的端口占位标记**：只画位置/尺寸/方向色，不画网络名/速率/指示灯。
    位置与尺寸由 `PortMarkerLayout`/`PortMarkerMetrics` 决定，样式不复制数值。
  -->
  <Style Selector="Border.previewPortMarker">
    <Setter Property="Background" Value="{DynamicResource BgChrome}" />
    <Setter Property="BorderBrush" Value="{DynamicResource DirectionReceive}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>
  <Style Selector="Border.previewPortMarker.send">
    <Setter Property="BorderBrush" Value="{DynamicResource DirectionSend}" />
  </Style>

  <Style Selector="TextBlock.previewPortName">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    <Setter Property="FontSize" Value="{DynamicResource PortMarkerFontSize}" />
    <Setter Property="FontFamily" Value="{DynamicResource FontData}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
</Styles>









