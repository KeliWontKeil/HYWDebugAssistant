{
  "contractVersion": 1,
  "note": [
    "**色板契约**（唯一登记处，三个消费者）：① 设置面板按它生成「主题色板」的行（分组 / 用途 / 谁跟随谁）；",
    "② docs/tools/audit-colors.ps1 校验它与色板 XAML（`src/Ui/Styles/Tokens.axaml`，全项目唯一一份色值）",
    "一一对应，并校验**派生规则与内置值一致**、**角色词与词表一一对应**；",
    "③ 主题应用器按它解析（覆盖 → 派生 → 内置），因此应用器**不认识任何具体 token 名**。",
    "它**不含色值**：值只住在色板 XAML 里（值在两处写必然漂）。",
    "字段：",
    "  key      = token 名（与 XAML 的 x:Key 逐字相同）",
    "  group    = 面板分组 id（见 groups）",
    "  purpose  = 用途（一行；面板悬停提示与文档共用）",
    "  roles    = 这一支承担的**角色词**（声明面与运行期共用一份词表；与 ViewInkRoles 双向一一对应）",
    "  derive   = 派生规则：{ from: 源 token, mode: tint|darken|shift, amount: 参数（只有 darken 用） }",
    "             · tint   = 源色的淡底，浓度取**该支内置的不透明度**",
    "             · darken = 源色向黑靠 amount",
    "             · shift  = 源色的邻近色（色相偏移由这一支与源的内置色定义）",
    "             没有 derive（或缺省）= 不派生：用户可直接改，未改就用色板里的值。",
    "             from 必须是**不派生**的支（链条只有一层）。"
  ],
  "groups": [
    { "id": "background", "title": "背景", "expanded": true },
    { "id": "border", "title": "边框", "expanded": true },
    { "id": "ink", "title": "墨色（文字）", "expanded": true },
    { "id": "accent", "title": "主题色", "expanded": true },
    { "id": "direction", "title": "方向", "expanded": false },
    { "id": "semantic", "title": "语义状态", "expanded": true },
    { "id": "overlay", "title": "叠加层", "expanded": false },
    { "id": "surface", "title": "模块表面", "expanded": false }
  ],
  "tokens": [
    { "key": "BgWorkspace", "group": "background", "purpose": "工作区底色（模块窗口之间的底）" },
    { "key": "BgModule", "group": "background", "purpose": "模块窗口与文本面的底" },
    { "key": "BgChrome", "group": "background", "purpose": "外壳、工具栏与状态栏的底" },

    { "key": "BorderDefault", "group": "border", "purpose": "常态边框（分组框、分隔线、曲线外框）" },
    { "key": "BorderStrong", "group": "border", "purpose": "更重一档的边框（只读文本面外框、色块外框）" },

    { "key": "TextPrimary", "group": "ink", "purpose": "正文墨（标签正文、读数、按钮字、输入框文字）", "roles": ["default"] },
    { "key": "TextSecondary", "group": "ink", "purpose": "次级墨（表单标签、分组标题）" },
    { "key": "TextMuted", "group": "ink", "purpose": "弱化墨（说明、脚注、占位、文本层里的 ↵ 标记）", "roles": ["muted"] },

    { "key": "AccentPrimary", "group": "accent", "purpose": "主题色（选中 / 聚焦 / 活动、开关 ON 轨道、命令按钮指向边）", "roles": ["accent"] },
    { "key": "AccentSecondary", "group": "accent", "purpose": "邻近色（曲线线色、叠加层连线）—— 色相随主题色平移", "roles": ["accentSecondary"],
      "derive": { "from": "AccentPrimary", "mode": "shift" } },
    { "key": "AccentStrong", "group": "accent", "purpose": "更重一档的主题色（模块内容区里的指向 / 悬停）—— 比主题色更实", "roles": ["accentStrong"],
      "derive": { "from": "AccentPrimary", "mode": "darken", "amount": 0.18 } },

    { "key": "DirectionSend", "group": "direction", "purpose": "发送方向（网络标签箭头与边框、建网预览描边、叠加层流向箭头）—— 稳定语义，与主题色解耦", "roles": ["directionSend"] },
    { "key": "DirectionReceive", "group": "direction", "purpose": "接收方向（同上）", "roles": ["directionReceive"] },

    { "key": "SemanticOk", "group": "semantic", "purpose": "状态：正常（业务状态点、成功提示）", "roles": ["success"] },
    { "key": "SemanticWarn", "group": "semantic", "purpose": "状态：注意（警告提示、快捷键冲突）", "roles": ["warning"] },
    { "key": "SemanticError", "group": "semantic", "purpose": "状态：失败（错误提示与失败态边框；模块写的角色词 danger 指向它）", "roles": ["danger"] },
    { "key": "SemanticIdle", "group": "semantic", "purpose": "状态：未知 / 空闲（未运行、无数据）", "roles": ["idle"] },

    { "key": "OverlaySelection", "group": "overlay", "purpose": "选中叠加（列表与页签的选中底）—— 主题色的淡底", "derive": { "from": "AccentPrimary", "mode": "tint" } },
    { "key": "OverlayHighlight", "group": "overlay", "purpose": "高亮叠加（悬停、命中提示）—— 主题色的淡底", "derive": { "from": "AccentPrimary", "mode": "tint" } },
    { "key": "OverlayScrim", "group": "overlay", "purpose": "叠加信息层的灰玻璃遮罩（浓度就是玻璃浓度，不是颜色的一部分）" },
    { "key": "OverlayInk", "group": "overlay", "purpose": "遮罩之上的主文字（叠层信息一律浅色墨，与深浅主题无关）" },
    { "key": "OverlayInkMuted", "group": "overlay", "purpose": "遮罩之上的次文字（叠层信息的次级项）" },
    { "key": "OverlayFlow", "group": "overlay", "purpose": "模块内部处理关系线（刻意的中性低对比色，不与方向色争）" },

    { "key": "SurfaceButtonFaceBrush", "group": "surface", "purpose": "命令按钮常态面" },
    { "key": "SurfaceButtonFaceHoverBrush", "group": "surface", "purpose": "命令按钮指向面 —— 主题色的淡底（浓度 = 内置不透明度）", "derive": { "from": "AccentPrimary", "mode": "tint" } },
    { "key": "SurfaceButtonFacePressedBrush", "group": "surface", "purpose": "命令按钮按下 —— 主题色的淡底，比指向更实", "derive": { "from": "AccentPrimary", "mode": "tint" } },
    { "key": "SurfaceButtonEdgeBrush", "group": "surface", "purpose": "命令按钮常态边" },
    { "key": "SurfaceToggleTrackOffBrush", "group": "surface", "purpose": "开关 OFF 轨道" },
    { "key": "SurfaceToggleTrackOffHoverBrush", "group": "surface", "purpose": "开关 OFF 轨道（指向）" },
    { "key": "SurfaceToggleKnobBrush", "group": "surface", "purpose": "开关圆钮（浅色下与模块底同色，故必须单独一支）" },
    { "key": "SurfaceToggleKnobEdgeBrush", "group": "surface", "purpose": "开关圆钮外沿（浅深两套不同，不许合并）" },
    { "key": "SurfaceTextFrameEditableBrush", "group": "surface", "purpose": "可写文本面的外框（比只读那一圈深一档，两者要一眼分得开）" },
    { "key": "SurfaceTabHoverBrush", "group": "surface", "purpose": "页签悬停底 —— 主题色的淡底", "derive": { "from": "AccentPrimary", "mode": "tint" } },
    { "key": "SurfaceTabSelectedBackgroundBrush", "group": "surface", "purpose": "页签选中底 —— 主题色的淡底，比悬停更实", "derive": { "from": "AccentPrimary", "mode": "tint" } },
    { "key": "SurfaceTabSelectedHoverBrush", "group": "surface", "purpose": "页签选中且悬停 —— 主题色的淡底，最实的一档", "derive": { "from": "AccentPrimary", "mode": "tint" } }
  ]
}
