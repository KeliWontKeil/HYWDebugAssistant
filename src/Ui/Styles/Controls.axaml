<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      统一控件尺寸与字号【M1-16 / ADR-0040 D4】：
      · 输入类控件高度 = **ControlHeight（27）**，与 12 px 字号匹配（用户第六轮反馈"所有文本框都太高"）；
      · 尺寸只从 token 取，**禁止逐处写死高度**；
      · 应用范围 = 全局（模块窗口内的配置表单、发送器视图、外壳与弹窗一致）。
    -->
    <Style Selector="TextBox">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    </Style>

    <!--
      图标按钮（模块窗口按钮簇）：纯图标、无文字、正方形热区。
      【ADR-0039 D1】按钮簇在**右上角**，悬停或选中时淡入（透明度策略在 ModuleWindow 内定义）。
    -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.icon PathIcon">
        <Setter Property="Width" Value="12" />
        <Setter Property="Height" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <Style Selector="Button.icon:pointerover PathIcon">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
    </Style>

</Styles>
