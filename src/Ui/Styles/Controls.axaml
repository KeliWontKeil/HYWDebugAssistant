<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      统一控件尺寸与字号【M1-16 / ADR-0040 D4】：
      · 输入类控件高度 = **ControlHeight（27）**，与 12 px 字号匹配（用户第六轮反馈"所有文本框都太高"）；
      · 尺寸只从 token 取，**禁止逐处写死高度**；
      · 应用范围 = 全局（模块窗口内的配置表单、发送器视图、外壳与弹窗一致）。
    -->
    <Style Selector="TextBox">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ComboBox">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="10,0" />
        <!-- 【用户第七轮反馈】按钮文本**一律居中**（此前个别按钮继承左对齐，观感不齐） -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      **帮助按钮**（用户第十轮反馈）：**弹窗式帮助**，不再在控件旁展开文本（展开会改变布局）。
      · 16×16、**有边框**（此前是无边框的问号，几乎看不见）、靠右/右下摆放、各页面同一 X 对齐；
      · 用法：`<Button Classes="helpIcon"><Button.Flyout><Flyout>…文本…</Flyout></Button.Flyout></Button>`
        —— 点击弹窗、点外部关闭，**不占用版面**。
    -->
    <Style Selector="Button.helpIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Content" Value="?" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.helpIcon:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
        <Setter Property="Background" Value="{DynamicResource OverlayHighlight}" />
    </Style>

    <!--
      **区域边框**（用户第十轮反馈："各控件没有边框、区域边界不明显"）：
      列表/输入等控件给 1 px 边框与统一圆角，页面的分区容器用 `Border.pane`。
    -->
    <Style Selector="ListBox">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Border.pane">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource BgChrome}" />
    </Style>

    <!-- 分区标题（小号半粗；与区域边框配套） -->
    <Style Selector="TextBlock.paneTitle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!--
      **分类标签**（模块清单顶部横向标签；用户第十轮反馈）：
      **固定宽度**（由使用处给 Width）→ 切换分类**不会推动其它控件**；选中态用边框 + 底色 + 主色文字。
    -->
    <Style Selector="Button.tab">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    </Style>

    <Style Selector="Button.tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource OverlayHighlight}" />
    </Style>

    <Style Selector="Button.tab.active">
        <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    </Style>

    <Style Selector="Button.tab.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    </Style>

    <!--
      图标按钮（模块窗口按钮簇）：纯图标、无文字、正方形热区。
      【ADR-0039 D1】按钮簇在**右上角**，悬停或选中时淡入（透明度策略在 ModuleWindow 内定义）。
    -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 图标字形（**系统图标字体**，见 Tokens 的 FontIcons；字号 13 与 20×20 按钮相称） -->
    <Style Selector="TextBlock.icon">
        <Setter Property="FontFamily" Value="{DynamicResource FontIcons}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- 活动栏按钮里的图标：大一号，颜色随选中态 -->
    <Style Selector="Button.rail TextBlock.icon">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style Selector="Button.rail.active TextBlock.icon">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
    </Style>

</Styles>
