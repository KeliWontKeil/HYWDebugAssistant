<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:HYWDebugAssistant.Ui.Controls"
        xmlns:sdkui="using:HYWDebugAssistant.Sdk.Ui.Controls">

    <!--
      统一控件尺寸与字号：
      · 输入类控件高度取 **ControlHeight**，与界面字号匹配（否则文本框比内容还高）；
      · 尺寸只从 token 取，**禁止逐处写死高度**；
      · 应用范围 = 全局（模块窗口内的配置表单、发送器视图、外壳与弹窗一致）。
    -->

    <Styles.Resources>
      <!--
        宿主界面的滑块开关（设置页 / 交互页）：轨道 + 圆钮，ON 走主题色。
        它派生自 ToggleButton，`ButtonChrome` 的按钮规则已排除 Toggle 派生控件，
        所以这里必须给它自己的 ControlTheme；不要再让 Fluent CheckBox 出场。
      -->
      <ControlTheme x:Key="{x:Type ui:UiToggle}" TargetType="ui:UiToggle">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
          <ControlTemplate>
            <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
              <Border Name="PART_Track" Width="36" Height="18" CornerRadius="9"
                      Background="{DynamicResource SurfaceToggleTrackOffBrush}"
                      BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1"
                      VerticalAlignment="Center">
                <Border Name="PART_Knob" Width="14" Height="14" CornerRadius="7"
                        Background="{DynamicResource SurfaceToggleKnobBrush}"
                        BorderBrush="{DynamicResource SurfaceToggleKnobEdgeBrush}" BorderThickness="1"
                        HorizontalAlignment="Left" VerticalAlignment="Center" Margin="2,0,2,0">
                  <Border.Transitions>
                    <Transitions>
                      <ThicknessTransition Property="Margin" Duration="0:0:0.16" />
                    </Transitions>
                  </Border.Transitions>
                </Border>
              </Border>
              <ContentPresenter Grid.Column="1" Margin="6,0,0,0"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}"
                                Foreground="{TemplateBinding Foreground}"
                                FontSize="{TemplateBinding FontSize}"
                                VerticalAlignment="Center" />
            </Grid>
          </ControlTemplate>
        </Setter>

        <Style Selector="^:pointerover /template/ Border#PART_Track">
          <Setter Property="Background" Value="{DynamicResource SurfaceToggleTrackOffHoverBrush}" />
        </Style>

        <Style Selector="^:checked /template/ Border#PART_Track">
          <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <Style Selector="^:checked:pointerover /template/ Border#PART_Track">
          <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
          <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <Style Selector="^:checked /template/ Border#PART_Knob">
          <Setter Property="Margin" Value="18,0,2,0" />
        </Style>

        <Style Selector="^:disabled">
          <Setter Property="Opacity" Value="0.5" />
        </Style>
      </ControlTheme>
    </Styles.Resources>

    <Style Selector="ui|UiToggle">
      <Setter Property="Theme" Value="{DynamicResource {x:Type ui:UiToggle}}" />
    </Style>

    <!--
      【2026-09 缺陷修复 · 用户实测"界面字体改了没反应"】**把 `FontUi` 真正用起来**：
      此前它只在 `Tokens.axaml` 里定义、**全应用无一处引用** ⇒ 换界面对界面文字毫无影响（只有"数据字体"
      因为各输入框显式引用了 `FontData` 才生效）。`FontFamily` 是**继承属性** ⇒ 在窗口这一层设一次，
      整棵树都跟着走；模块数据区各自的 `FontFamily="{DynamicResource FontData}"` 是**元素级**值，优先级更高，
      所以数据字体不会被这条盖掉。
    -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource FontUi}" />
    </Style>

    <Style Selector="TextBox">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      输入框的**绘制**（常态框 / 焦点圈 / 错误圈 / 只读与禁用态）统一在 `Styles/InputChrome.axaml`；
      本文件只保留尺寸与字号，不再写颜色覆盖。
    -->

    <!--
      **默认高度只由 Height 给，MinHeight 必须是 0**：派生控件（例如 ModuleSelect）的
      `MinHeight` 一旦等于默认高度，局部声明更小的高度就会被悄悄压回去。
    -->
    <Style Selector="ComboBox">
        <Setter Property="Height" Value="{DynamicResource ControlHeight}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="10,0" />
        <!-- 【用户第七轮反馈】按钮文本**一律居中**（此前个别按钮继承左对齐，观感不齐） -->
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      **按钮的指向 / 按下**由 `Styles/ButtonChrome.axaml` 统一给（那一份排在最后，且同时打在
      控件自身与模板部件上 —— 部件才是画在最上面的那一层）。

      **这里刻意不再写 `Button:pointerover` / `Button:pressed`**：那两条会**对所有按钮**生效，
      优先级又高于"按类名收窄"的规则，于是普通按钮在指向/按下时会被**先刷一层浅主色**、
      再叠 ButtonChrome 的面色 —— 屏幕上就是"多叠了一层"（实测）。自带底色的按钮类
      （`.tab` / `.rail` / `.helpIcon`）各自有指针态；`.icon` 的面与指针态由 `ButtonChrome.axaml`
      统一给（图标按钮与普通按钮同面），这里也不需要这两条。
    -->

    <Style Selector="ToggleButton">
        <Setter Property="MinHeight" Value="{DynamicResource ControlHeight}" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
      **帮助按钮**：**弹窗式帮助**，不在控件旁展开文本（展开会改变布局）。
      · **有边框**（无边框的问号几乎看不见）、靠右/右下摆放、各页面同一 X 对齐；尺寸是一枚小方块；
      · 用法：`<Button Classes="helpIcon"><Button.Flyout><Flyout>…文本…</Flyout></Button.Flyout></Button>`
        —— 点击弹窗、点外部关闭，**不占用版面**。
    -->
    <Style Selector="Button.helpIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="MinHeight" Value="16" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Content" Value="?" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.helpIcon:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
        <Setter Property="Background" Value="{DynamicResource OverlayHighlight}" />
    </Style>

    <!--
      **区域边框**：列表/输入等控件给细边框与统一圆角（边界要看得出来），页面的分区容器用 `Border.pane`。
    -->
    <Style Selector="ListBox">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
    </Style>

    <Style Selector="Border.pane">
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="{DynamicResource BgChrome}" />
    </Style>

    <!--
      **操作状态行**（模块清单 / 组合页共用）：固定高度，单行省略；完整详情放 ToolTip/Issue。
    -->
    <Style Selector="TextBlock.operationStatus">
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>
    <Style Selector="TextBlock.operationStatus.error">
        <Setter Property="Foreground" Value="{DynamicResource SemanticError}" />
    </Style>
    <Style Selector="TextBlock.operationHint">
        <Setter Property="Height" Value="18" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="Foreground" Value="{DynamicResource SemanticWarn}" />
    </Style>

    <!-- 分区标题（小号半粗；与区域边框配套） -->
    <Style Selector="TextBlock.paneTitle">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!--
      **列表预览图块**（模块清单与组合列表共用同一套尺寸/边框/圆角）：
      当前用占位字形；以后接真实缩略图时只替换内容，尺寸与边框不变。
    -->
    <Style Selector="Border.previewTile">
        <Setter Property="Width" Value="72" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Background" Value="{DynamicResource BgWorkspace}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="2" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <!-- 预览图占位图标：无图时居中显示（尺寸由声明给出），不再是一块全空。 -->
    <Style Selector="ui|Glyph.previewGlyph">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Opacity" Value="0.55" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
      **分类标签**（模块清单顶部横向标签；用户第十轮反馈）：
      **固定宽度**（由使用处给 Width）→ 切换分类**不会推动其它控件**；选中态用边框 + 底色 + 主色文字。
    -->
    <Style Selector="Button.tab">
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="6,0" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
    </Style>

    <Style Selector="Button.tab:pointerover">
        <Setter Property="Background" Value="{DynamicResource OverlayHighlight}" />
    </Style>

    <Style Selector="Button.tab.active">
        <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    </Style>

    <Style Selector="Button.tab.active TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="FontSize" Value="{DynamicResource ControlFontSize}" />
    </Style>

    <!--
      图标按钮（模块窗口按钮簇 / 弹窗删除按钮）：纯图标、正方形热区。
      **面/边/指针态与普通按钮同一套**（`ButtonChrome.axaml` 的 `:is(Button)` 规则不再排除 `.icon`）：
      这里只收窄尺寸与内边距；图标颜色由 `IconButton` 绑定到按钮 `Foreground`，与文字同一档。
      不再把按钮写成无面、无边的透明容器，否则屏幕上就是"一个漂浮的符号"，
      点它之前看不出它是按钮。
      选择器按**精确类型**写：Avalonia 的类型选择器不匹配派生类型，`Button.icon` 不会作用到 `IconButton`。
    -->
    <Style Selector="ui|IconButton">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style Selector="ui|IconButton.icon">
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- 按钮里那枚图标：占按钮的内容区再小一档（内容区 = 按钮减去边框），比顶满更透气 -->
    <Style Selector="ui|IconButton.icon sdkui|Icon">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="14" />
    </Style>

    <!--
      `Glyph` 是 `Sdk.Ui.Icon` 的子类：Avalonia 的隐式主题按**精确类型**查，
      所以显式把它指到 `Icon` 的 ControlTheme（同一手法见 ButtonChrome 给 Button 指主题那条）。
    -->
    <Style Selector="ui|Glyph">
        <Setter Property="Theme" Value="{DynamicResource {x:Type sdkui:Icon}}" />
    </Style>

    <!-- 图标（显式 SVG）的默认尺寸与颜色；rail / 预览占位另有尺寸样式。 -->
    <Style Selector="ui|Glyph.icon">
        <Setter Property="Width" Value="13" />
        <Setter Property="Height" Value="13" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!-- 活动栏按钮里的图标：大一号，颜色随选中态 -->
    <Style Selector="Button.rail ui|Glyph.icon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
    </Style>

    <Style Selector="Button.rail.active ui|Glyph.icon">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
    </Style>

    <!--
      标签里的图标与文字同一档：选中时一起转主色。
      必须排在 `ui|Glyph.icon` 之后 —— Avalonia 的样式是按声明顺序覆盖，不是 CSS 优先级。
    -->
    <Style Selector="Button.tab.active ui|Glyph.icon">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
    </Style>

</Styles>
