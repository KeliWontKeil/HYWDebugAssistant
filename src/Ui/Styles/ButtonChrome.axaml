<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls">
  <!--
    按钮的壳与五态（全应用）。

    四条事实（两条来自文档、两条来自本项目实测），合起来才是这份文件的写法：

    1. Fluent 的按钮模板把指针态颜色打在模板部件 ContentPresenter#PART_ContentPresenter 上，
       绕过 Button.Background（Styles 排障页的 "Pseudoclass style is not applied" 一节）。
    2. ControlTheme 里用 ^:pointerover 指控件自身、由模板 TemplateBinding 带出去（Control Themes 一页的例子）。
    3. Fluent 那条样式按模板部件名匹配、不认模板是谁的：换成我们自己的模板后它照样生效，
       而且它在控制主题之后处理 => 主题内的嵌套样式赢不了它。
    4. 所以五态要在应用样式集合里、排在 Fluent 之后声明（本文件挂在 Controls.axaml 之后），
       并且同时打在控件自身属性与那个部件的 Background 上 ——
       部件的 Background 才是页面像素的直接来源（实测：常态 #33000000、指针 #FF000000，
       屏幕上就是"我们的色叠 20% 黑"）。
  -->

  <!--
    **只服务 Button / ModuleButton，不服务 Toggle 派生控件**：
    `CheckBox` / `RadioButton` 派生自 `ToggleButton`，而 `ToggleButton` 派生自 `Button`。
    所以 `:is(Button)` 会同时匹配它们，把这里的 Button 控制主题套到它们身上 ——
    表现为"所有开关都变成了按钮"（实测：设置页与交互页的 CheckBox 全变成按钮）。
    下面所有按钮规则都必须排除 Toggle 派生类型。
  -->
  <Styles.Resources>
    <!--
      按钮的控制主题：x:Key="{x:Type Button}"（对所有 Button），由下面的 Theme setter 指过来。
      只负责壳（模板、圆角、对齐、焦点环）；颜色与五态在本文件下面的样式里。
      基础 setter 刻意最小，以免把"自带背景"的按钮类（`.helpIcon` 圆形、`.tab`、`.rail`）
      平时就改掉；`.icon` 与普通按钮同面（见文件下半部分的说明）。
    -->
    <ControlTheme x:Key="{x:Type Button}" TargetType="Button">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />

      <Setter Property="Template">
        <ControlTemplate>
          <Border
            Name="Chrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            Padding="{TemplateBinding Padding}">
            <!--
              **部件一律透明**：底色只由外层那块 `Border#Chrome` 画一次。
              为什么：`ContentPresenter` 只占**内边距以内**的区域，让它也画一次底色就会变成
              "外圈一个色、中间一块另一个色"的**方块**（实测：页签中央那块没占满的蓝就是这么来的）。
              另外这也顺手绕开了 Fluent 那条按部件名给指针态刷半透明黑的样式 ——
              部件不画底色，它刷什么都不会上屏。
            -->
            <ContentPresenter
              Name="PART_ContentPresenter"
              Background="Transparent"
              Content="{TemplateBinding Content}"
              ContentTemplate="{TemplateBinding ContentTemplate}"
              Foreground="{TemplateBinding Foreground}"
              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
              RecognizesAccessKey="True" />
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>

    <!--
      **模块命令按钮**：通用按钮壳 + 可选的右侧菜单段。

      它是两段式按钮，但**只有一个状态写入者**：控件代码按实际指针位置给
      `PART_BodyHost` / `PART_MenuHost` 加 `segment-*` 类；模板和样式不再让父按钮
      与箭头区各自响应 `:pointerover`（那正是“指示区对不上、还会闪”的来源）。
      箭头段贴右缘、占满内高；命中区由这个模板部件的实际 Bounds 导出，代码里不重复宽度。
    -->
    <ControlTheme x:Key="{x:Type ui:ModuleButton}" TargetType="ui:ModuleButton">
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="6,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
      <Setter Property="FocusAdorner" Value="{x:Null}" />

      <Setter Property="Template">
        <ControlTemplate>
          <Border
            Name="Chrome"
            Background="{TemplateBinding Background}"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            CornerRadius="{TemplateBinding CornerRadius}"
            ClipToBounds="True">
            <Grid ColumnDefinitions="*,Auto">
              <Border Name="PART_BodyHost"
                      Grid.Column="0"
                      Padding="{TemplateBinding Padding}">
                <ContentPresenter
                  Name="PART_ContentPresenter"
                  Background="Transparent"
                  Content="{TemplateBinding Content}"
                  ContentTemplate="{TemplateBinding ContentTemplate}"
                  Foreground="{TemplateBinding Foreground}"
                  HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                  RecognizesAccessKey="True" />
              </Border>

              <!-- 菜单段：无菜单值时由下面的样式整块隐藏。 -->
              <Border Name="PART_MenuHost"
                      Grid.Column="1"
                      Width="24"
                      Cursor="Hand">
                <Grid ColumnDefinitions="Auto,*">
                  <Rectangle Grid.Column="0"
                             Width="1" Height="16"
                             Margin="0,0,6,0"
                             VerticalAlignment="Center"
                             Fill="{TemplateBinding Foreground}" Opacity="0.65" />
                  <Path Grid.Column="1"
                        Data="M 0,0 L 4,4 L 8,0"
                        Margin="0,0,5,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Stroke="{TemplateBinding Foreground}"
                        StrokeThickness="1.4"
                        StrokeLineCap="Round"
                        StrokeJoin="Round" />
                </Grid>
              </Border>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </ControlTheme>
  </Styles.Resources>

  <!--
    **`:is(Button)` 而不是 `Button`**：Avalonia 的类型选择器**只匹配精确类型**，
    派生自 Button 的控件（例如模块控件库里的 `ModuleButton`）不会命中 `Button` 那一条。
    实测症状：模块里的按钮只剩一行字 —— 没有面、没有边、没有五态，看起来"按钮不见了"。

    **但必须排除 Toggle 派生控件**：CheckBox / RadioButton 派生自 ToggleButton，
    ToggleButton 又派生自 Button；不排除时它们会拿到 Button 的控制主题，表现为"开关变成按钮"。
    `:not(:is(CheckBox))` / `:not(:is(RadioButton))` 是冗余保险：即使 `:is(ToggleButton)`
    在某版本的选择器实现里不匹配派生类型，也不会再把这两类卷进来。
  -->
  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(:is(ui|ModuleButton))">
    <Setter Property="Theme" Value="{DynamicResource {x:Type Button}}" />
  </Style>

  <!--
    **"按钮面"给除 `.tab` / `.rail` / `.helpIcon` 之外的所有按钮**（含 `.icon`）：
    `.tab`（分类标签）、`.rail`（活动栏）、`.helpIcon`（问号）自带底色与边框（透明 / 半透明主色 / 圆形），
    它们的外观归各自的类样式。

    为什么这三类必须排除：这几条声明在 `Controls.axaml` 与 `ButtonChrome.axaml` **之前**，
    后声明的会赢 —— 不排除的话，标签自己的"选中蓝底"会被替换成中性的按钮面，
    于是中央出现一块**与它底色对不上的方块**（实测：页签里一块浅蓝）。

    为什么 `.icon` **不再**排除：图标按钮是**按钮**，不是"漂浮的符号"——它有面、有边、有指针态，
    与普通按钮同一套色；不给面会被读成"点了没反应"的纯图标（本轮的整改目标）。
    图标按钮只额外收窄了尺寸与内边距（尺寸取该类自己的声明值）。

    部件（`ContentPresenter`）不必在这里写：它跟随控件的 `Background`（模板里是 `TemplateBinding`），
    所以"面"会自动跟着走；`TemplateBinding` 是绑定、优先级高于按部件名的样式，
    这也正好把它从 Fluent 的半透明黑里摘出来。
  -->
  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon)">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceButtonEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon):pointerover">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon):pressed">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFacePressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <!-- 键盘焦点：边换主色、厚度不变（改厚度按钮会长胖、把旁边的控件挤动 —— 与滑块同一条纪律） -->
  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <!--
    **"持久选中"的按钮（分类标签、活动栏）不带焦点环**：它们已经有**选中态**在表达"我在哪儿"
    （页签是蓝底 + 蓝字、活动栏是主色图标），再叠一圈主色边就变成"多余的选中框"
    （实测：鼠标点一下标签，焦点环就套在已选中的蓝底上）。
    这里给回**它们各自类样式用的那个边框色**（而不是主色）：标签用 `BorderDefault`、活动栏用
    `TextSecondary` —— 与它们平时的样子一致，只是不再"发蓝"。
  -->
  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)).tab:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)).rail:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource TextSecondary}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <!--
    **按钮外观档位**（模块按钮 `Appearance` 的落点）：常规、主题色强调、删除红。
    选择器在通用壳选择器上再加一个类 ⇒ 比通用五态更具体，且排在其后；
    颜色只来自色板 token（主题色/失败色的派生支），这里不写任何色值。
  -->
  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon).accent">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon).accent:pointerover">
    <Setter Property="Background" Value="{DynamicResource AccentStrong}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentStrong}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon).accent:pressed">
    <Setter Property="Background" Value="{DynamicResource ButtonAccentFacePressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonAccentFacePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon).accent:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon).danger">
    <Setter Property="Background" Value="{DynamicResource SemanticError}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemanticError}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon).danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource ButtonDangerFaceHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerFaceHoverBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon).danger:pressed">
    <Setter Property="Background" Value="{DynamicResource ButtonDangerFacePressedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ButtonDangerFacePressedBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <Style Selector=":is(Button):not(:is(ToggleButton)):not(:is(CheckBox)):not(:is(RadioButton)):not(.tab):not(.rail):not(.helpIcon).danger:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <!--
    **模块按钮**：普通按钮直接使用外层 Button 的原生五态（与主窗口按钮同一套面与边框）；
    只有带菜单的 `.menu` 才由两个模板段接管段内底色。
    外框边框不在这里收回：悬停时仍由通用按钮规则给主题色，保持全应用一致。
  -->
  <Style Selector="ui|ModuleButton">
    <Setter Property="BorderBrush" Value="{DynamicResource SurfaceButtonEdgeBrush}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>

  <Style Selector="ui|ModuleButton.accent">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleButton.danger">
    <Setter Property="BorderBrush" Value="{DynamicResource SemanticError}" />
  </Style>

  <!--
    两个段的常态面只在**有菜单**时接管底色；无菜单的普通按钮保持主体段透明，
    让外层 Button 的原生底/悬停/按下态直接透出。
  -->
  <Style Selector="ui|ModuleButton.menu /template/ Border#PART_BodyHost">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFaceBrush}" />
    <Setter Property="CornerRadius" Value="3,0,0,3" />
  </Style>

  <Style Selector="ui|ModuleButton.menu /template/ Border#PART_MenuHost">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFaceBrush}" />
    <Setter Property="CornerRadius" Value="0,3,3,0" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.accent /template/ Border#PART_BodyHost">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.accent /template/ Border#PART_MenuHost">
    <Setter Property="Background" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.danger /template/ Border#PART_BodyHost">
    <Setter Property="Background" Value="{DynamicResource SemanticError}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.danger /template/ Border#PART_MenuHost">
    <Setter Property="Background" Value="{DynamicResource SemanticError}" />
  </Style>

  <Style Selector="ui|ModuleButton:not(.menu) /template/ Border#PART_MenuHost">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <Style Selector="ui|ModuleButton:not(.menu) /template/ Border#PART_BodyHost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="3" />
  </Style>

  <!-- 悬停：只覆盖指针所在的那一段。 -->
  <Style Selector="ui|ModuleButton.menu /template/ Border#PART_BodyHost.segment-hover">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFaceHoverBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu /template/ Border#PART_MenuHost.segment-hover">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFaceHoverBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.accent /template/ Border#PART_BodyHost.segment-hover">
    <Setter Property="Background" Value="{DynamicResource AccentStrong}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.accent /template/ Border#PART_MenuHost.segment-hover">
    <Setter Property="Background" Value="{DynamicResource AccentStrong}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.danger /template/ Border#PART_BodyHost.segment-hover">
    <Setter Property="Background" Value="{DynamicResource ButtonDangerFaceHoverBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.danger /template/ Border#PART_MenuHost.segment-hover">
    <Setter Property="Background" Value="{DynamicResource ButtonDangerFaceHoverBrush}" />
  </Style>

  <!-- 按下：同样只作用于按下时指针所在的那一段。 -->
  <Style Selector="ui|ModuleButton.menu /template/ Border#PART_BodyHost.segment-pressed">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFacePressedBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu /template/ Border#PART_MenuHost.segment-pressed">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFacePressedBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.accent /template/ Border#PART_BodyHost.segment-pressed">
    <Setter Property="Background" Value="{DynamicResource ButtonAccentFacePressedBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.accent /template/ Border#PART_MenuHost.segment-pressed">
    <Setter Property="Background" Value="{DynamicResource ButtonAccentFacePressedBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.danger /template/ Border#PART_BodyHost.segment-pressed">
    <Setter Property="Background" Value="{DynamicResource ButtonDangerFacePressedBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.danger /template/ Border#PART_MenuHost.segment-pressed">
    <Setter Property="Background" Value="{DynamicResource ButtonDangerFacePressedBrush}" />
  </Style>

  <!-- 菜单打开：箭头段保持“按下”观感，关闭后按指针位置恢复。 -->
  <Style Selector="ui|ModuleButton.menu /template/ Border#PART_MenuHost.segment-open">
    <Setter Property="Background" Value="{DynamicResource SurfaceButtonFacePressedBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.accent /template/ Border#PART_MenuHost.segment-open">
    <Setter Property="Background" Value="{DynamicResource ButtonAccentFacePressedBrush}" />
  </Style>

  <Style Selector="ui|ModuleButton.menu.danger /template/ Border#PART_MenuHost.segment-open">
    <Setter Property="Background" Value="{DynamicResource ButtonDangerFacePressedBrush}" />
  </Style>

  <!-- 焦点只改外框，不改厚度；两段底色仍由各自状态决定。 -->
  <Style Selector="ui|ModuleButton:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
  </Style>

  <Style Selector="ui|ModuleButton.accent:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <Style Selector="ui|ModuleButton.danger:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource TextOnAccent}" />
  </Style>

  <!-- 面板打开期间，打开它的按钮保持“这是我的面板”的边框与淡底；只改色，不改厚度。 -->
  <Style Selector="ui|ModuleButton.panel-anchor">
    <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
    <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
  </Style>
</Styles>
