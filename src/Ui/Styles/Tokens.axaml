<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      **滚动条常驻细条**：Fluent 的默认尺寸很宽，且 `IsExpanded` 会把 Thumb 的缩放去掉、瞬间占满；
      这里把尺寸压到细条，并让 App 统一 `AllowAutoHide=False`。因为该状态本身就是“展开”，
      实际视觉宽度由这个尺寸决定，而不是由缩放决定；缩放只作未展开状态的防御。
    -->
    <x:Double x:Key="ScrollBarSize">4</x:Double>
    <TransformOperations x:Key="VerticalSmallScrollThumbScaleTransform">scaleX(0.5) translateX(-2px)</TransformOperations>
    <TransformOperations x:Key="HorizontalSmallScrollThumbScaleTransform">scaleY(0.5) translateY(-2px)</TransformOperations>

    <!--
      视觉 token（docs/zh/concepts/shell.md）：
      颜色一律以**角色 token** 引用，主题切换只替换 token 值（V2 的可切换与"允许更换背景/色系"由此实现）。
      · 默认主题 = 浅色（C9-2）；深色同样内置且可切换。
      · 色值取自 09 §2.2 草案（C9-3 已采用；Gate C 可微调）。
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgWorkspace" Color="#F3F4F6" />
            <SolidColorBrush x:Key="BgModule" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BgChrome" Color="#FAFAFA" />
            <!-- 壁纸遮罩的底色（实际浓度由设置里的 wallpaperVeilOpacity 控制；这里只定色）。 -->
            <SolidColorBrush x:Key="WallpaperVeil" Color="#F8F4F6" />
            <SolidColorBrush x:Key="BorderDefault" Color="#D4D4D8" />
            <SolidColorBrush x:Key="BorderStrong" Color="#A1A1AA" />
            <SolidColorBrush x:Key="TextPrimary" Color="#18181B" />
            <SolidColorBrush x:Key="TextSecondary" Color="#52525B" />
            <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA" />
            <SolidColorBrush x:Key="AccentPrimary" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentSecondary" Color="#0891B2" />

            <!--
              **更重一档的主题色**：由主题色派生（向黑 18%，见 `PaletteDerivation`）。
              内置值 = **该公式在默认主题色上的结果**（不是另挑的一个色）——
              这样"没改主题色"与"派生算出来"是同一个值，两者不会各说一套。
            -->
            <SolidColorBrush x:Key="AccentStrong" Color="#1E51C0" />

            <!--
              **方向语义色**【ADR-0044 · 用户第十四轮裁决 D1a】：发送 / 接收是**稳定语义**，
              必须与"主题色"解耦 —— 主题色只表达"选中/聚焦/活动"等**框架性交互**语义；
              方向色可被用户在设置里覆盖（空 = 跟随这里的内置默认值）。
              默认刻意避开"红/绿"对（色盲友好）：发送 = 暖橙、接收 = 冷青。
            -->
            <SolidColorBrush x:Key="DirectionSend" Color="#EA580C" />
            <SolidColorBrush x:Key="DirectionReceive" Color="#0891B2" />
            <SolidColorBrush x:Key="SemanticOk" Color="#16A34A" />
            <SolidColorBrush x:Key="SemanticWarn" Color="#D97706" />
            <SolidColorBrush x:Key="SemanticError" Color="#EF4444" />
            <SolidColorBrush x:Key="SemanticIdle" Color="#9CA3AF" />
            <SolidColorBrush x:Key="OverlaySelection" Color="#2563EB" Opacity="0.20" />
            <SolidColorBrush x:Key="OverlayHighlight" Color="#2563EB" Opacity="0.12" />

            <!--
              **叠加信息层专用**：开启时"模块上盖一层灰玻璃"= 最常见的"变暗遮罩"做法 ——
              一层半透明深色 + 其上的**浅色文字**（与主题无关：遮罩是深色，所以叠层信息一律用浅色墨水）。
              · `OverlayScrim`：遮罩（不透明度即"玻璃浓度"，改这里就改观感）；不做背景模糊（跨平台代价高）。
                浓度必须让**方向色与叠层文字都读得出来**：太浅时方向色与底子对比度不足（几乎看不见），
                太深时下方的网络标签与通路速率被压到读不清；具体值指向 token 本身（这里不抄数值）。
              · `OverlayInk` / `OverlayInkMuted`：叠层上的主/次文字色。
            -->
            <SolidColorBrush x:Key="OverlayScrim" Color="#0B1220" Opacity="0.6" />
            <SolidColorBrush x:Key="OverlayInk" Color="#F8FAFC" />
            <SolidColorBrush x:Key="OverlayInkMuted" Color="#A5B4C8" />
            <!--
              **内部处理关系线**（ADR-0049 D13/Q11）：模块**自己的**结构（角色 → 角色），与数据面连接无关。
              刻意用**中性低对比**色 ⇒ 用户一眼能分清"哪条是网络连接（方向色 + 流动虚线）、哪条只是模块内部结构"。
            -->
            <SolidColorBrush x:Key="OverlayFlow" Color="#8FA3BF" Opacity="0.85" />

            <!--
              **按钮的常态与"按下去"那几档色**：`Styles/ButtonChrome.axaml`（全应用按钮壳）与模块的命令按钮
              样式都读它们，所以放全局这一份。
              · 常态：浅面 + 细边（与窗口底分得开）；
              · 指向 / 按下：**主题色的淡底** —— 色随主题色、浓度就是这里的 `Opacity`
                （由应用器按套读走，代码里不抄第二份）。不用"主色 + 元素透明度"：那会把按钮上的字一起淡掉。
                为什么不是"写死的浅蓝"：那正是"指向时底是蓝的、边是橙的"那种对不上的来源。
            -->
            <SolidColorBrush x:Key="SurfaceButtonFaceBrush" Color="#F4F4F5" />
            <SolidColorBrush x:Key="SurfaceButtonFaceHoverBrush" Color="#2563EB" Opacity="0.13" />
            <SolidColorBrush x:Key="SurfaceButtonFacePressedBrush" Color="#2563EB" Opacity="0.24" />
            <SolidColorBrush x:Key="SurfaceButtonEdgeBrush" Color="#A1A1AA" />

            <!--
              **模块内容区专有的那几支**（分区：模块表面）。
              它们与上面那些全局角色**同住这一个文件**：色板只有一处（浅深两套各一份）——
              "模块表面的观感"以前住在另一个文件里，于是"改一处颜色要去两个文件找"。
              尺寸（内容区留白 / 行高 / 字号 / 曲线内缩…）仍住在 `ModuleSurface/Theme/ModuleSurfaceMetrics.axaml`：
              它们不是颜色，也不随主题变。
            -->
            <SolidColorBrush x:Key="SurfaceToggleTrackOffBrush" Color="#E4E4E7" />
            <SolidColorBrush x:Key="SurfaceToggleTrackOffHoverBrush" Color="#D4D4D8" />
            <SolidColorBrush x:Key="SurfaceToggleKnobBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="SurfaceToggleKnobEdgeBrush" Color="#D4D4D8" />
            <!--
              **主题色淡底那三支**（页签悬停 / 选中）：**色**由主题色派生（改主题色即跟随），
              **浓度**就是这里的 `Opacity`（由应用器按套读走，代码里不抄第二份）。
              `Color="{DynamicResource AccentPrimary}"` 这种写法**不行**（token 是画刷，`Color` 要 `Color` ⇒
              运行时 `InvalidCastException`）；而"引画刷 + 元素 `Opacity`"会把页签文字一起淡掉。
            -->
            <SolidColorBrush x:Key="SurfaceTabHoverBrush" Color="#2563EB" Opacity="0.06" />
            <SolidColorBrush x:Key="SurfaceTabSelectedBackgroundBrush" Color="#2563EB" Opacity="0.12" />
            <SolidColorBrush x:Key="SurfaceTabSelectedHoverBrush" Color="#2563EB" Opacity="0.22" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgWorkspace" Color="#1E1E1E" />
            <SolidColorBrush x:Key="BgModule" Color="#252526" />
            <SolidColorBrush x:Key="BgChrome" Color="#252526" />
            <SolidColorBrush x:Key="WallpaperVeil" Color="#0B0E16" />
            <SolidColorBrush x:Key="BorderDefault" Color="#3F3F46" />
            <SolidColorBrush x:Key="BorderStrong" Color="#52525B" />
            <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
            <SolidColorBrush x:Key="TextMuted" Color="#71717A" />
            <SolidColorBrush x:Key="AccentPrimary" Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentSecondary" Color="#22D3EE" />

            <!-- 更重一档的主题色（派生色，说明见浅色分支）：内置值 = 公式在深色默认主题色上的结果。 -->
            <SolidColorBrush x:Key="AccentStrong" Color="#306AC9" />

            <!-- 方向语义色【ADR-0044】：深色主题下各提亮一档（同一语义、两套主题各自的内置默认值）。 -->
            <SolidColorBrush x:Key="DirectionSend" Color="#F59E0B" />
            <SolidColorBrush x:Key="DirectionReceive" Color="#22D3EE" />
            <SolidColorBrush x:Key="SemanticOk" Color="#22C55E" />
            <SolidColorBrush x:Key="SemanticWarn" Color="#F59E0B" />
            <SolidColorBrush x:Key="SemanticError" Color="#EF4444" />
            <SolidColorBrush x:Key="SemanticIdle" Color="#6B7280" />
            <SolidColorBrush x:Key="OverlaySelection" Color="#3B82F6" Opacity="0.20" />
            <SolidColorBrush x:Key="OverlayHighlight" Color="#3B82F6" Opacity="0.12" />

            <!-- 叠加层遮罩【ADR-0045】：深色主题下底子本来就深；同样压到 0.85 保证方向色/类型色有足够对比。 -->
            <!-- 【用户第三十四轮二次修正】浓度与浅色主题一致改为 0.60（理由见浅色分支的注释）。 -->
            <SolidColorBrush x:Key="OverlayScrim" Color="#05070D" Opacity="0.6" />
            <SolidColorBrush x:Key="OverlayInk" Color="#F8FAFC" />
            <SolidColorBrush x:Key="OverlayInkMuted" Color="#A5B4C8" />
            <!-- 内部处理关系线【ADR-0049 D13/Q11】：深色主题下略提亮，仍是**中性低对比**（不与方向色争）。 -->
            <SolidColorBrush x:Key="OverlayFlow" Color="#9FB2CC" Opacity="0.85" />

            <!-- 按钮常态/指向/按下那几档色（说明见浅色分支）：指向/按下都是**主题色的淡底** -->
            <SolidColorBrush x:Key="SurfaceButtonFaceBrush" Color="#2A2A2E" />
            <SolidColorBrush x:Key="SurfaceButtonFaceHoverBrush" Color="#3B82F6" Opacity="0.25" />
            <SolidColorBrush x:Key="SurfaceButtonFacePressedBrush" Color="#3B82F6" Opacity="0.40" />
            <SolidColorBrush x:Key="SurfaceButtonEdgeBrush" Color="#52525B" />

            <!-- 模块内容区专有的那几支（说明见浅色分支） -->
            <SolidColorBrush x:Key="SurfaceToggleTrackOffBrush" Color="#3F3F46" />
            <SolidColorBrush x:Key="SurfaceToggleTrackOffHoverBrush" Color="#52525B" />
            <SolidColorBrush x:Key="SurfaceToggleKnobBrush" Color="#F4F4F5" />
            <SolidColorBrush x:Key="SurfaceToggleKnobEdgeBrush" Color="#27272A" />
            <!-- 主题色淡底那三支：色由主题色派生，浓度 = 这里的 Opacity（说明见浅色分支） -->
            <SolidColorBrush x:Key="SurfaceTabHoverBrush" Color="#3B82F6" Opacity="0.10" />
            <SolidColorBrush x:Key="SurfaceTabSelectedBackgroundBrush" Color="#3B82F6" Opacity="0.18" />
            <SolidColorBrush x:Key="SurfaceTabSelectedHoverBrush" Color="#3B82F6" Opacity="0.30" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!--
      这两支**没有**平铺兜底副本 —— 曾经有（理由是"某些查找链解析不到主题字典里的键"），
      但实测表明那份副本会**盖住主题字典里的值**：在合并字典内部，平铺条目先于主题字典被取到，
      于是深色主题读到的其实是**浅色那一份**（`OverlaySelection` 深色应当是 `#3B82F6`）。
      今天不再需要它：色板覆盖由应用器**合并到最后**（那一份只写主题字典，且按套分桶），
      解析链在色板之前就命中它；"解析不到"那种坑由 `ThemeApplier` 的类型注释记着。
    -->


    <!-- 字体：界面用系统字体，数据区用等宽（具体取舍见视觉设计基线） -->
    <FontFamily x:Key="FontUi">Segoe UI, Microsoft YaHei UI</FontFamily>
    <!-- // i18n-exempt: 字体族名（宋体是字体标识，不是界面文案） -->
  <FontFamily x:Key="FontData">Cascadia Mono, 宋体</FontFamily>

    <!--
      尺寸（09 §5）：以固定模数排布，圆角与边框各一档；具体档位只在 token 里定义。
      · 模块窗口没有标题栏/身份行 ⇒ 不设对应 token（没有消费者）。
      · `ModuleCornerRadius` 的类型必须是 **CornerRadius**（不是 Double）：Border.CornerRadius 取该资源时
        会做强类型转换，写成 `<x:Double>` 会在**运行时**抛 InvalidCastException。
    -->
    <CornerRadius x:Key="ModuleCornerRadius">2</CornerRadius>

    <!--
      尺寸 token：**改尺寸只改这里**。
      · 控件高度与界面字号匹配（否则输入类控件比正文还高）；
      · 模块窗口：交互带与缩放手柄各一档（手柄只在选中时可命中）；
      · 端口标记（标准件）：**尺寸不在这里** —— 见 `Ui/Geometry/PortMarkerMetrics.cs`（唯一来源；
        标记内元素尺寸仍在下面）。
    -->
    <x:Double x:Key="ControlHeight">27</x:Double>
    <x:Double x:Key="ControlFontSize">12</x:Double>
    <x:Double x:Key="ModuleHandleSize">6</x:Double>
    <x:Double x:Key="ModuleBandThickness">6</x:Double>
    <x:Double x:Key="PortMarkerFontSize">11</x:Double>

    <!--
      端口标记内元素尺寸：
      · PortMarkerArrowFontSize —— 方向箭头字号（要在灰玻璃遮罩下仍可辨认）；
      · PortMarkerLampSize —— 连接指示灯边长（`StateIndicator` 半径由边长推出，不单独写）；
        标记端部不额外留间距：灯贴到标记"最边缘"；
      · PortMarkerStripWidth —— **数据包类型窄色条**宽度（沿标记长边方向的窄条；竖排时跨满标记内宽）。
        色条颜色 = **类型色板按类型身份给出**（用户覆盖色优先，否则稳定哈希自动色；XAML 不写颜色）。
    -->
    <x:Double x:Key="PortMarkerArrowFontSize">18</x:Double>
    <x:Double x:Key="PortMarkerLampSize">8</x:Double>
    <x:Double x:Key="PortMarkerStripWidth">6</x:Double>

    <!--
      **叠加层模式下的端口标记**（网络标签）：
      · PortMarkerRateFontSize —— 通路速率字号 **10**（比名称小一号 ⇒ 层级清楚，且与名称同排不挤）；
      · 叠加层下标记不做单独降权：标记层排在遮罩之前 ⇒ 被灰玻璃统一压暗，
        连线与角色层保持满强度 —— 形成"通路维度 / 角色维度"的视觉分工。
    -->
    <x:Double x:Key="PortMarkerRateFontSize">10</x:Double>

    <!--
      图标（**显式 SVG**，不是图标字体）
      · 图形文件在 `resources/icons/<拥有者>/`：`icons.json` 是键 → 相对路径的清单，
        `.svg` 是 Fluent UI System Icons（MIT，见同目录 LICENSE）；外部可改，零 NuGet；
      · 界面经 `Icon` / `IconButton` / `Glyph` 按键取图（`ShellIcons` 是键名清单）；
      · 尺寸 / 颜色由 `Controls.axaml` 的 `ui|Glyph.icon`、`ui|IconButton.icon` 等样式统一，
        这里**不再有图标字体族**（`FontIcons` 已随字形字体方案一起删除）。
    -->
</ResourceDictionary>

