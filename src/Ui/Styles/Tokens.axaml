<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      视觉 token（docs/architecture/09-visual-design-baseline.md §2.1）：
      颜色一律以**角色 token** 引用，主题切换只替换 token 值（V2 的可切换与"允许更换背景/色系"由此实现）。
      · 默认主题 = 浅色（C9-2）；深色同样内置且可切换。
      · 色值取自 09 §2.2 草案（C9-3 已采用；Gate C 可微调）。
    -->

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="BgWorkspace" Color="#F3F4F6" />
            <SolidColorBrush x:Key="BgModule" Color="#FFFFFF" />
            <SolidColorBrush x:Key="BgChrome" Color="#FAFAFA" />
            <SolidColorBrush x:Key="BorderDefault" Color="#D4D4D8" />
            <SolidColorBrush x:Key="BorderStrong" Color="#A1A1AA" />
            <SolidColorBrush x:Key="TextPrimary" Color="#18181B" />
            <SolidColorBrush x:Key="TextSecondary" Color="#52525B" />
            <SolidColorBrush x:Key="TextMuted" Color="#A1A1AA" />
            <SolidColorBrush x:Key="AccentPrimary" Color="#2563EB" />
            <SolidColorBrush x:Key="AccentSecondary" Color="#0891B2" />
            <SolidColorBrush x:Key="SemanticOk" Color="#16A34A" />
            <SolidColorBrush x:Key="SemanticWarn" Color="#D97706" />
            <SolidColorBrush x:Key="SemanticError" Color="#DC2626" />
            <SolidColorBrush x:Key="SemanticIdle" Color="#9CA3AF" />
            <SolidColorBrush x:Key="OverlaySelection" Color="#2563EB" Opacity="0.20" />
            <SolidColorBrush x:Key="OverlayHighlight" Color="#2563EB" Opacity="0.12" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="BgWorkspace" Color="#1E1E1E" />
            <SolidColorBrush x:Key="BgModule" Color="#252526" />
            <SolidColorBrush x:Key="BgChrome" Color="#252526" />
            <SolidColorBrush x:Key="BorderDefault" Color="#3F3F46" />
            <SolidColorBrush x:Key="BorderStrong" Color="#52525B" />
            <SolidColorBrush x:Key="TextPrimary" Color="#E6E6E6" />
            <SolidColorBrush x:Key="TextSecondary" Color="#A1A1AA" />
            <SolidColorBrush x:Key="TextMuted" Color="#71717A" />
            <SolidColorBrush x:Key="AccentPrimary" Color="#3B82F6" />
            <SolidColorBrush x:Key="AccentSecondary" Color="#22D3EE" />
            <SolidColorBrush x:Key="SemanticOk" Color="#22C55E" />
            <SolidColorBrush x:Key="SemanticWarn" Color="#F59E0B" />
            <SolidColorBrush x:Key="SemanticError" Color="#EF4444" />
            <SolidColorBrush x:Key="SemanticIdle" Color="#6B7280" />
            <SolidColorBrush x:Key="OverlaySelection" Color="#3B82F6" Opacity="0.20" />
            <SolidColorBrush x:Key="OverlayHighlight" Color="#3B82F6" Opacity="0.12" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <!-- 字体（V4：系统字体 + 数据区等宽；09 §3） -->
    <FontFamily x:Key="FontUi">Segoe UI, Microsoft YaHei UI, sans-serif</FontFamily>
    <FontFamily x:Key="FontData">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

    <!--
      尺寸（09 §5：8 px 模数、圆角 2、边框 1）
      【M1-16 / ADR-0039 D1】**"标题栏 24" 已删除**——模块窗口不再有标题栏/身份行，该 token 无消费者。
      · `ModuleCornerRadius` 的类型必须是 **CornerRadius**（不是 Double）：Border.CornerRadius 取该资源时
        会做强类型转换，写成 `<x:Double>` 会在**运行时**抛 InvalidCastException（2026-09 实测踩过）。
    -->
    <CornerRadius x:Key="ModuleCornerRadius">2</CornerRadius>

    <!--
      尺寸 token【M1-16 / ADR-0039 D1-D3 · ADR-0040 D4】：**改尺寸只改这里**。
      · 控件高度 27：输入类控件与 12 px 字号匹配（用户第六轮反馈"文本框太高"）；
      · 模块窗口：交互带 6 px、缩放手柄 6×6（原 12×12 **缩小 50%**，且仅选中时可命中）；
      · 端口标记（标准件）：宽 20 · 长 114（原 76，**加长 50%**）· 字号 11。
    -->
    <x:Double x:Key="ControlHeight">27</x:Double>
    <x:Double x:Key="ControlFontSize">12</x:Double>
    <x:Double x:Key="ModuleHandleSize">6</x:Double>
    <x:Double x:Key="ModuleBandThickness">6</x:Double>
    <x:Double x:Key="PortMarkerWidth">20</x:Double>
    <x:Double x:Key="PortMarkerLength">114</x:Double>
    <x:Double x:Key="PortMarkerFontSize">11</x:Double>

    <!--
      图标【M1-16 / ADR-0039 D1/D7】：12×12 视框的**填充几何**（`PathIcon` 使用）。
      当前为内置几何（零依赖）；D-8 允许在白名单内引入图标包——引入后**只需替换本组资源键**，视图不动。
    -->
    <StreamGeometry x:Key="IconLock">M2.6,5.2 H9.4 V11 H2.6 Z M4.1,5.2 V3.6 A1.9,1.9 0 0 1 7.9,3.6 V5.2 H6.7 V3.7 A0.7,0.7 0 0 0 5.3,3.7 V5.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconUnlock">M2.6,5.2 H9.4 V11 H2.6 Z M4.1,5.2 V3.6 A1.9,1.9 0 0 0 7.9,3.6 V4.4 H9.1 V3.5 A3.1,3.1 0 0 1 2.9,3.5 V5.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconHide">M6,3 C3.4,3 1.4,4.8 0.8,6 C1.4,7.2 3.4,9 6,9 C8.6,9 10.6,7.2 11.2,6 C10.6,4.8 8.6,3 6,3 Z M6,4.4 A1.6,1.6 0 1 1 6,7.6 A1.6,1.6 0 1 1 6,4.4 Z M1.6,1 L11,10.4 L10.2,11.2 L0.8,1.8 Z</StreamGeometry>
    <StreamGeometry x:Key="IconShow">M6,3 C3.4,3 1.4,4.8 0.8,6 C1.4,7.2 3.4,9 6,9 C8.6,9 10.6,7.2 11.2,6 C10.6,4.8 8.6,3 6,3 Z M6,4.4 A1.6,1.6 0 1 1 6,7.6 A1.6,1.6 0 1 1 6,4.4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPlay">M4,2.8 L9.6,6 L4,9.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconStop">M3.6,3.6 H8.4 V8.4 H3.6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M2.4,3.5 L3.5,2.4 L6,4.9 L8.5,2.4 L9.6,3.5 L7.1,6 L9.6,8.5 L8.5,9.6 L6,7.1 L3.5,9.6 L2.4,8.5 L4.9,6 Z</StreamGeometry>

    <!-- 外壳活动栏图标【M1-16 / ADR-0038 D1】（同样 12×12 视框） -->
    <StreamGeometry x:Key="IconModules">M2,2 H5.4 V5.4 H2 Z M6.6,2 H10 V5.4 H6.6 Z M2,6.6 H5.4 V10 H2 Z M6.6,6.6 H10 V10 H6.6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconInteraction">M2,3 H10 V4.4 H2 Z M4.4,2 H5.8 V5.4 H4.4 Z M2,8.6 H10 V10 H2 Z M6.2,7.6 H7.6 V11 H6.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M6,4.2 A1.8,1.8 0 1 1 6,7.8 A1.8,1.8 0 1 1 6,4.2 Z M5.5,1 H6.5 L6.75,2.6 L8,2.2 L8.6,3.1 L7.6,4.1 L9,4.6 L9,5.6 L7.6,6 L8.6,7 L8.1,7.9 L6.6,7.5 L6.5,9.2 H5.5 L5.25,7.5 L3.9,7.9 L3.4,7 L4.4,6 L3,5.6 L3,4.6 L4.4,4.1 L3.4,3.1 L4,2.2 L5.25,2.6 Z</StreamGeometry>
    <StreamGeometry x:Key="IconTopology">M6,1.6 A1.5,1.5 0 1 1 6,4.6 A1.5,1.5 0 1 1 6,1.6 Z M2.4,7.4 A1.5,1.5 0 1 1 2.4,10.4 A1.5,1.5 0 1 1 2.4,7.4 Z M9.6,7.4 A1.5,1.5 0 1 1 9.6,10.4 A1.5,1.5 0 1 1 9.6,7.4 Z M5.6,4.6 H6.4 V7 H5.6 Z M3.1,7.2 L5.8,5.6 L6.2,6.3 L3.5,7.9 Z M8.9,7.2 L6.2,5.6 L5.8,6.3 L8.5,7.9 Z</StreamGeometry>
    <StreamGeometry x:Key="IconIssue">M6,1 L11.4,10.6 H0.6 Z M5.4,4.4 H6.6 V7.6 H5.4 Z M5.4,8.4 H6.6 V9.6 H5.4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconHelp">M6,1.2 A4.8,4.8 0 1 1 6,10.8 A4.8,4.8 0 1 1 6,1.2 Z M5.3,4.4 A0.9,0.9 0 1 1 6.6,5.2 C6.1,5.6 6,5.9 6,6.6 H5 A1.9,1.9 0 0 1 6,4.3 A1.6,1.6 0 0 1 7.4,5.9 C7.4,6.8 6.9,7.1 6.4,7.4 L6.4,7.8 H5.4 L5.4,6.8 L5.9,6.4 A0.9,0.9 0 0 0 6.3,5.6 A0.6,0.6 0 0 0 5.3,5.1 Z M5.4,8.4 H6.6 V9.6 H5.4 Z</StreamGeometry>
    <StreamGeometry x:Key="IconRefresh">M6,2.2 A3.8,3.8 0 1 1 2.6,5.4 L2.2,4 L5.6,4.4 L4.4,5.2 A2.6,2.6 0 1 0 6,3.4 Z</StreamGeometry>
</ResourceDictionary>
