<Project Sdk="Microsoft.NET.Sdk">

  <!--
    L5 UI 构成（Shell）：主窗口 / 模块区（工作区层）/ 信息类层（连线·标记·诊断）
    依赖：只允许 Sdk + Core.Api（AR-7）；不引用任何模块实现程序集
    视觉取值见 docs/zh/concepts/shell.md
  -->
  <ItemGroup>
    <ProjectReference Include="..\Sdk\HYWDebugAssistant.Sdk.csproj" />
    <ProjectReference Include="..\Sdk.Ui\HYWDebugAssistant.Sdk.Ui.csproj" />
    <ProjectReference Include="..\Core.Api\HYWDebugAssistant.Core.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>

  <ItemGroup>
    <!--
      **色板清单**（`Styles/palette.json`）：色板这支事实的唯一登记处，随程序集出货。
      · 逻辑名**显式写死**：代码按 `PaletteManifest.ResourceName` 读它，不靠"猜资源名的拼法"
        （拼法随根命名空间/目录变化，猜错的表现是运行期读不到；
         `PaletteManifest` 读不到就抛，因为那是构建产物坏了，不是运行时缺配置）；
      · 同一个文件也给 `docs/tools/audit-colors.ps1` 读（它校验清单与两份色板 XAML 一一对应）。
    -->
    <EmbeddedResource Include="Styles\palette.json" LogicalName="HYWDebugAssistant.Ui.Styles.palette.json" />
    <!-- 樱色是出厂种子（resources/seeds/settings/appearance/themes/sakura），不嵌入 Ui 运行时。 -->
  </ItemGroup>

</Project>
