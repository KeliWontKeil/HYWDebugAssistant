<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HYWDebugAssistant.Ui.ViewModels"
        xmlns:ctrl="using:HYWDebugAssistant.Ui.Controls"
        xmlns:views="using:HYWDebugAssistant.Ui.Views"
        x:Class="HYWDebugAssistant.Ui.Views.ModuleWindow"
        x:DataType="vm:ModuleViewViewModel"
        xmlns:design="using:HYWDebugAssistant.Ui.Design"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        d:DataContext="{x:Static design:DesignData.ModuleWindow}"
        d:DesignWidth="320" d:DesignHeight="220"
        Title="模块"
        WindowDecorations="None"
        CanResize="False"
        ShowInTaskbar="False"
        Background="Transparent"
        SizeToContent="Manual"
        Width="320" Height="220">

    <!--
      拼图式模块窗口（ADR-0034 §2 · **M1-16 / ADR-0039 D1-D3 视觉重置**）：
        ① **无标题栏、无身份行**——边框覆盖**整个窗口周界**，整块窗口矩形**即模块矩形**
           （与 `DockRule.MarkerCenter` 的几何基准一致）；**模块名不在窗口上显示**；
        ② 交互带 6 px：边中点/角点 = 缩放（6×6，**仅选中时可命中**），其余 = 拖动；
        ③ 运行指示在**左下角**（状态点 + 状态文本）；
        ④ 按钮簇在**右上角**、**纯图标**（锁定/隐藏/运行/关闭），悬停或选中时淡入；
        ⑤ 内容区点击**不选中**、但会**取消已有选中**（点别处即取消，用户第六轮反馈）。
      层级（自下而上）：内容层 → 交互带/手柄 → **口标记层** → 叠加信息层（B3）→ 按钮簇。

      【尺寸口径 · 本文件不是事实源】**运行期的尺寸与约束全部来自模型**（声明面 `view.json` 的 `frame.window`，
      缺省由 schema 补齐、下限在读取侧已夹到框架地板）：默认尺寸与最小尺寸都由
      `ModuleWindowManager.ApplyGeometry` 按模型施加，本文件**只留设计器兜底**
      （`Width`/`Height`/`d:DesignWidth`/`d:DesignHeight`）。
      **本文件没有 `MinWidth`/`MinHeight`**（2026-10）：它们是框架地板的第二份字面量，且因为
      `CanResize="False"` 对用户**毫无约束作用** —— 真实约束走模型的
      `ModuleViewViewModel.EffectiveMin*` → `Fit`。地板的唯一来源见包声明 schema 的 `window.min*` 缺省值。
      内容排不下时由内容区（`ModuleSurfaceView` 里的滚动视口）滚动，**代码不再按内容计算窗口尺寸**；
      用户在界面上拖过的尺寸会随组合件保存（那是"用户的布局"，不是"代码算的布局"）。
      `d:DataContext` = 设计时样例数据 → **VS 设计器里可直接预览与调整**（见 `Ui/Design/DesignData.cs`）。
    -->
    <!--
      **按钮的指针 / 按下态**：Fluent 的按钮模板从这几个资源键取色，它盖在 `Button.Background` 之上 ——
      应用级资源赢不过 Fluent 的主题字典，**只有挂在这一层（窗口 Resources）才被读到**（见那份文件的说明）。
    -->
<Window.Styles>
        <!-- 按钮簇：悬停或选中时淡入（平时不可见，避免干扰数据阅读） -->
        <Style Selector="Border#Cluster">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Window:pointerover Border#Cluster">
            <Setter Property="Opacity" Value="0.95" />
        </Style>
        <Style Selector="Border#Cluster.selected">
            <Setter Property="Opacity" Value="0.95" />
        </Style>

        <!-- 缩放手柄：6×6；**未选中时不可命中**（否则会压住端口标记 → 双击改标签失效） -->
        <Style Selector="Rectangle.handle">
            <Setter Property="Fill" Value="Transparent" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>
        <Style Selector="Rectangle.handle.visible">
            <Setter Property="Fill" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Opacity" Value="0.85" />
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>
        <!-- 按钮簇自身始终可命中（未选中时按钮隐形但不该让点击穿透到窗口拖动带） -->
        <Style Selector="Border#Cluster Button">
            <Setter Property="IsHitTestVisible" Value="True" />
        </Style>

        <!--
          选中态：**只换边框颜色**。
          **不加粗**：`BorderThickness` 会进布局 ⇒ 选中瞬间窗口内容整体内缩 1px（模块里所有控件跟着跳一下）。
          选中本来就已经有三处表达（边框色、缩放带、按钮簇），不需要再动几何。
        -->
        <Style Selector="Border#Frame.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <!--
          **方向语义色**落在端口标记上【ADR-0044 · 用户第十四轮 D2c】：
          · 标记**边框**按方向着色（发送口 = 发送色、接收口 = 接收色）⇒ 一眼看出这条边上的口是哪种方向；
          · **建网预览描边**（"即将自动建网"）用**同一个方向色**、仅以**线宽 2** 与常态 1px 区分
            （用户 D3b：建网时也在表达"这是接收/发送端"，与"即将建网"提示并不冲突）；
          · 默认值用**接收色**（未加 `.send` 类即接收口），避免再引入一个布尔到画刷的转换器；
            这些属性**不能**再在元素上写内联值（Avalonia 里本地值优先于样式）。
        -->
        <Style Selector="Border.portMarker">
            <Setter Property="BorderBrush" Value="{DynamicResource DirectionReceive}" />
        </Style>
        <Style Selector="Border.portMarker.send">
            <Setter Property="BorderBrush" Value="{DynamicResource DirectionSend}" />
        </Style>

        <!--
          **锚点拖动的指针反馈**（G5 · C5-7）：
          · 光标：可拖动 = `SizeAll`（移动手势的通用光标，与边框带拖动同款）；**已固定 = 默认箭头**
            （光标必须说实话：固定了就拖不动，还给"移动"光标是误导）。
          · **不做悬停放大**（用户 2026-09 裁定："不对网络标签本身进行放大，更改鼠标指针的形态即可
            —— 简洁又能表达含义"）⇒ 悬停反馈只有**光标变化**，标记本身纹丝不动（也就没有了放大压到邻居的问题）。
          · 这些属性**不能**在元素上写内联值（Avalonia 本地值优先于样式）——故模板里的 `Border` 不写 `Cursor`。
        -->
        <Style Selector="Border.portMarker">
            <Setter Property="Cursor" Value="SizeAll" />
        </Style>
        <Style Selector="Border.portMarker.anchorFixed">
            <Setter Property="Cursor" Value="Arrow" />
        </Style>

        <!--
          **「固定 / 解锁」图标按钮**（G5 · C5-7）：平时不可见（同模块按钮簇），**悬停该标记时淡入**。
          `Opacity=0` 仍可命中（与 `Border#Cluster` 同一处理）⇒ 鼠标从标记滑到按钮上能点到，不会"看得见点不着"。
          位置**不在这里**：由 `PortMarkerPanel` 的 `AnchorButton` 层排布（落位规则与标记共用一份算法）。
        -->
        <Style Selector="Button.anchorToggle">
            <Setter Property="Opacity" Value="0" />
            <Setter Property="Padding" Value="0" />
            <!-- 20×20 与预留带同宽；`MinWidth/MinHeight=0` 是**必须的**：按钮主题自带最小高度（实测 27），
                 不压掉就会比槽位高 ⇒ 上下各溢出 ~3.5px ⇒ **压到标记上**（实测踩过） -->
            <Setter Property="Width" Value="20" />
            <Setter Property="Height" Value="20" />
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource BgChrome}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Transitions">
                <Transitions>
                    <DoubleTransition Property="Opacity" Duration="0:0:0.12" />
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.anchorToggle.shown">
            <Setter Property="Opacity" Value="0.95" />
        </Style>
        <!-- 悬停在按钮自己身上时**必须保持可见**（鼠标离开标记滑向按钮的那一刻 `IsMarkerHovered` 已变 false） -->
        <Style Selector="Button.anchorToggle:pointerover">
            <Setter Property="Opacity" Value="0.95" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <!--
          **网络标签（端口标记）在叠加层里的待遇 = 做减法**【ADR-0053 · 用户第三十四轮】：
          用户原话："网络标签不高亮**指的不是在上面覆盖一层**，我的意思是**做减法**，将网络标签也埋入灰色玻璃下方"。
          ⇒ 实现方式是**层级**：`PortMarkers` 排在 `OverlayScrim` **之前**（见下方 Grid 子元素顺序）⇒ 遮罩自然把它压暗；
          ⇒ **不再**给标记加"降权样式"（那是做加法，已被本裁定取代）。
          下方只保留"名称/速率"的字色与字号（两者都**不依赖**叠加层开关）。
        -->
        <Style Selector="TextBlock.markerName">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        </Style>
        <!--
          **通路速率**（**通路维度**）【ADR-0053】：**常驻**在标记上（用户："速率显示常驻于网络标签上，**它不属于叠加层**"），
          字号比名称小一号 ⇒ 层级清楚；未入网/无流量显示占位符（三个短横线）。
        -->
        <Style Selector="TextBlock.markerRate">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="Border.dockHighlight">
            <Setter Property="BorderBrush" Value="{DynamicResource DirectionReceive}" />
        </Style>
        <Style Selector="Border.dockHighlight.send">
            <Setter Property="BorderBrush" Value="{DynamicResource DirectionSend}" />
        </Style>
    </Window.Styles>

    <Border Name="Frame"
            Background="{DynamicResource BgModule}"
            BorderBrush="{DynamicResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="{DynamicResource ModuleCornerRadius}"
            ClipToBounds="True">
        <Grid>

            <!-- 内容（**整块窗口**都是内容区：没有标题栏、没有身份行） -->
            <views:ModuleSurfaceView Name="ModuleArea"
                                     DataContext="{Binding}"
                                     PointerPressed="OnContentPressed" />

            <!-- 交互带（叠在内容之上，只覆盖 6 px 边框；不遮挡内容区事件） -->
            <Grid Name="Band">
                <Rectangle Name="BandTop" Height="6" VerticalAlignment="Top" Margin="6,0,6,0"
                           Fill="Transparent" Cursor="SizeAll" PointerPressed="OnBandPressed" />
                <Rectangle Name="BandBottom" Height="6" VerticalAlignment="Bottom" Margin="6,0,6,0"
                           Fill="Transparent" Cursor="SizeAll" PointerPressed="OnBandPressed" />
                <Rectangle Name="BandLeft" Width="6" HorizontalAlignment="Left" Margin="0,6,0,6"
                           Fill="Transparent" Cursor="SizeAll" PointerPressed="OnBandPressed" />
                <Rectangle Name="BandRight" Width="6" HorizontalAlignment="Right" Margin="0,6,0,6"
                           Fill="Transparent" Cursor="SizeAll" PointerPressed="OnBandPressed" />

                <!-- 角点手柄（6×6） -->
                <Rectangle Name="HandleTopLeft" Classes="handle"
                           Width="{DynamicResource ModuleHandleSize}" Height="{DynamicResource ModuleHandleSize}"
                           HorizontalAlignment="Left" VerticalAlignment="Top" Cursor="TopLeftCorner"
                           PointerPressed="OnHandlePressed" />
                <Rectangle Name="HandleTopRight" Classes="handle"
                           Width="{DynamicResource ModuleHandleSize}" Height="{DynamicResource ModuleHandleSize}"
                           HorizontalAlignment="Right" VerticalAlignment="Top" Cursor="TopRightCorner"
                           PointerPressed="OnHandlePressed" />
                <Rectangle Name="HandleBottomLeft" Classes="handle"
                           Width="{DynamicResource ModuleHandleSize}" Height="{DynamicResource ModuleHandleSize}"
                           HorizontalAlignment="Left" VerticalAlignment="Bottom" Cursor="BottomLeftCorner"
                           PointerPressed="OnHandlePressed" />
                <Rectangle Name="HandleBottomRight" Classes="handle"
                           Width="{DynamicResource ModuleHandleSize}" Height="{DynamicResource ModuleHandleSize}"
                           HorizontalAlignment="Right" VerticalAlignment="Bottom" Cursor="BottomRightCorner"
                           PointerPressed="OnHandlePressed" />

                <!-- 边中点手柄（6×6） -->
                <Rectangle Name="HandleTop" Classes="handle"
                           Width="{DynamicResource ModuleHandleSize}" Height="{DynamicResource ModuleHandleSize}"
                           HorizontalAlignment="Center" VerticalAlignment="Top" Cursor="SizeNorthSouth"
                           PointerPressed="OnHandlePressed" />
                <Rectangle Name="HandleBottom" Classes="handle"
                           Width="{DynamicResource ModuleHandleSize}" Height="{DynamicResource ModuleHandleSize}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Cursor="SizeNorthSouth"
                           PointerPressed="OnHandlePressed" />
                <Rectangle Name="HandleLeft" Classes="handle"
                           Width="{DynamicResource ModuleHandleSize}" Height="{DynamicResource ModuleHandleSize}"
                           HorizontalAlignment="Left" VerticalAlignment="Center" Cursor="SizeWestEast"
                           PointerPressed="OnHandlePressed" />
                <Rectangle Name="HandleRight" Classes="handle"
                           Width="{DynamicResource ModuleHandleSize}" Height="{DynamicResource ModuleHandleSize}"
                           HorizontalAlignment="Right" VerticalAlignment="Center" Cursor="SizeWestEast"
                           PointerPressed="OnHandlePressed" />
            </Grid>

            <!--
              口标记层（**唯一建网入口**）：左边缘 = 接收口、右边缘 = 发送口。
              压在交互带之上 → 双击标记不会被拖动带/缩放手柄抢走。
              **本层自身不设背景**（不参与命中测试）：只有标记块命中，其余位置照常落到下面的交互带。
              **层级（用户第三十四轮裁定：做减法）**：标记在**遮罩之下** ⇒ 叠加层开启时它跟着**沉下去**
              （"网络标签不高亮" = 把它埋进灰色玻璃下方，而不是给它再上一层样式）；
              标记仍在**交互带之上** ⇒ 叠加层开着时**照样双击可改网络名**（遮罩与图形层都不参与命中）。
              叠加层的**连线仍跨过标记**（否则拼接处两个标记会遮掉 40px 连线，连接看起来没有意义）。
            -->
            <ItemsControl Name="PortMarkers"
                          ItemsSource="{Binding Ports}"
                          PointerPressed="OnPortMarkersPressed"
                          DoubleTapped="OnPortMarkersDoubleTapped">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctrl:PortMarkerPanel />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PortMarkerViewModel">
                        <!--
                          网络标签（标准件）：**所有标记占地相同**（左右边缘 20×114 竖排、上下边缘 114×20 横排）。
                          【用户第十三轮反馈重排】内容 = 窄颜色条（数据包类型）+ 网络名 + 方向箭头 + 连接指示灯：
                            · **不再显示数据包类型文本**（标签名通常很长，放不下）→ 类型只在**悬停提示**里给出；
                            · **不再显示"未连"**（没连上时指示灯会灭，文字多余）；
                            · 箭头**放大**（标记字号 11 → 箭头字号 16）；指示灯 **半径 +1（6→8）**、**离端部留 5 px**（"贴到端部"经复验改为留间距）；
                            · **箭头/灯的位置微调规则见各自注释**：竖排分支旋转 −90° ⇒ 内容 y = 屏幕 x（跨轴）、内容 x = 屏幕"向上"；
                            · 窄颜色条 = 数据包类型占位色，**映射待定**（见 `PacketTypePalette` / `PortMarkerViewModel.TypeBrush`）。
                          "即将自动建网"时整块以主色描边高亮（拖动中的预览，松手后由网络行为落地）。
                          槽位宽度固定 ⇒ 文本长度变化不引起排版抖动，名称超出用省略号截断。
                          **色条与指示灯用 `Classes`（`typeStrip`/`markerLamp`）而不是 `Name` 标识**：
                          竖排/横排两套分支在**同一个模板命名域**里，同名会抛
                          "Control with the name 'X' already registered"（2026-09 实测踩过）。
                        -->
                        <!--
                          模板根是 `Panel`（**不是标记 Border**）：为了容纳**浮在标记之外**的「固定 / 解锁」图标按钮。
                          尺寸仍等于标记：按钮用**负外边距**摆到标记外面 ⇒ 它对 `Panel` 的 `DesiredSize` 贡献为
                          `20 + (−22) < 0`，故 `Panel` 量出来的仍是标记的 20×114 —— `PortMarkerPanel` 按
                          `child.DesiredSize` 定位标记，**这里一变标记就会错位**（故不能给按钮独立占位）。
                        -->
                        <Panel Classes="portMarkerHost"
                               PointerEntered="OnMarkerPointerEntered"
                               PointerExited="OnMarkerPointerExited">
                        <Border Classes="portMarker"
                                Classes.send="{Binding IsSend}"
                                Classes.anchorFixed="{Binding IsAnchorFixed}"
                                Width="{Binding MarkerWidth}"
                                Height="{Binding MarkerHeight}"
                                Background="{DynamicResource BgChrome}"
                                BorderThickness="1"
                                CornerRadius="0"
                                ToolTip.Tip="{Binding Tooltip}">
                            <Grid>
                                <!-- 即将建网：**同一方向色**的 2px 描边（覆盖在标记之上，不改变布局） -->
                                <Border Classes="dockHighlight"
                                        Classes.send="{Binding IsSend}"
                                        IsVisible="{Binding IsDockCandidate}"
                                        BorderThickness="2"
                                        CornerRadius="0" />

                                <!-- 竖排（左右边缘）：整块内容旋转 −90°；**槽位固定**（名称吃掉剩余宽度） -->
                                <LayoutTransformControl IsVisible="{Binding IsVertical}">
                                    <LayoutTransformControl.LayoutTransform>
                                        <RotateTransform Angle="-90" />
                                    </LayoutTransformControl.LayoutTransform>
                                    <!--
                                      槽位**固定**（内容变化不引起排版抖动）：
                                        色条(Auto=6) | **网络名(Auto，名称优先)** | **通路速率(*，可被裁)** | 箭头(20) | 指示灯(Auto=8)
                                        | **「固定」徽标(恒占 13)**。
                                      【2026-09 用户裁定 · 名称优先】此前名称列是 `*`、速率列是 `Auto`
                                      ⇒ 速率（`0.00 KB/s` ≈54px）先把宽度吃光，名称只剩约 10px，
                                      「（直连）」必然被截（用户："一半的文字被后面的速率遮住了"）。
                                      现在反过来：**名称拿自己需要的宽度**（上限 = 标记长度 − 固定槽位，
                                      见 `PortMarkerViewModel.NameMaxWidth`），**速率吃剩下的、不够就省略**。
                                      **槽位顺序 = 读数顺序**：内容整体旋转 −90°（把 (x,y) 映射为 (y,−x)）后，
                                      内容 x 小的一端落到屏幕**下方**（文字自下而上读），故"色条在最前、灯在最末"
                                      在屏幕上表现为 **灯在上端（贴端部）、色条在下端** —— 与用户草图的读数顺序一致。
                                      徽标排在**最末**（屏幕最上端的端部外侧）⇒ 不与任何既有槽位重叠。
                                    -->
                                    <Grid ColumnDefinitions="Auto,Auto,*,20,Auto">
                                        <!-- ① 窄颜色条：数据包类型（颜色映射待定 → Colors/PacketTypePalette） -->
                                        <Border Classes="typeStrip"
                                                Grid.Column="0"
                                                Width="{DynamicResource PortMarkerStripWidth}"
                                                Background="{Binding TypeBrush}"
                                                Margin="0" />

                                        <!-- ② 网络名：**名称优先**（拿自己需要的宽度，上限见 NameMaxWidth），超长省略 -->
                                        <TextBlock Grid.Column="1"
                                                   Classes="markerName"
                                                   Margin="4,0,2,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource PortMarkerFontSize}"
                                                   FontFamily="{DynamicResource FontData}"
                                                   MaxWidth="{Binding NameMaxWidth}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding NetworkText}" />

                                        <!--
                                          ②b **通路速率**（**通路维度** · **常驻**）【ADR-0053 · 用户第三十四轮】：
                                          用户："**网络标签上缺少速率显示，这才是'数据通路速率'**" + "速率显示**常驻**于网络标签上，
                                          **它不属于叠加层**" ⇒ **始终显示**（不随叠加层开关）；比名称小一号、次要色；
                                          未入网/无流量显示占位符。
                                          【2026-09 名称优先】它吃**剩余**宽度（`*`）⇒ 名字长时先省略的是它。
                                          【2026-09 用户实测】**右对齐**：左侧对齐时空档留在速率**左边**，
                                          看起来"速率占了名称的位置、箭头被挤到边上"（用户："箭头贴边，看起来不在中间；
                                          速率显示建议靠近箭头"）⇒ 右对齐后空档落到「名称—速率」之间，**速率贴住箭头**。
                                        -->
                                        <TextBlock Grid.Column="2"
                                                   Classes="markerRate"
                                                   Margin="6,0,4,0"
                                                   HorizontalAlignment="Right"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource PortMarkerRateFontSize}"
                                                   FontFamily="{DynamicResource FontData}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Text="{Binding RateText}" />

                                        <!--
                                          ③ 方向箭头：**颜色 = 方向语义色**（`DirectionSend` 发送 / `DirectionReceive` 接收；
                                             可在 **设置 → 外观 → 发送色/接收色** 里改，ADR-0044）。
                                          **位置微调**（字形墨迹在行盒里天然偏下，故需用 Margin 拉回中线）：
                                             · 屏幕位移 = (**上边距 − 下边距**) ÷ 2（居中定位下是减半的）；
                                             · 本支旋转 −90° ⇒ **内容 y 增大 = 屏幕向右**，故 上/下 边距控制**屏幕左右**；
                                             · 当前 `0,0,0,2` ⇒ (0 − 2) ÷ 2 = −1 ⇒ 屏幕**向左 1px**；还差 1px 就把 2 改成 4（再左 1px）或 0（回中 1px）。
                                        -->
                                        <TextBlock Grid.Column="3"
                                                   Classes="markerArrow"
                                                   Margin="0,0,0,4"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource PortMarkerArrowFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DirectionSend}"
                                                   IsVisible="{Binding IsSend}"
                                                   Text="{Binding Arrow}" />
                                        <TextBlock Grid.Column="3"
                                                   Classes="markerArrow"
                                                   Margin="0,0,0,4"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"
                                                   FontSize="{DynamicResource PortMarkerArrowFontSize}"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource DirectionReceive}"
                                                   IsVisible="{Binding !IsSend}"
                                                   Text="{Binding Arrow}" />

                                        <!--
                                          ④ 连接指示灯：**离标记端部留 5px**（原来是 0 = 贴到边上，复验反馈"过于靠边"）。
                                          调间距 = 改下面 `Margin` 的**第 3 个数**（内容坐标右边距，右对齐 ⇒ 1:1）：
                                          本支旋转 −90° ⇒ **内容"右" = 屏幕"下"**，故 5 = 屏幕上端往下 5px；写 0 = 又贴到边上。
                                          跨轴居中由 `VerticalAlignment="Center"` 保证（内容 y = 屏幕 x），无需额外边距。
                                        -->
                                        <ctrl:StateIndicator Classes="markerLamp"
                                                             Grid.Column="4"
                                                             Width="{DynamicResource PortMarkerLampSize}"
                                                             Height="{DynamicResource PortMarkerLampSize}"
                                                             Margin="4,0,5,0"
                                                             HorizontalAlignment="Right"
                                                             VerticalAlignment="Center"
                                                             State="{Binding State}"
                                                             OkBrush="{DynamicResource SemanticOk}"
                                                             IdleBrush="{DynamicResource SemanticIdle}"
                                                             WarnBrush="{DynamicResource SemanticWarn}"
                                                             ErrorBrush="{DynamicResource SemanticError}" />
                                    </Grid>
                                </LayoutTransformControl>

                                <!-- 横排（上下边缘）：正常方向；同样槽位（**名称优先**，见竖排分支的同一说明） -->
                                <Grid ColumnDefinitions="Auto,Auto,*,20,Auto"
                                      IsVisible="{Binding !IsVertical}">
                                    <Border Classes="typeStrip"
                                            Grid.Column="0"
                                            Width="{DynamicResource PortMarkerStripWidth}"
                                            Background="{Binding TypeBrush}"
                                            Margin="0" />

                                    <TextBlock Grid.Column="1"
                                               Classes="markerName"
                                               Margin="4,0,2,0"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource PortMarkerFontSize}"
                                               FontFamily="{DynamicResource FontData}"
                                               MaxWidth="{Binding NameMaxWidth}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding NetworkText}" />

                                    <!-- ②b 通路速率（**常驻**；名称优先 ⇒ 它吃剩余宽度；**右对齐贴箭头**，见竖排分支的说明） -->
                                    <TextBlock Grid.Column="2"
                                               Classes="markerRate"
                                               Margin="6,0,4,0"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource PortMarkerRateFontSize}"
                                               FontFamily="{DynamicResource FontData}"
                                               TextTrimming="CharacterEllipsis"
                                               Text="{Binding RateText}" />

                                    <!--
                                      ③ 方向箭头：**颜色 = 方向语义色**（`DirectionSend` / `DirectionReceive`，ADR-0044）。
                                      **位置微调**：屏幕位移 = (**上边距 − 下边距**) ÷ 2；
                                      本支**无旋转** ⇒ 内容 y 增大 = **屏幕向下**，故 上/下 边距控制**屏幕上下**；
                                      当前 `0,0,0,2` = 屏幕**向上 1px**（把字形墨迹拉回中线）。
                                    -->
                                    <TextBlock Grid.Column="3"
                                               Classes="markerArrow"
                                               Margin="0,0,0,2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource PortMarkerArrowFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DirectionSend}"
                                               IsVisible="{Binding IsSend}"
                                               Text="{Binding Arrow}" />
                                    <TextBlock Grid.Column="3"
                                               Classes="markerArrow"
                                               Margin="0,0,0,2"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="{DynamicResource PortMarkerArrowFontSize}"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource DirectionReceive}"
                                               IsVisible="{Binding !IsSend}"
                                               Text="{Binding Arrow}" />

                                    <!--
                                      ④ 连接指示灯：**离标记端部留 5px**（原为 0 = 贴边）。
                                      调间距 = 改 `Margin` 的**第 3 个数**（右对齐 ⇒ 1:1，本支无旋转 ⇒ 直接就是"离右端 5px"）。
                                    -->
                                    <ctrl:StateIndicator Classes="markerLamp"
                                                         Grid.Column="4"
                                                         Width="{DynamicResource PortMarkerLampSize}"
                                                         Height="{DynamicResource PortMarkerLampSize}"
                                                         Margin="4,0,5,0"
                                                         HorizontalAlignment="Right"
                                                         VerticalAlignment="Center"
                                                         State="{Binding State}"
                                                         OkBrush="{DynamicResource SemanticOk}"
                                                         IdleBrush="{DynamicResource SemanticIdle}"
                                                         WarnBrush="{DynamicResource SemanticWarn}"
                                                         ErrorBrush="{DynamicResource SemanticError}" />
                                </Grid>

                                <!--
                                  编辑输入框：**弹出**（不进标记内部）。
                                  【用户第十三轮反馈】① 弹窗**过宽**（原 268）→ **收窄到 188**（只放标题 + 输入框 + 按钮）；
                                  ② 原**行内提示文本**（多句）拿走 → 改为标题右侧 **`?` 帮助按钮 + Flyout**，
                                  与主界面各页同一做法（`Button.helpIcon`：**不占版面、点外部关闭**）。
                                -->
                                <Popup IsOpen="{Binding IsEditing, Mode=TwoWay}"
                                       PlacementTarget="{Binding $parent[Border]}"
                                       Placement="Pointer"
                                       HorizontalOffset="8"
                                       VerticalOffset="8">
                                    <Border Background="{DynamicResource BgModule}"
                                            BorderBrush="{DynamicResource AccentPrimary}"
                                            BorderThickness="1"
                                            CornerRadius="3"
                                            Padding="8"
                                            Width="188">
                                        <StackPanel Spacing="4">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           VerticalAlignment="Center"
                                                           FontSize="11"
                                                           TextTrimming="CharacterEllipsis"
                                                           Foreground="{DynamicResource TextPrimary}"
                                                           Text="{Binding PortName, StringFormat='设置网络名：{0}'}" />
                                                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="建网规则">
                                                    <Button.Flyout>
                                                        <Flyout Placement="TopEdgeAlignedRight">
                                                            <TextBlock MaxWidth="300"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11"
                                                                       Text="{Binding Hint}" />
                                                        </Flyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                            <TextBox FontFamily="{DynamicResource FontData}"
                                                     PlaceholderText="网络名（留空 = 清除）"
                                                     Text="{Binding EditText, Mode=TwoWay}"
                                                     KeyDown="OnPortLabelKeyDown"
                                                     AttachedToVisualTree="OnLabelEditorAttached" />
                                            <TextBlock FontSize="10"
                                                       TextWrapping="Wrap"
                                                       IsVisible="{Binding HasEditError}"
                                                       Foreground="{DynamicResource SemanticError}"
                                                       Text="{Binding EditError}" />
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <Button Content="确定" Padding="8,0" Click="OnPortLabelCommit" />
                                                <Button Content="清除" Padding="8,0" Click="OnPortLabelClear" />
                                                <Button Content="取消" Padding="8,0" Click="OnPortLabelCancel" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        </Panel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
              **「固定 / 解锁」按钮层**（G5 · C5-7）——与标记**同一条边、同一列预留带**，但落在**标记长度之外**
              （用户 2026-09 裁定："实际落在了内侧遮挡 UI，而不是边框留白处" ⇒ 必须落在带内的空白段）。
              **为什么单开一层而不是塞进标记模板**：位置只能由**面板**算（模板不知道标记被夹到哪、两端还剩多少），
              塞进模板就只剩"相对标记的固定偏移"一条路 —— 那必然压住内容或压住标记。
              两层**共用 `PortMarkerPanel` 的同一份定位算法**（`Layer` 属性切排布分支 ⇒ 规则仍只有一处实现）。
              层级：排在遮罩**之前** ⇒ 与标记一起"沉下去"（ADR-0053 的"做减法"）；遮罩不参与命中 ⇒ 按钮始终可点。
            -->
            <ItemsControl Name="PortAnchors"
                          ItemsSource="{Binding Ports}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <ctrl:PortMarkerPanel Layer="AnchorButton" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:PortMarkerViewModel">
                        <!--
                          显隐：**悬停该标记时淡入**（`IsMarkerHovered` 由标记模板的 `PointerEntered/Exited` 置位）；
                          悬停按钮自身时也保持可见 ⇒ 鼠标从标记滑到按钮上不会闪掉。
                          图标表达**状态**（未固定 = 开锁 / 已固定 = 锁），动作写在悬停提示里（同模块右上角锁定按钮）。
                        -->
                        <Button Classes="anchorToggle"
                                Classes.shown="{Binding IsMarkerHovered}"
                                ToolTip.Tip="{Binding AnchorToggleTip}"
                                Click="OnToggleAnchorFixed">
                            <!-- 两态用两块字形（`Button` 是内容控件、只能有一个子元素 ⇒ 用 `Panel` 叠放） -->
                            <Panel>
                                <TextBlock Classes="icon"
                                           Text="{DynamicResource GlyphUnlock}"
                                           IsVisible="{Binding !IsAnchorFixed}" />
                                <TextBlock Classes="icon"
                                           Text="{DynamicResource GlyphLock}"
                                           IsVisible="{Binding IsAnchorFixed}" />
                            </Panel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--
              **叠加信息层：遮罩（"灰玻璃"）**【ADR-0045 立 · **层级由 ADR-0053 修订**】。
              最简实现 = 一层半透明深色 + 其上的浅色信息（同"弹窗时主窗口变暗"的常见做法；不做背景模糊）。
              目的（用户原话）："压暗模块自身内容，以突出叠加层的信息，减少凌乱程度"。
              · 浓度 = `OverlayScrim` token（改这里就改观感）；**不进设置项**（用户裁决 D2：无需可调）；
              · `IsHitTestVisible=False` ⇒ 双击改网络名、拖动、缩放照常（命中穿透到下面的端口标记）；
              · **层级（用户第三十四轮："做减法"）**：遮罩**在端口标记之上**（标记随之沉下去，不再"高亮"——
                用户原话："网络标签不高亮**指的不是在上面覆盖一层**……我的意思是**做减法**，将网络标签也埋入灰色玻璃下方"），
                但在**叠加层图形之下**（角色方块与连线保持明亮）⇒ 视觉上"接口层沉下去、角色层浮上来"。
                ⇒ 端口标记**不再需要任何降权样式**（给它加样式是在做加法，已被本裁定取代）。
            -->
            <Border Name="OverlayScrim"
                    IsVisible="{Binding ShowInfoOverlay}"
                    Background="{DynamicResource OverlayScrim}"
                    IsHitTestVisible="False" />

            <!--
              **叠加信息层：图形与信息**【ADR-0039 D5 → ADR-0045 → ADR-0049 → **ADR-0052/0053**】：
              **角色功能块**（= 模块声明的功能分块）+ **角色间数据线** + **角色自身的信息文字** + 模块内部顺序线。
              · 方块：**单列居中、宽度随文本自适应** · 填充 = 类型色（按类型**身份**）· 左/右接口边 = 接收/发送方向色；
              · 角色信息：**方块上方的纯文字**（速率 / 投递·丢弃 / 类型语义），**不画文本框**；
              · 对外线：端点 = **两个角色方块中心**，各窗自裁 + 裁掉方块内部；颜色渐变到"中点色"（两窗公共边颜色相接）；
                虚线**沿数据流方向**流动（发送向外、接收向内）；**线上不写任何文字**；
              · 内部线（`RoleOrder` = 模块声明的处理顺序）：**细实线 + 中性色 + 不流动** —— 它是**结构**，不是流量；
              · **必须压在端口标记与遮罩之上**（用户第十七轮 + 第三十四轮）：标记是不透明块（20px 宽），连线若在其下，
                两个模块拼接处会被**两个标记遮住 40px**，整条连接看起来"从标签连到中心"、失去意义。
              · **`Margin="-1"` 抵消 `Frame` 的 1px 边框**：让叠加层的画布**正好等于窗口客户区**
                （否则 `Bounds` 比窗口小 2 DIP ⇒ 与"对端算出的本窗方块位置"不一致 ⇒ 连线错位；
                顺带让连线**画到窗口真正的外沿**，两窗拼接处的两段能严丝合缝相接）。
              · **单位**：`CanvasWidth/CanvasHeight` 由视图模型给出**DIP**（模型几何是物理像素，只在那两处换算）。
            -->
            <ctrl:ConnectionOverlay Name="Overlay"
                                    Roles="{Binding Roles}"
                                    RoleLinks="{Binding RoleLinks}"
                                    RoleOrder="{Binding RoleOrder}"
                                    IdentityText="{Binding OverlayInfo.Identity}"
                                    NoticeText="{Binding OverlayInfo.Notice}"
                                    IsVisible="{Binding ShowInfoOverlay}"
                                    InstanceId="{Binding InstanceId}"
                                    ModuleTitle="{Binding Title}"
                                    CanvasWidth="{Binding CanvasWidth}"
                                    CanvasHeight="{Binding CanvasHeight}"
                                    Margin="-1"
                                    SendArrowBrush="{DynamicResource DirectionSend}"
                                    ReceiveArrowBrush="{DynamicResource DirectionReceive}"
                                    FlowLineBrush="{DynamicResource OverlayFlow}"
                                    InkBrush="{DynamicResource OverlayInk}"
                                    InkMutedBrush="{DynamicResource OverlayInkMuted}"
                                    DataFontFamily="{DynamicResource FontData}"
                                    IsHitTestVisible="False" />

            <!--
              **拖动时的对齐标线**：拖到与别的窗口/外壳**边或中线对齐**时，在这一层画出来。
              数值由视图模型算（`SnapEngine`），本层只负责画 —— 所以它必须**在所有内容之上**
              （压在遮罩、角色方块、连线之上），且**不参与命中**（命中要落到端口标记与标题栏上）。
            -->
            <ctrl:GuideOverlay Guides="{Binding Guides}"
                               ResizeEdges="{Binding ResizeEdges}"
                               LineBrush="{DynamicResource AccentPrimary}"
                               IsHitTestVisible="False" />

            <!-- 运行指示：**左下角**（状态点 + 状态文本；模块名不显示） -->
            <StackPanel HorizontalAlignment="Left"
                        VerticalAlignment="Bottom"
                        Orientation="Horizontal"
                        Spacing="4"
                        Margin="6,0,0,5"
                        IsHitTestVisible="False">
                <ctrl:StateIndicator Width="7" Height="7"
                                     VerticalAlignment="Center"
                                     State="{Binding State}"
                                     OkBrush="{DynamicResource SemanticOk}"
                                     IdleBrush="{DynamicResource SemanticIdle}"
                                     WarnBrush="{DynamicResource SemanticWarn}"
                                     ErrorBrush="{DynamicResource SemanticError}" />
                <TextBlock FontSize="10"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource TextMuted}"
                           Text="{Binding StateText}" />
            </StackPanel>

            <!-- 按钮簇：**右上角 · 纯图标**（锁定/解锁 · 隐藏 · 运行/停用 · 关闭） -->
            <Border Name="Cluster"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,5,5,0"
                    Padding="2"
                    CornerRadius="3"
                    Background="{DynamicResource BgChrome}"
                    BorderBrush="{DynamicResource BorderDefault}"
                    BorderThickness="1">
                <StackPanel Orientation="Horizontal" Spacing="1">
                    <Button Name="ResetButton" Classes="icon" Click="OnReset"
                            ToolTip.Tip="还原：默认尺寸，或尺寸与配置一起还原（会先确认）">
                        <TextBlock Classes="icon" Text="{DynamicResource GlyphReset}" />
                    </Button>
                    <Button Name="LockButton" Classes="icon" Click="OnToggleLock"
                            ToolTip.Tip="锁定后不可拖动、缩放与选中（仍显示数据）">
                        <TextBlock Name="LockIcon" Classes="icon" Text="{DynamicResource GlyphLock}" />
                    </Button>
                    <Button Name="HideButton" Classes="icon" Click="OnHide"
                            ToolTip.Tip="隐藏窗口（模块继续运行；恢复入口：交互页 → 显示全部）">
                        <TextBlock Classes="icon" Text="{DynamicResource GlyphHide}" />
                    </Button>
                    <Button Name="CloseButton" Classes="icon" Click="OnClose"
                            ToolTip.Tip="关闭窗口 = 移除该模块实例">
                        <TextBlock Classes="icon" Text="{DynamicResource GlyphClose}" />
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
