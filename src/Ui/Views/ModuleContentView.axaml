<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.Ui.ViewModels"
             xmlns:ctrl="using:HYWDebugAssistant.Ui.Controls"
             xmlns:views="using:HYWDebugAssistant.Ui.Views"
             x:Class="HYWDebugAssistant.Ui.Views.ModuleContentView"
             x:DataType="vm:ModuleViewViewModel"
             xmlns:design="using:HYWDebugAssistant.Ui.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{x:Static design:DesignData.ModuleWindow}"
             d:DesignWidth="320" d:DesignHeight="200"
             Background="Transparent">

    <UserControl.Styles>
        <!--
          【G1 · 2026-09】C2 标签页的**选中态**：下边框 + 前景用主题强调色。
          未选中保持常规按钮外观（做减法：只靠一处对比表达"哪一页是当前页"，不加底色不加图标）。
        -->
        <Style Selector="Button.tabStripItem">
            <Setter Property="MinHeight" Value="24" />
            <Setter Property="Padding" Value="10,2" />
            <Setter Property="FontSize" Value="11" />
        </Style>
        <Style Selector="Button.tabStripItem.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="BorderThickness" Value="0,0,0,2" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <!--
          【G3 · 2026-09】输入元素的**处理失败态**：模块回报"这次没处理好" ⇒ 边框标红（`SemanticError`）。
          做法是"改边框颜色 + 加粗到 2px"（做减法：不叠背景色、不加图标、不弹提示）—— 用户草图的原文是"边框显著标红"。
        -->
        <Style Selector="TextBox.invalid">
            <Setter Property="BorderBrush" Value="{DynamicResource SemanticError}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </UserControl.Styles>

    <!--
      模块窗口的**内容层**：按声明渲染的元素 + 窗内虚线参考线。

      【修订 · 缺陷修复】身份行与口标记层已上移到 `ModuleWindow`：
        · 口标记是**窗口级覆盖层**（边缘预留带内的标准件），必须压在 6 px 拖动带与缩放手柄**之上**——
          此前标记在内容层、交互带在其上，导致双击标记中部被 `HandleLeft/HandleRight`（同为边缘垂直居中）
          吃掉 → 标签编辑"点了没反应"；
        · 身份行（模块名 + 状态点）同步上移，使**标记层与内容层同处一行**：
          标记几何（= `DockRule.MarkerCenter` 使用的模块矩形）保持不变。
    -->
    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,20,20,20">
            <ItemsControl ItemsSource="{Binding Elements}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ViewElementViewModel">
                        <ContentControl Content="{Binding}">
                            <ContentControl.DataTemplates>

                                <!-- A1 数值：等宽 + 单位（值不随窗口拉伸） -->
                                <DataTemplate DataType="vm:ValueElementViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1,0,1">
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Text="{Binding Title}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock VerticalAlignment="Center"
                                                       FontFamily="{DynamicResource FontData}"
                                                       FontSize="12"
                                                       Foreground="{DynamicResource TextPrimary}"
                                                       Text="{Binding Display}" />
                                            <TextBlock Margin="3,0,0,0"
                                                       VerticalAlignment="Center"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding Unit}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>

                                <!-- A3 曲线：自量程折线（**随窗口拉伸**的展示元素） -->
                                <DataTemplate DataType="vm:CurveElementViewModel">
                                    <Border Margin="0,2,0,2"
                                            Height="64"
                                            Background="{DynamicResource BgWorkspace}"
                                            BorderBrush="{DynamicResource BorderDefault}"
                                            BorderThickness="1"
                                            CornerRadius="2">
                                        <ctrl:CurveControl Margin="1"
                                                           Points="{Binding Points}"
                                                           Min="{Binding Min}"
                                                           Max="{Binding Max}"
                                                           Stroke="{DynamicResource AccentSecondary}" />
                                    </Border>
                                </DataTemplate>

                                <!-- A5 文本日志：等宽 + 自动滚到最新（**随窗口拉伸**） -->
                                <DataTemplate DataType="vm:TextLogElementViewModel">
                                    <views:TextLogView DataContext="{Binding}" />
                                </DataTemplate>

                                <!-- B1 配置表单：按配置 Schema 自动生成（控件固定尺寸，不随窗口拉伸） -->
                                <DataTemplate DataType="vm:ConfigurationEditorElementViewModel">
                                    <views:ConfigurationFormView DataContext="{Binding}" />
                                </DataTemplate>

                                <!--
                                  【M1-16 / ADR-0040】人机操作三通道：
                                    · B5 文本输入：**回车 / 失焦**一次提交（不逐字符写入），带"未提交"提示与就地错误；
                                    · B2 命令按钮：点击即投递到模块线程执行；
                                    · A10 开关：拨动即提交 true/false。
                                -->
                                <DataTemplate DataType="vm:TextInputElementViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Text="{Binding Title}" />
                                        <!--
                                          【G2 · 2026-09】多行输入（`ViewElement.Multiline`）：`AcceptsReturn` + 最小高度。
                                          **提交键不在 XAML 里定** —— 由代码后置按视图模型的档位判定
                                          （`SubmitOnEnter` / `SubmitOnCtrlEnter` / `SubmitOnLostFocus`），档位来自**应用级设置**。
                                          **不设 `TextWrapping`（不折行）是特性**（用户 2026-09 裁决）：画面上的换行 ⟺ 文本里
                                          真的有一个换行符 ⇒ 「所见即所发」，长行横向滚动。详见 `02`「多行输入框不自动折行是特性」。
                                        -->
                                        <TextBox Grid.Column="1"
                                                 FontFamily="{DynamicResource FontData}"
                                                 Text="{Binding Text, Mode=TwoWay}"
                                                 AcceptsReturn="{Binding IsMultiline}"
                                                 MinHeight="{Binding EditorMinHeight}"
                                                 Classes.invalid="{Binding IsInvalid}"
                                                 KeyDown="OnInputKeyDown"
                                                 LostFocus="OnInputLostFocus" />
                                        <TextBlock Grid.Column="2"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="{Binding LastResult}" />
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="vm:CommandElementViewModel">
                                    <Grid ColumnDefinitions="Auto,Auto,*" Margin="0,2">
                                        <Button Grid.Column="0"
                                                Padding="10,0"
                                                Content="{Binding Command.Title}"
                                                Command="{Binding InvokeCommand}"
                                                ToolTip.Tip="{Binding Tooltip}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   IsVisible="{Binding HasError}"
                                                   Foreground="{DynamicResource SemanticError}"
                                                   Text="{Binding LastResult}" />
                                    </Grid>
                                </DataTemplate>

                                <DataTemplate DataType="vm:ToggleElementViewModel">
                                    <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                        <CheckBox Grid.Column="0"
                                                  Content="{Binding Title}"
                                                  IsChecked="{Binding IsOn, Mode=TwoWay}" />
                                        <TextBlock Grid.Column="1"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SemanticError}"
                                                   Text="{Binding LastResult}" />
                                    </Grid>
                                </DataTemplate>

                                <!--
                                  【G1 · 2026-09】C2 标签页：**标签条**（本模板）+ **当前页的子元素**
                                  （由视图模型展开，与其他容器"展平"同一约定 ⇒ 无需嵌套模板）。
                                  切页 = 纯 UI 状态（不进组合件）；见 `TabStripElementViewModel` 的 remarks。
                                -->
                                <DataTemplate DataType="vm:TabStripElementViewModel">
                                    <ItemsControl ItemsSource="{Binding Pages}" Margin="0,2,0,4">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="vm:TabPageItemViewModel">
                                                <Button Classes="tabStripItem"
                                                        Margin="0,0,4,0"
                                                        Content="{Binding Title}"
                                                        Command="{Binding SelectCommand}"
                                                        Classes.selected="{Binding IsSelected}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </DataTemplate>

                                <!--
                                  【G4 · 2026-09】B6 文件选择器：标签 + 只读路径框 + 「浏览」按钮。
                                  弹系统文件对话框在**代码后置**（`OnBrowseClick`）——它需要 `StorageProvider`（UI 概念）；
                                  选/存的路径经既有输入通道提交给模块（`FileSelectorElementViewModel.Submit`）。
                                -->
                                <DataTemplate DataType="vm:FileSelectorElementViewModel">
                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0"
                                                   VerticalAlignment="Center"
                                                   Margin="0,0,6,0"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Text="{Binding Title}" />
                                        <TextBox Grid.Column="1"
                                                 FontFamily="{DynamicResource FontData}"
                                                 Text="{Binding SelectedPath}"
                                                 IsReadOnly="True" />
                                        <Button Grid.Column="2"
                                                Margin="6,0,0,0"
                                                Padding="8,0"
                                                Content="浏览…"
                                                Click="OnBrowseClick" />
                                        <TextBlock Grid.Column="3"
                                                   Margin="6,0,0,0"
                                                   VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource SemanticError}"
                                                   Text="{Binding LastResult}" />
                                    </Grid>
                                </DataTemplate>

                                <!-- 其余元素：明确标注"未渲染"，不假装支持 -->
                                <DataTemplate DataType="vm:UnsupportedElementViewModel">
                                    <TextBlock Margin="0,1,0,1"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}"
                                               Text="{Binding Notice}" />
                                </DataTemplate>

                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- 窗内叠加层：虚线对齐参考线 + 缩放边缘高亮（坐标换算由控件内部按客户区原点 + 缩放完成） -->
        <ctrl:GuideOverlay Guides="{Binding Guides}"
                           ResizeEdges="{Binding ResizeEdges}"
                           LineBrush="{DynamicResource AccentPrimary}"
                           IsHitTestVisible="False" />
    </Grid>
</UserControl>
