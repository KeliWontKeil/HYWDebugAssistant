<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.Ui.ViewModels"
             x:Class="HYWDebugAssistant.Ui.Views.ConfigurationFormView"
             x:DataType="vm:ConfigurationEditorElementViewModel">

    <!--
      B1 配置表单：**按配置 Schema 自动生成**（Q5-5 / 11 §4.2）。
      界面不出现代码化标识（无类型全名、无 JSON）：字段标题由模块标注或字段名生成。
      写回经模块的写回通道（一次 ChangeSet、原子应用或整体拒绝）。
    -->
    <Border Margin="0,3,0,1"
            Padding="6,4"
            Background="{DynamicResource BgChrome}"
            BorderBrush="{DynamicResource BorderDefault}"
            BorderThickness="1"
            CornerRadius="2">
        <StackPanel Spacing="2">

            <TextBlock FontSize="10"
                       Foreground="{DynamicResource TextMuted}"
                       Text="{Binding Title}" />

            <TextBlock FontSize="10"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       IsVisible="{Binding Notice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Text="{Binding Notice}" />

            <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:ConfigurationFieldViewModel">
                        <Grid ColumnDefinitions="86,*,Auto" Margin="0,1">
                            <TextBlock Grid.Column="0"
                                       VerticalAlignment="Center"
                                       FontSize="11"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{Binding Title}"
                                       ToolTip.Tip="{Binding Description}" />

                            <!-- 布尔：开关（固定尺寸；不随窗口拉伸 —— 用户反馈"控件不应随模块大小变化"） -->
                            <CheckBox Grid.Column="1"
                                      HorizontalAlignment="Left"
                                      IsVisible="{Binding IsBoolean}"
                                      IsChecked="{Binding IsChecked, Mode=TwoWay}" />

                            <!-- 枚举：下拉（固定宽度） -->
                            <ComboBox Grid.Column="1"
                                      Width="150"
                                      HorizontalAlignment="Left"
                                      FontSize="11"
                                      IsVisible="{Binding IsEnum}"
                                      ItemsSource="{Binding Choices}"
                                      SelectedItem="{Binding SelectedChoice, Mode=TwoWay}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Title}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>

                            <!-- 数值/文本：文本输入（固定宽度；数值解析在写回时按类型进行） -->
                            <TextBox Grid.Column="1"
                                     Width="150"
                                     HorizontalAlignment="Left"
                                     FontSize="11"
                                     FontFamily="{DynamicResource FontData}"
                                     IsVisible="{Binding IsText}"
                                     Text="{Binding Value, Mode=TwoWay}" />

                            <TextBlock Grid.Column="2"
                                       Margin="4,0,0,0"
                                       VerticalAlignment="Center"
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="{Binding RangeHint}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Orientation="Horizontal" Spacing="4" Margin="0,3,0,0">
                <Button Content="应用" FontSize="11" Padding="8,2" Command="{Binding ApplyCommand}" />
                <Button Content="还原" FontSize="11" Padding="8,2" Command="{Binding RevertCommand}" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="10"
                           TextWrapping="Wrap"
                           MaxWidth="150"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextMuted}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
