<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
        x:Class="HYWDebugAssistant.Ui.Views.ResetModuleDialog"
        Title="{loc:Tr reset.title}"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        MinWidth="360"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgModule}"
        FontSize="12">

    <!--
      **还原确认弹窗**【用户第十一轮反馈】：三选一 —— 只还原尺寸 / 尺寸与配置都还原 / 取消。
      · 用普通窗口（带标题栏）而不是无边框窗：确认框需要明确的关闭与"取消"语义；
      · 文案与按钮从左到右按"影响从小到大"排列，取消在最后（Windows 习惯）。
    -->
    <!-- 按钮的指针 / 按下态：必须挂在窗口 Resources 上才被 Fluent 的按钮模板读到（见该文件说明） -->
<StackPanel Margin="14" Spacing="10">
        <TextBlock x:Name="Message"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource TextPrimary}"
                   Text="{loc:Tr reset.message}" />

        <TextBlock FontSize="11" TextWrapping="Wrap" Foreground="{DynamicResource TextMuted}"
                   Text="{loc:Tr reset.note}" />

        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Content="{loc:Tr reset.sizeOnly}" Click="OnSizeOnly" />
            <Button Content="{loc:Tr reset.sizeAndConfiguration}" Click="OnSizeAndConfiguration" />
            <Button Content="{loc:Tr reset.cancel}" Click="OnCancel" />
        </StackPanel>
    </StackPanel>
</Window>
