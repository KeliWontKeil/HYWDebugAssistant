<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
             xmlns:ui="using:HYWDebugAssistant.Ui.ViewModels"
             xmlns:views="using:HYWDebugAssistant.Ui.Views"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             x:Class="HYWDebugAssistant.FrameworkUi.Views.ModuleCatalogView"
             x:DataType="vm:ModuleCatalogViewModel"
             xmlns:design="using:HYWDebugAssistant.FrameworkUi.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{x:Static design:ShellDesignData.Catalog}"
             d:DesignWidth="420" d:DesignHeight="760"
             FontSize="12">

    <!--
      模块清单页（B 区常驻）——【用户第十轮反馈后重排 · 参照用户手工绘制的布局示意】
        上 → 下：① 搜索框 ② **横向分类标签**（固定宽度，切换不移动排版）
                 ③ **模块列表（占满中间，固定区域 + 内部滚动）**
                 ④ 目录操作行（添加目录… / 删除选中 / 重新加载）
                 ⑤ **来源根列表（固定高度 + 内部滚动；每行尾部一个小按钮「打开」）** + 行尾省略
                 ⑥ 从目录加载模块包（显式放在外面，不藏进帮助）
        规则：**区域尺寸固定**（列表不随模块数量/分类变化改变大小）；边界用边框显式表达；
              帮助 = **页面顶行右侧的小问号按钮 + 弹窗文本**（页面级帮助不放列表框里）。
    -->
    <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="8" RowSpacing="4">

        <!-- ① 搜索（**页面级**帮助放在页面顶行、列表框外：它不是某个控件的帮助） -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="4">
            <TextBox Grid.Column="0" PlaceholderText="{loc:Tr catalog.search.placeholder}" Text="{Binding SearchText, Mode=TwoWay}" />
            <Button Grid.Column="1" Classes="helpIcon" VerticalAlignment="Center"
                    ToolTip.Tip="{loc:Tr catalog.help.tip}">
                <Button.Flyout>
                    <Flyout Placement="BottomEdgeAlignedRight">
                        <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                   Text="{loc:Tr catalog.help.body}" />
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <!-- ② 横向分类标签（**固定宽度** 64：切换分类不会移动其它控件） -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Categories}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="vm:ModuleCategoryViewModel">
                    <Button Classes="tab" Width="64" Command="{Binding $parent[ItemsControl].((vm:ModuleCatalogViewModel)DataContext).SelectCategoryCommand}"
                            CommandParameter="{Binding}"
                            Classes.active="{Binding IsSelected}"
                            ToolTip.Tip="{Binding Title}">
                        <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                            <TextBlock Classes="icon" FontSize="13" Text="{Binding Glyph}" />
                            <TextBlock FontSize="10" VerticalAlignment="Center" Text="{Binding Count}" />
                        </StackPanel>
                    </Button>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- ③ 模块列表：**固定区域**（占满中间行；内部滚动）——不随数量/分类改变大小；窗口过矮时保留最小高度 -->
        <Border Grid.Row="2" Classes="pane" Padding="4" MinHeight="120">
            <Grid RowDefinitions="Auto,*,Auto">
                <TextBlock Grid.Row="0" Classes="paneTitle" Margin="2,0,0,2" Text="{loc:Tr catalog.title}" />
                <ListBox Grid.Row="1"
                         Background="Transparent"
                         BorderThickness="0"
                         ItemsSource="{Binding Catalog}"
                         DoubleTapped="OnCatalogDoubleTapped"
                         SelectedItem="{Binding SelectedCatalogEntry, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:ModuleCatalogRowViewModel">
                            <!-- 整行命中：条目根给透明背景，空白处也能出提示 -->
                            <Grid ColumnDefinitions="72,*" Margin="0,2" Background="Transparent"
                                  ToolTip.Tip="{Binding TooltipText}">
                                <Border Grid.Column="0" Classes="previewTile">
                                    <Grid>
                                        <Border Background="{Binding PreviewBrush}" />
                                        <TextBlock Classes="icon previewGlyph"
                                                   FontSize="18"
                                                   IsVisible="{Binding !HasPreview}"
                                                   Text="{DynamicResource GlyphModules}" />
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="8,0,0,0" Spacing="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DisplayName}"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock Text="{Binding OriginNotice}"
                                               FontSize="10"
                                               TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextMuted}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- 区域底行：左「加入现场」（页面级帮助在页面顶行，不在框内） -->
                <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="2,4,0,0">
                    <Button HorizontalAlignment="Left"
                            Content="{loc:Tr catalog.add}"
                            Command="{Binding AddCommand}"
                            ToolTip.Tip="{loc:Tr catalog.add.tip}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ④ 操作行：外部导入、重扫、完整重载 -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="4" HorizontalAlignment="Left">
            <Button Content="{loc:Tr catalog.import}" Command="{Binding ImportModulesCommand}"
                    ToolTip.Tip="{loc:Tr catalog.import.tip}" />
            <Button Content="{loc:Tr catalog.rescan}" Command="{Binding RescanCommand}"
                    ToolTip.Tip="{loc:Tr catalog.rescan.tip}" />
            <Button Content="{loc:Tr catalog.reload}" Command="{Binding ReloadCommand}"
                    ToolTip.Tip="{loc:Tr catalog.reload.tip}" />
        </StackPanel>

        <!-- ⑤ 提示 + 状态：固定行，间距紧凑；详情进 ToolTip/Issue -->
        <StackPanel Grid.Row="4" Spacing="2">
            <TextBlock Classes="operationHint"
                       ToolTip.Tip="{Binding RestartHint}"
                       Text="{Binding RestartHint}" />
            <TextBlock Classes="operationStatus"
                       Classes.error="{Binding StatusIsError}"
                       ToolTip.Tip="{Binding StatusDetail}"
                       Text="{Binding StatusMessage}" />
        </StackPanel>
    </Grid>
</UserControl>
