<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
             xmlns:ui="using:HYWDebugAssistant.Ui.Controls"
             xmlns:uvm="using:HYWDebugAssistant.Ui.ViewModels"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             x:Class="HYWDebugAssistant.FrameworkUi.Views.InteractionView"
             x:DataType="vm:ShellViewModel"
             xmlns:design="using:HYWDebugAssistant.FrameworkUi.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{x:Static design:ShellDesignData.Shell}"
             d:DesignWidth="420" d:DesignHeight="760">

    <!--
      交互页（B 区常驻）——【用户第十轮反馈后重排】
        · 每个分区：左标题、**右侧小问号**（同一 X 对齐）；
        · 帮助一律**弹窗**（Flyout，点外部关闭）——**不在页面里展开文本、不改变布局**；
        · 用统一的间距做紧凑排版（具体值见容器属性）。
    -->
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="6">

            <!-- 分区：显示 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="{loc:Tr interaction.section.display}" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="{loc:Tr interaction.help.display.tip}">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="{loc:Tr interaction.help.display.body}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ui:UiToggle Content="{loc:Tr interaction.overlay}" IsChecked="{Binding ShowInfoOverlay, Mode=TwoWay}" />

            <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

            <!-- 分区：交互 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="{loc:Tr interaction.section.snap}" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="{loc:Tr interaction.help.snap.tip}">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="{loc:Tr interaction.help.snap.body}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <ui:UiToggle Content="{loc:Tr interaction.snap}" IsChecked="{Binding SnapEnabled, Mode=TwoWay}" />

            <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

            <!-- 分区：窗口管理（全局操作 + 模块行操作共用同一套命令与状态） -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="{loc:Tr interaction.section.window}" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="{loc:Tr interaction.help.window.tip}">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="{loc:Tr interaction.help.window.body}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                       Text="{Binding Windows.OverviewSummary}" />

            <ui:UiToggle Content="{loc:Tr interaction.topmost}"
                         IsChecked="{Binding AppTopmost, Mode=TwoWay}" />

            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="{Binding AllLockedActionText}"
                        Command="{Binding ToggleAllLockedCommand}"
                        ToolTip.Tip="{loc:Tr interaction.lockAll.tip}" />
                <Button Content="{loc:Tr interaction.raiseAll}" Command="{Binding RaiseAllWindowsCommand}" />
                <Button Content="{loc:Tr interaction.showAll}" Command="{Binding ShowAllWindowsCommand}" />
            </StackPanel>

            <Border Classes="pane" Padding="4" Height="180" MinHeight="120">
                <Grid RowDefinitions="Auto,*">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="2,0,0,2">
                        <TextBlock Grid.Column="0" Classes="paneTitle" Text="{loc:Tr interaction.modules.title}" />
                        <TextBlock Grid.Column="1" FontSize="10" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextMuted}"
                                   Text="{Binding Windows.ModuleCount}" />
                    </Grid>
                    <ScrollViewer Grid.Row="1">
                        <Grid>
                            <ItemsControl ItemsSource="{Binding Windows.Overview}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="uvm:ModuleOverviewRowViewModel">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,1"
                                          ToolTip.Tip="{Binding StatusText}">
                                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6"
                                                    VerticalAlignment="Center">
                                            <TextBlock FontSize="11" MaxWidth="150"
                                                       TextTrimming="CharacterEllipsis"
                                                       Text="{Binding Title}" />
                                            <TextBlock FontSize="10" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextMuted}"
                                                       Text="{Binding StatusText}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="1"
                                                    VerticalAlignment="Center">
                                            <ui:IconButton Classes="icon" Width="20" Height="20" MinHeight="20"
                                                           Icon="{x:Static ui:ShellIcons.Hide}"
                                                           ToolTip.Tip="{loc:Tr interaction.modules.show}"
                                                           Command="{Binding ShowCommand}"
                                                           IsVisible="{Binding !IsViewVisible}" />
                                            <ui:IconButton Classes="icon" Width="20" Height="20" MinHeight="20"
                                                           Icon="{x:Static ui:ShellIcons.Hide}"
                                                           ToolTip.Tip="{loc:Tr interaction.modules.hide}"
                                                           Command="{Binding HideCommand}"
                                                           IsVisible="{Binding IsViewVisible}" />
                                            <ui:IconButton Classes="icon" Width="20" Height="20" MinHeight="20"
                                                           Icon="{x:Static ui:ShellIcons.Lock}"
                                                           ToolTip.Tip="{loc:Tr interaction.modules.lock}"
                                                           Command="{Binding ToggleLockCommand}"
                                                           IsVisible="{Binding !IsLocked}" />
                                            <ui:IconButton Classes="icon" Width="20" Height="20" MinHeight="20"
                                                           Icon="{x:Static ui:ShellIcons.Unlock}"
                                                           ToolTip.Tip="{loc:Tr interaction.modules.unlock}"
                                                           Command="{Binding ToggleLockCommand}"
                                                           IsVisible="{Binding IsLocked}" />
                                            <Button MinHeight="20" Height="20" Padding="4,0" FontSize="10"
                                                    Content="{loc:Tr interaction.modules.recall}"
                                                    Command="{Binding RecallCommand}"
                                                    IsVisible="{Binding IsOffScreen}"
                                                    ToolTip.Tip="{loc:Tr interaction.modules.recall.tip}" />
                                            <ui:IconButton Classes="icon" Width="20" Height="20" MinHeight="20"
                                                           Icon="{x:Static ui:ShellIcons.Raise}"
                                                           ToolTip.Tip="{loc:Tr interaction.modules.raise}"
                                                           Command="{Binding RaiseCommand}" />
                                            <ui:IconButton Classes="icon" Width="20" Height="20" MinHeight="20"
                                                           Icon="{x:Static ui:ShellIcons.Close}"
                                                           ToolTip.Tip="{loc:Tr interaction.modules.close}"
                                                           Command="{Binding CloseCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextMuted}"
                                       Text="{loc:Tr interaction.modules.empty}"
                                       IsVisible="{Binding Windows.OverviewIsEmpty}" />
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

            <!-- 分区：快捷键 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="{loc:Tr interaction.section.hotkeys}" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="{loc:Tr interaction.help.hotkeys.tip}">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="{loc:Tr hotkey.help.scope}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <!-- **当前生效的绑定**（含用户改过的）；不写死，随设置刷新 -->
            <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"
                       Text="{Binding HotkeyHelpText}" />

            <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

            <!--
              分区：**数据结构 · 颜色映射表**【ADR-0054 · 用户第三十四轮："添加数据结构-颜色映射表……放在右侧边栏的'交互'下"】
                · 一行 = 一种**数据类型标识**；颜色是**唯一色彩来源**：端口标记的窄色条与
                  叠加层角色方块的填充都取自它 ⇒ 改一处，两处同步；
                · 点色块 = 取色弹窗（与设置页"主题色"同一套预设 + 十六进制）；"自动" = **稳定哈希配色**
                  （同一身份跨模块/跨重启同色，不配置也能分辨类型）；
                · 只呈现：改色不参与建网/兼容/判定，也不进组合件。
            -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="{loc:Tr interaction.section.dataTypeColors}" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="{loc:Tr interaction.help.dataTypeColors.tip}">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="{loc:Tr interaction.help.dataTypeColors.body}" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock IsVisible="{Binding DataTypeColors.IsEmpty}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMuted}"
                       Text="{Binding DataTypeColors.EmptyText}" />

            <ItemsControl ItemsSource="{Binding DataTypeColors.Rows}" IsVisible="{Binding !DataTypeColors.IsEmpty}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DataTypeColorRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                            <!-- 色块：点开**调色板窗口**（可任选颜色 / 恢复自动色）【ADR-0054】 -->
                            <Button Grid.Column="0" Padding="0" Width="26" Height="20" MinHeight="20"
                                    Click="OnPickDataTypeColor"
                                    ToolTip.Tip="{loc:Tr interaction.colorPick.tip}">
                                <Border Width="22" Height="16" CornerRadius="3"
                                        Background="{Binding Brush}"
                                        BorderBrush="{DynamicResource BorderStrong}"
                                        BorderThickness="1" />
                            </Button>

                            <!-- 类型身份（等宽）+ 形状与用量（次要、超长省略） -->
                            <StackPanel Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource FontData}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding TypeKey}"
                                           Text="{Binding TypeKey}" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ShapeText}"
                                           Text="{Binding ShapeText}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"
                                       ToolTip.Tip="{Binding UsageText}"
                                       Text="{Binding UsageText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
