<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
             x:Class="HYWDebugAssistant.FrameworkUi.Views.InteractionView"
             x:DataType="vm:ShellViewModel"
             xmlns:design="using:HYWDebugAssistant.FrameworkUi.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{x:Static design:ShellDesignData.Shell}"
             d:DesignWidth="420" d:DesignHeight="760">

    <!--
      交互页（B 区常驻）——【用户第十轮反馈后重排】
        · 每个分区：左标题、**右侧小问号**（同一 X 对齐）；
        · 帮助一律**弹窗**（Flyout，点外部关闭）——**不在页面里展开文本、不改变布局**；
        · 行距 6、内边距 8，紧凑。
    -->
    <ScrollViewer>
        <StackPanel Margin="8" Spacing="6">

            <!-- 分区：显示 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="显示" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="显示相关说明">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="「叠加信息层」在模块窗口内绘制连接线与数据流向；端口标记（网络标签）始终显示——双击标记即可填网络名建网。" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <CheckBox Content="叠加信息层" IsChecked="{Binding ShowInfoOverlay, Mode=TwoWay}" />

            <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

            <!-- 分区：交互 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="交互" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="吸附说明">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="吸附参照 = 其他模块窗口 + 外壳右边缘（拼图向右展开）；拖动中按住 Alt 可临时停用。建网请用端口标签，或让两个模块「接触且标记对齐」自动连上。" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <CheckBox Content="几何吸附" IsChecked="{Binding SnapEnabled, Mode=TwoWay}" />

            <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

            <!-- 分区：窗口 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="窗口" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="窗口与层级说明">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="应用内层级：弹窗 &gt; 模块窗口 &gt; 外壳；相对其他应用只有两种统一状态（普通 / 全体置顶），不提供单窗口置顶。「全部锁定」后模块不可拖动/缩放/选中但仍刷新数据。" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <CheckBox Content="全部锁定" IsChecked="{Binding AllLocked, Mode=TwoWay}" />
            <CheckBox Content="应用置顶" IsChecked="{Binding AppTopmost, Mode=TwoWay}" />
            <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="全部置前" Command="{Binding RaiseAllWindowsCommand}" />
                <Button Content="显示全部" Command="{Binding ShowAllWindowsCommand}" />
            </StackPanel>

            <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

            <!-- 分区：快捷键 -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="快捷键" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="默认快捷键">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="M 模块清单 · I Issue · S 设置 · T 拓扑诊断 · L 叠加信息层 · G 吸附 · Ctrl+L 全部锁定。作用域 = 应用内（任一本应用窗口聚焦即生效）；可在「设置 → 快捷键」里修改。" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>
            <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}" Text="M / I / S / T / L / G / Ctrl+L" />

            <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

            <!--
              分区：**数据结构 · 颜色映射表**【ADR-0054 · 用户第三十四轮："添加数据结构-颜色映射表……放在右侧边栏的'交互'下"】
                · 一行 = 一种**数据类型身份**（`标识@v版本`）；颜色是**唯一色彩来源**：端口标记的窄色条与
                  叠加层角色方块的填充都取自它 ⇒ 改一处，两处同步；
                · 点色块 = 取色弹窗（与设置页"主题色"同一套预设 + 十六进制）；"自动" = **稳定哈希配色**
                  （同一身份跨模块/跨重启同色，不配置也能分辨类型）；
                · 只呈现：改色不参与建网/兼容/判定，也不进组合件。
            -->
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="paneTitle" VerticalAlignment="Center" Text="数据结构 · 颜色" />
                <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="颜色映射说明">
                    <Button.Flyout>
                        <Flyout Placement="TopEdgeAlignedRight">
                            <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                       Text="颜色按**数据类型身份**（标识@版本）映射，因此同一类型在所有窗口里同色（不同标识即使形状相同也分开配色）。点色块可自定义；「自动」= 按身份哈希出的稳定色（重启后不变）。改色只影响呈现，不参与建网与判定。" />
                        </Flyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <TextBlock IsVisible="{Binding DataTypeColors.IsEmpty}"
                       FontSize="10"
                       Foreground="{DynamicResource TextMuted}"
                       Text="{Binding DataTypeColors.EmptyText}" />

            <ItemsControl ItemsSource="{Binding DataTypeColors.Rows}" IsVisible="{Binding !DataTypeColors.IsEmpty}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:DataTypeColorRowViewModel">
                        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,1">
                            <!-- 色块：点开**调色板窗口**（可任选颜色 / 恢复自动色）【ADR-0054】 -->
                            <Button Grid.Column="0" Padding="0" Width="26" Height="20" MinHeight="20"
                                    Click="OnPickDataTypeColor"
                                    ToolTip.Tip="更改该数据类型的颜色（调色板窗口）">
                                <Border Width="22" Height="16" CornerRadius="3"
                                        Background="{Binding Brush}"
                                        BorderBrush="{DynamicResource BorderStrong}"
                                        BorderThickness="1" />
                            </Button>

                            <!-- 类型身份（等宽）+ 形状与用量（次要、超长省略） -->
                            <StackPanel Grid.Column="1" Margin="6,0,4,0" VerticalAlignment="Center">
                                <TextBlock FontFamily="{DynamicResource FontData}" FontSize="11"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding TypeKey}"
                                           Text="{Binding TypeKey}" />
                                <TextBlock FontSize="10" Foreground="{DynamicResource TextMuted}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip.Tip="{Binding ShapeText}"
                                           Text="{Binding ShapeText}" />
                            </StackPanel>

                            <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="10"
                                       Foreground="{DynamicResource TextMuted}"
                                       ToolTip.Tip="{Binding UsageText}"
                                       Text="{Binding UsageText}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
