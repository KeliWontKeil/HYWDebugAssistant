<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
        xmlns:views="using:HYWDebugAssistant.FrameworkUi.Views"
        xmlns:ui="using:HYWDebugAssistant.Ui.ViewModels"
        x:Class="HYWDebugAssistant.FrameworkUi.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="何译位调试助手"
        FontSize="12"
        Width="{Binding ShellWidth}"
        Height="{Binding ShellHeight}"
        MinWidth="360" MinHeight="360"
        CanResize="{Binding ShellResizable}"
        WindowStartupLocation="Manual">

    <!--
      框架外壳【M1-16 / ADR-0038 D1】**VSCode 式侧边栏**：
        · A 区**活动栏**（左，44 px）：图标化入口（模块清单 / 交互 / 设置 / 拓扑诊断 / Issue / 帮助）；
          选中态 = 主色滑块（左侧 2 px 竖条 + 浅色底）——即"可变色滑块"；
        · B 区**侧边界面**（右）：**模块清单**与**交互**为**常驻竖向页面**；设置 / 拓扑 / Issue / 帮助为**弹窗**；
        · 底部状态栏（Issue 计数可点）；
        · **顶部菜单已撤销**（全部动作进活动栏或侧边页面 —— D1 裁决）。
      外壳**仍是拼图起始点**：模块窗口从属于它（层级规则见 ADR-0036 D5），且**其右边缘是模块唯一的吸附参照**（D-2）。
    -->
    <Window.Styles>
        <!-- 活动栏按钮：默认低调；选中（active）时主色滑块 + 浅底 -->
        <Style Selector="Button.rail">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.rail:pointerover">
            <Setter Property="Background" Value="{DynamicResource OverlayHighlight}" />
        </Style>
        <Style Selector="Button.rail.active">
            <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
        </Style>
        <Style Selector="Button.rail.active PathIcon">
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <!-- 活动栏选中滑块的左侧竖条 -->
        <Style Selector="Rectangle.railMark">
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Rectangle.railMark.active">
            <Setter Property="Fill" Value="{DynamicResource AccentPrimary}" />
        </Style>
    </Window.Styles>

    <Grid ColumnDefinitions="44,*" RowDefinitions="*,Auto">

        <!-- ==================== A 区：活动栏 ==================== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Background="{DynamicResource BgChrome}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,0,1,0">
            <StackPanel Orientation="Vertical" Spacing="2" Margin="2,6">
                <Button Classes="rail" Classes.active="{Binding IsCatalogPage}"
                        Command="{Binding ShowPageCommand}" CommandParameter="catalog"
                        ToolTip.Tip="模块清单（侧边页面）">
                    <Panel>
                        <PathIcon Data="{DynamicResource IconModules}" Width="14" Height="14" />
                        <Rectangle Classes="railMark" Classes.active="{Binding IsCatalogPage}"
                                   Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
                    </Panel>
                </Button>

                <Button Classes="rail" Classes.active="{Binding IsInteractionPage}"
                        Command="{Binding ShowPageCommand}" CommandParameter="interaction"
                        ToolTip.Tip="交互（显示 / 吸附 / 窗口）">
                    <Panel>
                        <PathIcon Data="{DynamicResource IconInteraction}" Width="14" Height="14" />
                        <Rectangle Classes="railMark" Classes.active="{Binding IsInteractionPage}"
                                   Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch" />
                    </Panel>
                </Button>

                <Rectangle Height="1" Margin="6,4" Fill="{DynamicResource BorderDefault}" />

                <Button Classes="rail" Click="OnOpenTopology" ToolTip.Tip="拓扑诊断（弹窗）">
                    <PathIcon Data="{DynamicResource IconTopology}" Width="14" Height="14" />
                </Button>

                <Button Classes="rail" Click="OnOpenIssues" ToolTip.Tip="Issue（弹窗）">
                    <Panel>
                        <PathIcon Data="{DynamicResource IconIssue}" Width="14" Height="14" />
                        <Border IsVisible="{Binding HasErrors}"
                                Background="{DynamicResource SemanticError}"
                                CornerRadius="6"
                                MinWidth="12" Height="12"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,2,2,0">
                            <TextBlock FontSize="8"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Text="{Binding ErrorIssueCount}" />
                        </Border>
                    </Panel>
                </Button>

                <Button Classes="rail" Click="OnOpenSettings" ToolTip.Tip="设置（弹窗）">
                    <PathIcon Data="{DynamicResource IconSettings}" Width="14" Height="14" />
                </Button>

                <Button Classes="rail" Click="OnShowAbout" ToolTip.Tip="帮助与关于（弹窗）">
                    <PathIcon Data="{DynamicResource IconHelp}" Width="14" Height="14" />
                </Button>
            </StackPanel>
        </Border>

        <!-- ==================== B 区：侧边界面 ==================== -->
        <!-- 用 Panel 包一层：可见性绑到**外壳视图模型**，而视图自身的 DataContext 另行指定 -->
        <Panel Grid.Row="0" Grid.Column="1" IsVisible="{Binding IsCatalogPage}">
            <views:ModuleCatalogView DataContext="{Binding Catalog}" />
        </Panel>

        <Panel Grid.Row="0" Grid.Column="1" IsVisible="{Binding IsInteractionPage}">
            <views:InteractionView DataContext="{Binding}" />
        </Panel>

        <!-- ==================== 状态栏 ==================== -->
        <Border Grid.Row="1" Grid.Column="1"
                Background="{DynamicResource BgChrome}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="8,0">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{Binding StatusText}" />
                <Button Grid.Column="1"
                        FontSize="11"
                        Padding="6,0"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnOpenIssues"
                        Content="{Binding IssueCount, StringFormat='Issue {0}'}" />
            </Grid>
        </Border>
    </Grid>
</Window>
