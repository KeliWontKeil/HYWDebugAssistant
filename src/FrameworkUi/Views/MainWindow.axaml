<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
        xmlns:views="using:HYWDebugAssistant.FrameworkUi.Views"
        xmlns:ui="using:HYWDebugAssistant.Ui.ViewModels"
        xmlns:uc="using:HYWDebugAssistant.Ui.Controls"
        xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
        x:Class="HYWDebugAssistant.FrameworkUi.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        xmlns:design="using:HYWDebugAssistant.FrameworkUi.Design"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        d:DataContext="{x:Static design:ShellDesignData.Shell}"
        d:DesignWidth="420" d:DesignHeight="880"
        Title="{loc:Tr shell.window.title}"
        FontSize="12"
        Width="396" Height="858"
        MinWidth="360" MinHeight="360"
        ClosingBehavior="OwnerWindowOnly"
        WindowStartupLocation="Manual">

    <!--
      框架外壳【M1-16 / ADR-0038 D1】**VSCode 式侧边栏**：
        · A 区**活动栏**（左侧窄条）：图标化入口（模块清单 / 交互 / 拓扑诊断 / Issue / 设置 / 帮助）；
        · B 区**侧边界面**（右）：**模块清单**与**交互**为**常驻竖向页面**；设置 / 拓扑 / Issue / 帮助为**弹窗**；
        · 底部状态栏（Issue 计数可点）；**顶部菜单已撤销**。
      外壳**仍是拼图起始点**：模块窗口从属于它（ADR-0036 D5），且**其右边缘是模块唯一的吸附参照**（ADR-0038 D5）。

      【尺寸默认值就在本文件】`Width` / `Height` 取默认比例：
      设置里的「主窗口比例 / 尺寸固定」只在**用户显式改过**时覆盖（见 `MainWindow.axaml.cs` 的 `ApplyShellSizeFromSettings`），
      不再由代码"算"尺寸。`d:DataContext` 提供设计时样例 → **VS 设计器里可直接预览与调整**。

      【选中标记与图标不重合】按钮内容分两列：滑块独占**最左列**、图标在剩余区域**居中**
      （此前滑块与图标叠在同一个 Panel 里）；
      图标改用**显式 SVG**（`uc:Glyph`：键 → `resources/icons/HYWDebugAssistant.Ui/` 下的 `.svg`，
      经 `Sdk.Ui.Controls.Icon` 画出来），不再手绘几何、也不依赖图标字体。
    -->
    <Window.Styles>
        <!-- 活动栏按钮：默认低调；选中（active）时浅底 + 主色图标 -->
        <Style Selector="Button.rail">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="36" />
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.rail:pointerover">
            <Setter Property="Background" Value="{DynamicResource OverlayHighlight}" />
        </Style>
        <!-- 按下态与普通按钮同一档：活动栏是**导航**（不盒装），但按下要立刻有反馈 -->
        <Style Selector="Button.rail:pressed">
            <Setter Property="Background" Value="{DynamicResource SurfaceButtonFacePressedBrush}" />
        </Style>
        <Style Selector="Button.rail.active">
            <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
        </Style>

        <!-- 选中滑块：最左一条竖条（与图标分列，故不会重合） -->
        <Style Selector="Rectangle.railMark">
            <Setter Property="Fill" Value="Transparent" />
        </Style>
        <Style Selector="Rectangle.railMark.active">
            <Setter Property="Fill" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <!--
          状态栏**临时提示**（2026-09）：常态用次要色，错误提示用语义错误色。
          用两道样式而不是给每处写死颜色 ⇒ "提示是什么色"只有一处定义。
        -->
        <Style Selector="TextBlock.notice">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>
        <Style Selector="TextBlock.notice.error">
            <Setter Property="Foreground" Value="{DynamicResource SemanticError}" />
        </Style>

        <!-- Issue 角标：只显示错误级 Issue；警告/信息只在 Issue 面板里记录 -->
        <Style Selector="Border.issueBadge">
            <Setter Property="Background" Value="{DynamicResource SemanticError}" />
        </Style>
    </Window.Styles>

    <!-- 按钮的指针 / 按下态：必须挂在窗口 Resources 上才被 Fluent 的按钮模板读到（见该文件说明） -->
<Grid ColumnDefinitions="44,*" RowDefinitions="*,Auto">
        <!--
          **主窗口壁纸**：属于当前主题（浅色/深色默认无，樱色与自定义主题可带）。
          壁纸画刷在 ShellViewModel 里按主题解析并居中裁切；上面叠一层主题色 veil，
          浓度由当前主题方案的「壁纸遮罩浓度」控制。两层都不参与命中。
        -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{Binding ThemeWallpaperBrush}"
                IsHitTestVisible="False" />
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Grid.ColumnSpan="2"
                Background="{DynamicResource WallpaperVeil}"
                Opacity="{Binding WallpaperVeilOpacity}"
                IsVisible="{Binding HasThemeWallpaper}"
                IsHitTestVisible="False" />

        <!-- ==================== A 区：活动栏 ==================== -->
        <Border Grid.Row="0" Grid.RowSpan="2" Grid.Column="0"
                Background="{DynamicResource BgChrome}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,0,1,0">
            <Grid RowDefinitions="*,Auto">
                <StackPanel Name="RailButtons" Grid.Row="0"
                            Orientation="Vertical" Spacing="2" Margin="2,6"
                            VerticalAlignment="Top">
                    <Button Classes="rail" Classes.active="{Binding IsCatalogPage}"
                            Command="{Binding ShowPageCommand}" CommandParameter="catalog"
                            ToolTip.Tip="{loc:Tr shell.rail.catalog.tip}">
                        <Grid ColumnDefinitions="3,*">
                            <Rectangle Grid.Column="0" Classes="railMark" Classes.active="{Binding IsCatalogPage}" />
                            <uc:Glyph Grid.Column="1" Classes="icon" Icon="{x:Static uc:ShellIcons.Modules}" />
                        </Grid>
                    </Button>

                    <Button Classes="rail" Classes.active="{Binding IsCompositePage}"
                            Command="{Binding ShowPageCommand}" CommandParameter="composite"
                            ToolTip.Tip="{loc:Tr shell.rail.composite.tip}">
                        <Grid ColumnDefinitions="3,*">
                            <Rectangle Grid.Column="0" Classes="railMark" Classes.active="{Binding IsCompositePage}" />
                            <uc:Glyph Grid.Column="1" Classes="icon" Icon="{x:Static uc:ShellIcons.Composite}" />
                        </Grid>
                    </Button>

                    <Button Classes="rail" Classes.active="{Binding IsInteractionPage}"
                            Command="{Binding ShowPageCommand}" CommandParameter="interaction"
                            ToolTip.Tip="{loc:Tr shell.rail.interaction.tip}">
                        <Grid ColumnDefinitions="3,*">
                            <Rectangle Grid.Column="0" Classes="railMark" Classes.active="{Binding IsInteractionPage}" />
                            <uc:Glyph Grid.Column="1" Classes="icon" Icon="{x:Static uc:ShellIcons.Interaction}" />
                        </Grid>
                    </Button>

                    <Rectangle Height="1" Margin="6,4" Fill="{DynamicResource BorderDefault}" />

                    <Button Classes="rail" Click="OnOpenTopology" ToolTip.Tip="{loc:Tr shell.rail.topology.tip}">
                        <uc:Glyph Classes="icon" Icon="{x:Static uc:ShellIcons.Topology}" />
                    </Button>

                    <Button Classes="rail" Click="OnOpenIssues" ToolTip.Tip="{Binding IssueBadgeToolTip}">
                        <Grid ColumnDefinitions="3,*">
                            <uc:Glyph Grid.Column="1" Classes="icon" Icon="{x:Static uc:ShellIcons.Issue}" />
                            <Border Grid.Column="1"
                                    Classes="issueBadge"
                                    IsVisible="{Binding HasErrors}"
                                    CornerRadius="7"
                                    MinWidth="14" Height="14"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,3,3,0">
                                <TextBlock FontSize="9"
                                           Foreground="White"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Text="{Binding ErrorIssueCount}" />
                            </Border>
                        </Grid>
                    </Button>

                    <Button Classes="rail" Click="OnOpenSettings" ToolTip.Tip="{loc:Tr shell.rail.settings.tip}">
                        <uc:Glyph Classes="icon" Icon="{x:Static uc:ShellIcons.Settings}" />
                    </Button>

                    <Button Classes="rail" Click="OnShowAbout" ToolTip.Tip="{loc:Tr shell.rail.about.tip}">
                        <uc:Glyph Classes="icon" Icon="{x:Static uc:ShellIcons.Help}" />
                    </Button>
                </StackPanel>

                <!--
                  侧栏底部性能监视：1 Hz 文本，窄栏内只放四行；鼠标指向任一行时在右侧展开完整口径。
                  ToolTip 逐行挂：Avalonia 的指针命中落在 TextBlock 上，不能只挂在父 StackPanel 上。
                -->
                <Border Grid.Row="1"
                        Margin="1,0,1,6"
                        Background="Transparent"
                        IsVisible="{Binding Performance.IsEnabled}"
                        ToolTip.Tip="{Binding Performance.Tooltip}"
                        ToolTip.Placement="Right">
                    <StackPanel Spacing="0">
                        <TextBlock Name="PerformanceCpu"
                                   FontSize="8"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding Performance.CpuText}"
                                   ToolTip.Tip="{Binding Performance.Tooltip}"
                                   ToolTip.Placement="Right" />
                        <TextBlock Name="PerformanceMemory"
                                   FontSize="8"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding Performance.MemoryText}"
                                   ToolTip.Tip="{Binding Performance.Tooltip}"
                                   ToolTip.Placement="Right" />
                        <TextBlock Name="PerformanceThreads"
                                   FontSize="8"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding Performance.ThreadText}"
                                   ToolTip.Tip="{Binding Performance.Tooltip}"
                                   ToolTip.Placement="Right" />
                        <TextBlock Name="PerformanceGc"
                                   FontSize="8"
                                   HorizontalAlignment="Center"
                                   TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource TextSecondary}"
                                   Text="{Binding Performance.GcText}"
                                   ToolTip.Tip="{Binding Performance.Tooltip}"
                                   ToolTip.Placement="Right" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ==================== B 区：侧边界面 ==================== -->
        <!-- 用 Panel 包一层：可见性绑到**外壳视图模型**，而视图自身的 DataContext 另行指定 -->
        <Panel Grid.Row="0" Grid.Column="1" IsVisible="{Binding IsCatalogPage}">
            <views:ModuleCatalogView DataContext="{Binding Catalog}" />
        </Panel>

        <Panel Grid.Row="0" Grid.Column="1" IsVisible="{Binding IsCompositePage}">
            <views:CompositePageView DataContext="{Binding Composites}" />
        </Panel>

        <Panel Grid.Row="0" Grid.Column="1" IsVisible="{Binding IsInteractionPage}">
            <views:InteractionView DataContext="{Binding}" />
        </Panel>

        <!-- ==================== 状态栏（左右两端同一基线与高度） ==================== -->
        <!--
          状态栏布局：
          ① **尾部没有 `Issue N` 入口**：活动栏（A 区）已有 Issue 图标 + 错误计数，
             再放一个就是**重复入口**，标签也与摘要里的 `· Issue N` 重复；**计数仍留在摘要里**（那是信息，不是入口）。
          ② **临时提示独占一列**：提示拼在摘要末尾时，主窗口窄、摘要占满后提示会被截断，
             看起来像"未完成显示的信息"。现在摘要（`*`，先省略）+ 提示（`Auto`，优先完整显示，超长自己省略）。
          ③ 提示**到点自动过期**（见 `ShellViewModel.NoticeLifetime`），不靠"下一条提示"替换。
        -->
        <Border Grid.Row="1" Grid.Column="1"
                Height="28"
                Background="{DynamicResource BgChrome}"
                BorderBrush="{DynamicResource BorderDefault}"
                BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="*,Auto" Margin="10,0,10,0">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{Binding StatusText}" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           MaxWidth="240"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Classes.notice="True"
                           Classes.error="{Binding StatusNoticeIsError}"
                           ToolTip.Tip="{Binding StatusNotice}"
                           Text="{Binding StatusNotice}" />
            </Grid>
        </Border>
    </Grid>
</Window>
