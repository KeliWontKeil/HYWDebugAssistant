<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
             xmlns:ui="using:HYWDebugAssistant.Ui.Controls"
             xmlns:controls="using:HYWDebugAssistant.FrameworkUi.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             x:Class="HYWDebugAssistant.FrameworkUi.Views.SettingsView"
             x:DataType="vm:SettingsPanelViewModel"
             xmlns:design="using:HYWDebugAssistant.FrameworkUi.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{x:Static design:ShellDesignData.Settings}"
             d:DesignWidth="780" d:DesignHeight="620"
             FontSize="12">

    <!--
      设置弹窗：**分类化**（左分类 · 右页面）。
      五类：常规 · 外观 · 窗口与交互 · 快捷键 · 关于。

      · 「模块与来源」不在设置里：模块清单弹窗已经承载来源根增删、重扫、诊断与加载包；
      · 「日志与诊断」不在设置里：Issue / 拓扑 / 日志查看是独立功能；日志级别与诊断提示阈值并入「常规」；
      · **三键机制**：取消 / 应用 / 确认。外观里的主题卡只切换本页色板草稿，
        全应用仍在「应用 / 确认」后切换；主题方案随三键落盘。
    -->
    <UserControl.Styles>
        <Style Selector="TabControl.settings TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Width" Value="132" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabControl.settings TabItem:selected">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sec">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <!-- 主题卡：固定尺寸；选中 = 主题色边框 + 淡主题色底 -->
        <Style Selector="Button.themeCard">
            <Setter Property="Width" Value="132" />
            <Setter Property="Height" Value="72" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Background" Value="{DynamicResource BgModule}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
        <Style Selector="Button.themeCard:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="Background" Value="{DynamicResource BgModule}" />
        </Style>
        <Style Selector="Button.themeCard.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
        </Style>
        <Style Selector="Button.themeCard.selected:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
        </Style>

        <Style Selector="TextBlock.themeTitle">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style Selector="TextBlock.themeBase">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!-- 色块按钮：只要色块，不要按钮面/边/内边距 -->
        <Style Selector="Button.swatch">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.swatch:pointerover">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>

        <Style Selector="Ellipse.overrideDot">
            <Setter Property="Width" Value="6" />
            <Setter Property="Height" Value="6" />
            <Setter Property="Fill" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 分区标题靠左：Fluent 的 Expander 头默认把内容居中，观感像“居中标题” -->
        <Style Selector="Expander /template/ ToggleButton">
            <Setter Property="HorizontalContentAlignment" Value="Left" />
        </Style>
    </UserControl.Styles>

    <!--
      底部**三键条**：取消 / 应用 / 确认。任何改动都只是"待生效"；
      「应用」= 生效并留在本页，「确认」= 应用并关闭，「取消」= 丢弃本次改动并关闭。
      状态行显示"已生效 / 未生效：原因"。
    -->
    <Grid RowDefinitions="*,Auto">
        <TabControl Grid.Row="0" Classes="settings" TabStripPlacement="Left" Margin="6">

            <!-- ============================ 常规 ============================ -->
            <TabItem Header="{loc:Tr settings.general.tab.title}">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="6">
                        <TextBlock Classes="sec" Text="{loc:Tr settings.general.behavior.title}" />
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.general.language.label}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding Languages}"
                                      SelectedItem="{Binding SelectedLanguageChoice, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="note" Text="{loc:Tr settings.general.language.note}" />
                        <ui:UiToggle Content="{loc:Tr settings.general.alignAutoNetwork.label}"
                                  IsChecked="{Binding AlignAutoNetworkEnabled, Mode=TwoWay}"
                                  ToolTip.Tip="{loc:Tr settings.general.alignAutoNetwork.tip}" />

                        <TextBlock Classes="sec" Margin="0,8,0,0" Text="{loc:Tr settings.general.performance.title}" />
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.general.refreshRate.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.general.refreshRate.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding UiRefreshRateHz, Mode=TwoWay}" />
                        </Grid>

                        <Rectangle Height="1" Margin="0,4" Fill="{DynamicResource BorderDefault}" />

                        <TextBlock Classes="sec" Text="{loc:Tr settings.general.logs.title}" />
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.general.logLevel.label}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}"
                                      SelectedItem="{Binding LogLevel, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 外观 ============================ -->
            <!-- ============================ 通信 ============================ -->
            <TabItem Header="{loc:Tr settings.comm.tab.title}">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="6">
                        <TextBlock Classes="sec" Text="{loc:Tr settings.flow.title}" />

                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.queueCapacity.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.queueCapacity.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding QueueCapacity, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.dropPolicy.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.dropPolicy.label}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding DropPolicyChoices}"
                                      SelectedItem="{Binding SelectedDropPolicy, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.stopTimeout.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.stopTimeout.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding StopTimeoutSeconds, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.hintDepth.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.hintDepth.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding HintDepth, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.hintHold.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.hintHold.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding HintHoldMs, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.maxAge.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.maxAge.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding MaxBacklogAgeMs, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.writeTimeout.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.writeTimeout.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding ExternalWriteTimeoutMs, Mode=TwoWay}" />
                        </Grid>
                                                <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.liveness.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.liveness.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding LivenessIntervalMs, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.sendBacklog.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.sendBacklog.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding SendBacklogBytes, Mode=TwoWay}" />
                        </Grid>                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.adapterBuffer.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.adapterBuffer.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding AdapterBufferBytes, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.closeTimeout.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.closeTimeout.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding AccessCloseTimeoutMs, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.flow.deviceLost.tip}"
                                       Foreground="{DynamicResource TextSecondary}"
                                       Text="{loc:Tr settings.flow.deviceLost.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding DeviceLostMisses, Mode=TwoWay}" />
                        </Grid>                        <TextBlock Classes="note" Text="{loc:Tr settings.flow.note}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="{loc:Tr settings.appearance.tab.title}">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="6">
                        <TextBlock Classes="sec" Text="{loc:Tr appearance.font.section}" />
                        <Grid ColumnDefinitions="170,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr appearance.font.ui.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.font.uiLatin.label}" />
                            <controls:FontFamilyPicker Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="300"
                                                       Options="{Binding FontFamilyOptions}"
                                                       SelectedFont="{Binding UiFontLatin, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr appearance.font.ui.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.font.uiCjk.label}" />
                            <controls:FontFamilyPicker Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="300"
                                                       Options="{Binding FontFamilyOptions}"
                                                       SelectedFont="{Binding UiFontCjk, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr appearance.font.data.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.font.dataLatin.label}" />
                            <controls:FontFamilyPicker Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="300"
                                                       Options="{Binding FontFamilyOptions}"
                                                       SelectedFont="{Binding DataFontLatin, Mode=TwoWay}" />
                        </Grid>
                        <Grid ColumnDefinitions="170,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr appearance.font.data.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.font.dataCjk.label}" />
                            <controls:FontFamilyPicker Grid.Column="1" HorizontalAlignment="Stretch" MaxWidth="300"
                                                       Options="{Binding FontFamilyOptions}"
                                                       SelectedFont="{Binding DataFontCjk, Mode=TwoWay}" />
                        </Grid>
                        <TextBlock Classes="note" Text="{loc:Tr appearance.font.note}" />

                        <Rectangle Height="1" Margin="0,4" Fill="{DynamicResource BorderDefault}" />

                        <TextBlock Classes="sec" Text="{loc:Tr appearance.theme.section}" />

                        <ItemsControl x:Name="ThemeCards" ItemsSource="{Binding ThemeCards}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:ThemeCardViewModel">
                                    <Button Classes="themeCard"
                                            Classes.selected="{Binding IsSelected}"
                                            Click="OnSelectThemeCard"
                                            ToolTip.Tip="{Binding ToolTip}">
                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0" Classes="themeTitle" Text="{Binding Title}" />
                                            </Grid>
                                            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="4" Margin="0,5,0,0">
                                                <Border Width="18" Height="18" CornerRadius="3"
                                                        Background="{Binding Preview1}"
                                                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                                                <Border Width="18" Height="18" CornerRadius="3"
                                                        Background="{Binding Preview2}"
                                                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                                                <Border Width="18" Height="18" CornerRadius="3"
                                                        Background="{Binding Preview3}"
                                                        BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
                                            </StackPanel>
                                            <TextBlock Grid.Row="2" Classes="themeBase" Margin="0,4,0,0"
                                                       Text="{Binding BaseLabel}" />
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 跟随系统：不显示改名输入框 / 新建按钮，改为两套模式方案下拉 -->
                        <StackPanel IsVisible="{Binding IsSystemSelected}" Spacing="6" Margin="0,2,0,0">
                            <Grid ColumnDefinitions="110,*,110,*" ColumnSpacing="6">
                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.system.light.label}" />
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding SystemLightChoices}"
                                          SelectedItem="{Binding SelectedSystemLightChoice, Mode=TwoWay}"
                                          ToolTip.Tip="{loc:Tr appearance.system.light.tip}" />
                                <TextBlock Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0"
                                           Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.system.dark.label}" />
                                <ComboBox Grid.Column="3"
                                          ItemsSource="{Binding SystemDarkChoices}"
                                          SelectedItem="{Binding SelectedSystemDarkChoice, Mode=TwoWay}"
                                          ToolTip.Tip="{loc:Tr appearance.system.dark.tip}" />
                            </Grid>
                            <TextBlock Classes="note"
                                       Text="{loc:Tr appearance.system.note}" />
                        </StackPanel>

                        <!-- 内置 / 自定义方案：内置不提供改名输入，只有自定义可改名 / 保存 / 删除 -->
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto,Auto" Margin="0,2,0,0"
                              IsVisible="{Binding !IsSystemSelected}">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center" Margin="0,0,6,0"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.theme.name.label}" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" MaxWidth="280"
                                       HorizontalAlignment="Left"
                                       IsVisible="{Binding !CanEditSchemeTitle}"
                                       TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedSchemeTitle}" />
                            <TextBox Grid.Column="1" MaxWidth="280" HorizontalAlignment="Left"
                                     IsVisible="{Binding CanEditSchemeTitle}"
                                     Text="{Binding SelectedSchemeTitle, Mode=TwoWay}" />
                            <Button Grid.Column="2" Content="{loc:Tr appearance.theme.save}" Margin="6,0,0,0"
                                    Command="{Binding SaveSchemeCommand}"
                                    IsVisible="{Binding CanSaveScheme}"
                                    ToolTip.Tip="{loc:Tr appearance.theme.save.tip}" />
                            <Button Grid.Column="3" Content="{loc:Tr appearance.theme.new}" Margin="6,0,0,0"
                                    Command="{Binding NewSchemeCommand}"
                                    IsVisible="{Binding CanCreateScheme}" />
                            <Button Grid.Column="4" Content="{loc:Tr appearance.theme.delete}" Margin="6,0,0,0"
                                    IsVisible="{Binding CanDeleteScheme}"
                                    Click="OnDeleteScheme"
                                    ToolTip.Tip="{loc:Tr appearance.theme.delete.tip}" />
                            <Button Grid.Column="5" Content="⋯" Margin="6,0,0,0"
                                    IsVisible="{Binding CanResetScheme}"
                                    ToolTip.Tip="{loc:Tr appearance.theme.more.tip}">
                                <Button.Flyout>
                                    <MenuFlyout>
                                        <MenuItem Header="{loc:Tr appearance.theme.resetMenu}" Click="OnResetScheme" />
                                    </MenuFlyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>

                        <TextBlock Classes="note"
                                   Text="{loc:Tr appearance.theme.note}" />

                        <Rectangle Height="1" Margin="0,4" Fill="{DynamicResource BorderDefault}" />

                        <TextBlock Classes="sec" Text="{loc:Tr appearance.wallpaper.section}" />
                        <Grid ColumnDefinitions="132,*" ColumnSpacing="10">
                            <Border Width="132" Height="78" VerticalAlignment="Top"
                                    Background="{DynamicResource BgWorkspace}"
                                    BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1"
                                    CornerRadius="3" ClipToBounds="True">
                                <Panel>
                                    <Border Background="{Binding ThemeWallpaperPreview}" />
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center"
                                               IsVisible="{Binding !HasThemeWallpaper}"
                                               Foreground="{DynamicResource TextMuted}"
                                               FontSize="10" Text="{loc:Tr appearance.wallpaper.none}" />
                                </Panel>
                            </Border>
                            <StackPanel Grid.Column="1" Spacing="4">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <Button Content="{loc:Tr appearance.wallpaper.pick}" Click="OnPickThemeWallpaper" />
                                    <Button Content="{loc:Tr appearance.wallpaper.clear}" Click="OnClearThemeWallpaper"
                                            IsEnabled="{Binding CanClearThemeWallpaper}" />
                                </StackPanel>
                                <TextBlock Classes="note"
                                           Text="{loc:Tr appearance.wallpaper.note}" />
                            </StackPanel>
                        </Grid>

                        <Grid ColumnDefinitions="170,220,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr appearance.wallpaper.veil.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.wallpaper.veil.label}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="0.9"
                                    Value="{Binding WallpaperVeilOpacity, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource FontData}"
                                       Text="{Binding WallpaperVeilOpacity, StringFormat='{}{0:P0}'}" />
                        </Grid>
                        <TextBlock Classes="note" Text="{loc:Tr appearance.wallpaper.veil.note}" />

                        <Grid ColumnDefinitions="170,220,Auto" ColumnSpacing="6" Margin="0,2,0,0">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr appearance.surface.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr appearance.surface.label}" />
                            <Slider Grid.Column="1" Minimum="0" Maximum="1.0"
                                    Value="{Binding SurfaceOpacity, Mode=TwoWay}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource FontData}"
                                       Text="{Binding SurfaceOpacity, StringFormat='{}{0:P0}'}" />
                        </Grid>
                        <TextBlock Classes="note" Text="{loc:Tr appearance.surface.note}" />

                        <Rectangle Height="1" Margin="0,4" Fill="{DynamicResource BorderDefault}" />

                        <StackPanel Spacing="2">
                            <TextBlock Classes="sec" Text="{loc:Tr appearance.palette.section}" />
                            <TextBlock Classes="note" Text="{loc:Tr appearance.palette.note}" />
                        </StackPanel>

                        <ItemsControl x:Name="PaletteGroups" ItemsSource="{Binding PaletteGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:PaletteGroupViewModel">
                                    <Expander Margin="0,2"
                                              HorizontalAlignment="Stretch"
                                              HorizontalContentAlignment="Stretch"
                                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding Title}" Foreground="{DynamicResource TextSecondary}" />
                                                <TextBlock Text="{Binding CountText}" FontSize="10"
                                                           Foreground="{DynamicResource SemanticWarn}"
                                                           IsVisible="{Binding HasOverrides}" />
                                            </StackPanel>
                                        </Expander.Header>

                                        <ItemsControl ItemsSource="{Binding Rows}" HorizontalAlignment="Stretch">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="vm:PaletteRowViewModel">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,1"
                                                          HorizontalAlignment="Stretch"
                                                          ToolTip.Tip="{Binding Purpose}">
                                                        <Button Grid.Column="0" Classes="swatch"
                                                                Click="OnPickPaletteColor"
                                                                ToolTip.Tip="{Binding Cell.ToolTip}">
                                                            <Border Width="22" Height="16" CornerRadius="3"
                                                                    Background="{Binding Cell.Brush}"
                                                                    BorderBrush="{DynamicResource BorderStrong}"
                                                                    BorderThickness="1" />
                                                        </Button>
                                                        <TextBlock Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                   FontSize="11" TextTrimming="CharacterEllipsis"
                                                                   ToolTip.Tip="{Binding Key}"
                                                                   Text="{Binding Title}" />
                                                        <Ellipse Grid.Column="2" Classes="overrideDot" Margin="6,0,0,0"
                                                                 IsVisible="{Binding Cell.IsOverridden}" />
                                                        <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center"
                                                                   FontFamily="{DynamicResource FontData}" FontSize="10"
                                                                   Foreground="{DynamicResource TextMuted}"
                                                                   Text="{Binding Cell.EffectiveHex}" />
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
</StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 窗口与交互 ============================ -->
            <TabItem Header="{loc:Tr settings.interaction.tab.title}">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="6">
                        <TextBlock Classes="sec" Text="{loc:Tr settings.interaction.window.section}" />
                        <ui:UiToggle Content="{loc:Tr settings.interaction.topmost.label}"
                                  IsChecked="{Binding AppTopmost, Mode=TwoWay}"
                                  ToolTip.Tip="{loc:Tr settings.interaction.topmost.tip}" />
                        <TextBlock Classes="note" Text="{loc:Tr settings.interaction.window.note}" />

                        <Rectangle Height="1" Margin="0,4" Fill="{DynamicResource BorderDefault}" />

                        <TextBlock Classes="sec" Text="{loc:Tr settings.interaction.display.section}" />
                        <ui:UiToggle Content="{loc:Tr settings.interaction.overlay.label}"
                                  IsChecked="{Binding ShowInfoOverlay, Mode=TwoWay}"
                                  ToolTip.Tip="{loc:Tr settings.interaction.overlay.tip}" />
                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.interaction.snap.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.interaction.snap.label}" />
                            <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                     Text="{Binding SnapDistance, Mode=TwoWay}" />
                        </Grid>

                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.interaction.multiline.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.interaction.multiline.label}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding MultilineSubmitKeyOptions}"
                                      SelectedItem="{Binding MultilineSubmitKey, Mode=TwoWay}" />
                        </Grid>

                        <Rectangle Height="1" Margin="0,4" Fill="{DynamicResource BorderDefault}" />

                        <TextBlock Classes="sec" Text="{loc:Tr settings.interaction.shell.section}" />
                        <Grid ColumnDefinitions="170,190,Auto">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.interaction.aspect.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.interaction.aspect.label}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding ShellAspectOptions}"
                                      SelectedItem="{Binding ShellAspect, Mode=TwoWay}" />
                            <ui:UiToggle Grid.Column="2" Margin="8,0,0,0" Content="{loc:Tr settings.interaction.fixed.label}"
                                      IsChecked="{Binding ShellFixedSize, Mode=TwoWay}"
                                      ToolTip.Tip="{loc:Tr settings.interaction.fixed.tip}" />
                        </Grid>

                        <Grid ColumnDefinitions="170,190,*">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       ToolTip.Tip="{loc:Tr settings.interaction.exit.tip}"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.interaction.exit.label}" />
                            <ComboBox Grid.Column="1" ItemsSource="{Binding WorkspaceExitChoices}"
                                      SelectedItem="{Binding SelectedWorkspaceExitChoice, Mode=TwoWay}" />
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 存储 ============================ -->
            <TabItem Header="{loc:Tr settings.storage.tab.title}">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="8">
                        <TextBlock Classes="sec" Text="{loc:Tr settings.storage.section}" />
                        <TextBlock Classes="note" TextWrapping="Wrap"
                                   Text="{loc:Tr settings.storage.note}" />

                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.storage.settings}" />
                            <TextBox Grid.Column="1" IsReadOnly="True"
                                     FontFamily="{DynamicResource FontData}"
                                     Text="{Binding StorageSettingsFile}" />
                            <Button Grid.Column="2" Content="{loc:Tr settings.storage.open}"
                                    Click="OnOpenStorageFolder"
                                    CommandParameter="{Binding StorageSettingsFile}" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.storage.modules}" />
                            <TextBox Grid.Column="1" IsReadOnly="True"
                                     FontFamily="{DynamicResource FontData}"
                                     Text="{Binding StorageModulesRoot}" />
                            <Button Grid.Column="2" Content="{loc:Tr settings.storage.open}"
                                    Click="OnOpenStorageFolder"
                                    CommandParameter="{Binding StorageModulesRoot}" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.storage.composites}" />
                            <TextBox Grid.Column="1" IsReadOnly="True"
                                     FontFamily="{DynamicResource FontData}"
                                     Text="{Binding StorageCompositesRoot}" />
                            <Button Grid.Column="2" Content="{loc:Tr settings.storage.open}"
                                    Click="OnOpenStorageFolder"
                                    CommandParameter="{Binding StorageCompositesRoot}" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.storage.workspace}" />
                            <TextBox Grid.Column="1" IsReadOnly="True"
                                     FontFamily="{DynamicResource FontData}"
                                     Text="{Binding StorageWorkspaceRoot}" />
                            <Button Grid.Column="2" Content="{loc:Tr settings.storage.open}"
                                    Click="OnOpenStorageFolder"
                                    CommandParameter="{Binding StorageWorkspaceRoot}" />
                        </Grid>

                        <Grid ColumnDefinitions="120,*,Auto" ColumnSpacing="6">
                            <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextSecondary}" Text="{loc:Tr settings.storage.logs}" />
                            <TextBox Grid.Column="1" IsReadOnly="True"
                                     FontFamily="{DynamicResource FontData}"
                                     Text="{Binding StorageLogsRoot}" />
                            <Button Grid.Column="2" Content="{loc:Tr settings.storage.open}"
                                    Click="OnOpenStorageFolder"
                                    CommandParameter="{Binding StorageLogsRoot}" />
                        </Grid>

                        <TextBlock Classes="note" TextWrapping="Wrap"
                                   Text="{loc:Tr settings.storage.pathNote}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ============================ 快捷键 ============================ -->
            <TabItem Header="{loc:Tr settings.hotkeys.tab.title}">
                <Grid RowDefinitions="Auto,*,Auto" Margin="10">
                    <StackPanel Grid.Row="0" Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                                <TextBlock Classes="sec" VerticalAlignment="Center" Text="{loc:Tr settings.hotkeys.section}" />
                                <TextBlock Classes="note" VerticalAlignment="Center" Text="{loc:Tr settings.hotkeys.section.note}" />
                            </StackPanel>
                            <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="{loc:Tr settings.hotkeys.edit.tip}">
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedRight">
                                        <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                                   Text="{loc:Tr settings.hotkeys.edit.body}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                        <TextBlock FontSize="11"
                                   TextWrapping="Wrap"
                                   IsVisible="{Binding HotkeyConflicts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                   Foreground="{DynamicResource SemanticWarn}"
                                   Text="{Binding HotkeyConflicts}" />
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" Margin="0,6,0,0">
                        <ItemsControl ItemsSource="{Binding Hotkeys}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="vm:HotkeyRowViewModel">
                                    <Grid ColumnDefinitions="180,110,Auto,Auto" Margin="0,2">
                                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextSecondary}"
                                                   Text="{Binding Title}" />
                                        <TextBox Grid.Column="1"
                                                 FontFamily="{DynamicResource FontData}"
                                                 Text="{Binding Binding, Mode=OneWay}"
                                                 IsReadOnly="True"
                                                 GotFocus="OnHotkeyBoxFocused"
                                                 KeyDown="OnHotkeyBoxKeyDown" />
                                        <Button Grid.Column="2" Content="{loc:Tr settings.hotkeys.default}" Margin="4,0,0,0"
                                                Click="OnResetHotkey" />
                                        <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMuted}"
                                                   Text="{Binding DefaultBindingText}" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                        <Button Content="{loc:Tr settings.hotkeys.resetAll}" Command="{Binding ResetHotkeysCommand}" />
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- ============================ 关于 ============================ -->
            <TabItem Header="{loc:Tr settings.about.tab.title}">
                <ScrollViewer>
                    <StackPanel Margin="10" Spacing="6">
                        <TextBlock Foreground="{DynamicResource TextPrimary}" Text="{loc:Tr settings.about.title}" />
                        <TextBlock Classes="note" Text="{loc:Tr settings.about.tagline}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Grid.Column="0" Classes="note" VerticalAlignment="Center"
                                       Text="{loc:Tr settings.about.quickstart.label}" />
                            <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="{loc:Tr settings.about.quickstart.tip}">
                                <Button.Flyout>
                                    <Flyout Placement="TopEdgeAlignedRight">
                                        <TextBlock MaxWidth="340" TextWrapping="Wrap" FontSize="11"
                                                   Text="{loc:Tr settings.about.quickstart.body}" />
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <!-- 三键条：左 = 状态行，右 = 恢复默认设置 · 取消 · 应用 · 确认 -->
        <Border Grid.Row="1"
                Padding="10,6"
                BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource BorderDefault}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0"
                           VerticalAlignment="Center"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextSecondary}"
                           Text="{Binding StatusMessage}" />
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button Content="{loc:Tr common.resetAll}" Command="{Binding ResetAllSettingsCommand}"
                            ToolTip.Tip="{loc:Tr common.resetAll.tip}" />
                    <Rectangle Width="1" Margin="4,2" Fill="{DynamicResource BorderDefault}" />
                    <Button Content="{loc:Tr common.cancel}" Command="{Binding CancelCommand}"
                            ToolTip.Tip="{loc:Tr common.cancel.tip}" />
                    <Button Content="{loc:Tr common.apply}" Command="{Binding ApplyCommand}"
                            ToolTip.Tip="{loc:Tr common.apply.tip}" />
                    <Button Content="{loc:Tr common.confirm}" Command="{Binding ConfirmCommand}"
                            Classes="accent"
                            ToolTip.Tip="{loc:Tr common.confirm.tip}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
