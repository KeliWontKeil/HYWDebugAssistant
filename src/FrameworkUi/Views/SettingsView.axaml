<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
             x:Class="HYWDebugAssistant.FrameworkUi.Views.SettingsView"
             x:DataType="vm:SettingsPanelViewModel"
             xmlns:design="using:HYWDebugAssistant.FrameworkUi.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{x:Static design:ShellDesignData.Settings}"
             d:DesignWidth="780" d:DesignHeight="620"
             FontSize="12">

    <!--
      设置弹窗（R-3 / ADR-0036 D6）：**分类化**（左分类 · 右页面，VSCode 风格）。
      七类：常规 · 模块与来源 · 窗口与交互 · 外观与显示 · 快捷键 · 日志与诊断 · 关于。

      【用户第七轮反馈后重排】
        · 左分类：字号 12、行高 28、宽 132、**文字居中**；
        · **说明性长文本不再常显**：改为 ① 控件悬停提示（ToolTip）② 问号按钮折叠（点击展开）；
        · 行距/内边距收紧（10 / 6），整体紧凑。
    -->
    <UserControl.Styles>
        <Style Selector="TabControl.settings TabItem">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Height" Value="28" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Width" Value="132" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="TabControl.settings TabItem:selected">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sec">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.note">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>
    </UserControl.Styles>

    <TabControl Classes="settings" TabStripPlacement="Left" Margin="6">

        <!-- ============================ 常规 ============================ -->
        <TabItem Header="常规">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="6">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="sec" VerticalAlignment="Center" Text="应用行为" />
                        <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="关于本页">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                               Text="本页是应用级设置（跨组合件共享、不随组合件保存）；模块实例的参数在模块自己的窗口里改（配置表单）。" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="140,110,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   ToolTip.Tip="模块停止的有界等待时限（秒）"
                                   Foreground="{DynamicResource TextSecondary}" Text="停止超时（秒）" />
                        <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                 Text="{Binding StopTimeoutSeconds, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,110,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   ToolTip.Tip="对新建的输入队列生效（已存在的队列不变）"
                                   Foreground="{DynamicResource TextSecondary}" Text="输入队列容量" />
                        <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                 Text="{Binding InputQueueCapacity, Mode=TwoWay}" />
                    </Grid>

                    <CheckBox Content="对齐自动建网"
                              IsChecked="{Binding AlignAutoNetworkEnabled, Mode=TwoWay}"
                              ToolTip.Tip="两个模块「接触且标记对齐」时自动连上（只对未打网络标签的口生效）" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================ 模块与来源 ============================ -->
        <TabItem Header="模块与来源">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="6">
                    <TextBlock Classes="sec" Text="额外来源根（按顺序扫描，先到者胜）" />

                    <Grid ColumnDefinitions="*,Auto,Auto">
                        <TextBox Grid.Column="0"
                                 PlaceholderText="来源根目录（如 D:\my-modules）"
                                 Text="{Binding NewSourceDirectory, Mode=TwoWay}" />
                        <Button Grid.Column="1" Content="添加" Margin="4,0,0,0" Command="{Binding AddSourceDirectoryCommand}" />
                        <Button Grid.Column="2" Content="重扫" Margin="4,0,0,0" Command="{Binding RescanModuleSourcesCommand}"
                                ToolTip.Tip="立刻重扫全部来源根（装入新增的包）；改过代码的包仍需重启应用" />
                    </Grid>

                    <ListBox Height="80"
                             ItemsSource="{Binding ModuleSourceDirectories}"
                             SelectedItem="{Binding SelectedSourceDirectory, Mode=TwoWay}"
                             ToolTip.Tip="内置包目录（应用目录下 modules\）始终在首位，无需配置" />

                    <StackPanel Orientation="Horizontal" Spacing="4">
                        <Button Content="上移" Command="{Binding MoveSourceDirectoryUpCommand}" />
                        <Button Content="下移" Command="{Binding MoveSourceDirectoryDownCommand}" />
                        <Button Content="移除" Command="{Binding RemoveSourceDirectoryCommand}" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                        <TextBlock Grid.Column="0" Classes="sec" VerticalAlignment="Center" Text="扫描诊断" />
                        <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="显示扫描诊断">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                               Text="逐个来源根显示扫到的包数、跳过的子目录、失败包数与逐包结果。改过代码的包需重启应用才生效（框架不实现热重载）。" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding ModuleSources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:ModuleSourceRowViewModel">
                                <StackPanel Margin="0,2">
                                    <TextBlock FontFamily="{DynamicResource FontData}"
                                               FontSize="10"
                                               TextTrimming="CharacterEllipsis"
                                               Foreground="{DynamicResource TextPrimary}"
                                               Text="{Binding Directory}" />
                                    <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="{Binding Summary}" />
                                    <TextBlock Classes="note" Text="{Binding Details}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================ 窗口与交互 ============================ -->
        <TabItem Header="窗口与交互">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="6">
                    <TextBlock Classes="sec" Text="窗口层级" />

                    <CheckBox Content="应用整体置顶"
                              IsChecked="{Binding AppTopmost, Mode=TwoWay}"
                              ToolTip.Tip="本应用全部窗口（外壳 + 模块窗口 + 弹窗，含之后新开的）一起置顶；不提供单窗口置顶" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="note" VerticalAlignment="Center"
                                   Text="应用内：弹窗 &gt; 模块窗口 &gt; 外壳" />
                        <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="窗口层级说明">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                               Text="相对其他应用只有两种统一状态：普通（激活任一窗口即把其余一并抬前）或全体置顶。模块窗口以外壳为从属窗口（外壳永在其下、最小化随外壳）。" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>

                    <TextBlock Classes="sec" Margin="0,4,0,0" Text="拖动与吸附（修饰键为固定行为）" />
                    <TextBlock Classes="note"
                               ToolTip.Tip="拖动窗口边框 = 移动；边中点/角点 = 缩放；Ctrl = 只移动当前窗口；Alt = 本次不吸附"
                               Text="边框拖动 · 边/角缩放 · Ctrl 独立拖动 · Alt 临时不吸附" />
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================ 外观与显示 ============================ -->
        <TabItem Header="外观与显示">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="6">
                    <Grid ColumnDefinitions="140,110,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   ToolTip.Tip="界面按此节拍从订阅缓冲抽样读取"
                                   Foreground="{DynamicResource TextSecondary}" Text="刷新率（Hz）" />
                        <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                 Text="{Binding UiRefreshRateHz, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,110,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   ToolTip.Tip="拖动时的磁吸半径（2–8px，默认 4）：越小越跟手，越大越容易吸上；贴合（相邻边接触）用它的 2 倍"
                                   Foreground="{DynamicResource TextSecondary}" Text="吸附距离（px）" />
                        <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                 Text="{Binding SnapDistance, Mode=TwoWay}" />
                    </Grid>

                    <CheckBox Content="显示叠加信息层"
                              IsChecked="{Binding ShowInfoOverlay, Mode=TwoWay}"
                              ToolTip.Tip="模块窗口内绘制连接线与数据流向；端口标记（网络标签）始终显示" />

                    <Rectangle Height="1" Margin="0,2" Fill="{DynamicResource BorderDefault}" />

                    <TextBlock Classes="sec" Text="外观" />

                    <Grid ColumnDefinitions="140,140,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Text="主题" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ThemeOptions}"
                                  SelectedItem="{Binding Theme, Mode=TwoWay}"
                                  ToolTip.Tip="浅色 / 深色 / 跟随系统（即时生效）" />
                    </Grid>

                    <Grid ColumnDefinitions="140,Auto,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Text="主题色" />
                        <!--
                          【用户第十一轮反馈】颜色选择改为**弹出式窗口**：此处只显示一个当前色块，
                          点开弹窗里选预设或填自定义色值 —— 不再把 8 个色块 + 输入框挤在行内。
                        -->
                        <Button Grid.Column="1" Padding="0" Width="28" Height="24" MinHeight="24"
                                ToolTip.Tip="选择主题色">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="6" Width="228">
                                        <TextBlock Classes="note" Text="预设" />
                                        <ItemsControl ItemsSource="{Binding AccentPresetList}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Width="24" Height="24" MinHeight="24" Padding="0" Margin="2"
                                                            Background="{Binding Brush}"
                                                            BorderBrush="{DynamicResource BorderStrong}"
                                                            BorderThickness="1"
                                                            ToolTip.Tip="{Binding Name}"
                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsPanelViewModel)DataContext).SelectAccentCommand}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Classes="note" Text="自定义（十六进制）" />
                                        <TextBox FontFamily="{DynamicResource FontData}"
                                                 Text="{Binding AccentColor, Mode=TwoWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Border Width="24" Height="20" CornerRadius="3"
                                    Background="{Binding AccentBrush}"
                                    BorderBrush="{DynamicResource BorderStrong}"
                                    BorderThickness="1" />
                        </Button>
                        <TextBlock Grid.Column="2" Margin="6,0,0,0" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource FontData}" FontSize="11"
                                   Foreground="{DynamicResource TextMuted}" Text="{Binding AccentColor}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,Auto,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   ToolTip.Tip="Theme = 跟随主题 · LightGray · DarkGray · Custom（自定义色取右侧色块）"
                                   Foreground="{DynamicResource TextSecondary}" Text="背景" />
                        <ComboBox Grid.Column="1" Width="140" ItemsSource="{Binding BackgroundOptions}"
                                  SelectedItem="{Binding BackgroundMode, Mode=TwoWay}" />
                        <Button Grid.Column="2" Margin="6,0,0,0" Padding="0" Width="28" Height="24" MinHeight="24"
                                ToolTip.Tip="自定义背景色（背景档位选 Custom 时生效）">
                            <Button.Flyout>
                                <Flyout Placement="BottomEdgeAlignedLeft">
                                    <StackPanel Spacing="6" Width="228">
                                        <TextBlock Classes="note" Text="自定义背景色（十六进制）" />
                                        <TextBox FontFamily="{DynamicResource FontData}"
                                                 Text="{Binding BackgroundColor, Mode=TwoWay}" />
                                    </StackPanel>
                                </Flyout>
                            </Button.Flyout>
                            <Border Width="24" Height="20" CornerRadius="3"
                                    Background="{Binding BackgroundBrush}"
                                    BorderBrush="{DynamicResource BorderStrong}"
                                    BorderThickness="1" />
                        </Button>
                    </Grid>

                    <Grid ColumnDefinitions="140,140,Auto">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   ToolTip.Tip="默认 9:19.5（手机竖屏常用比例）；取消「尺寸固定」后可自由缩放，比例仅作初值"
                                   Foreground="{DynamicResource TextSecondary}" Text="主窗口比例" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding ShellAspectOptions}"
                                  SelectedItem="{Binding ShellAspect, Mode=TwoWay}" />
                        <CheckBox Grid.Column="2" Margin="8,0,0,0" Content="尺寸固定"
                                  IsChecked="{Binding ShellFixedSize, Mode=TwoWay}"
                                  ToolTip.Tip="勾选 = 不可缩放（尺寸由比例推导）" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================ 快捷键 ============================ -->
        <TabItem Header="快捷键">
            <Grid RowDefinitions="Auto,*,Auto" Margin="10">

                <StackPanel Grid.Row="0" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <TextBlock Classes="sec" VerticalAlignment="Center" Text="应用内快捷键" />
                            <TextBlock Classes="note" VerticalAlignment="Center" Text="（任一本应用窗口聚焦时生效）" />
                        </StackPanel>
                        <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="编辑方式">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                               Text="点某行的「按键」框后按下新组合键即可修改；「默认」恢复该项；「全部恢复默认」恢复所有；空 = 不绑定。系统级全局热键（未聚焦也响应）v1 不做。" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                    <TextBlock FontSize="11"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HotkeyConflicts, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                               Foreground="{DynamicResource SemanticWarn}"
                               Text="{Binding HotkeyConflicts}" />
                </StackPanel>

                <ScrollViewer Grid.Row="1" Margin="0,6,0,0">
                    <ItemsControl ItemsSource="{Binding Hotkeys}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="vm:HotkeyRowViewModel">
                                <Grid ColumnDefinitions="180,110,Auto,Auto" Margin="0,2">
                                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TextSecondary}"
                                               Text="{Binding Title}" />
                                    <TextBox Grid.Column="1"
                                             FontFamily="{DynamicResource FontData}"
                                             Text="{Binding Binding, Mode=OneWay}"
                                             IsReadOnly="True"
                                             GotFocus="OnHotkeyBoxFocused"
                                             KeyDown="OnHotkeyBoxKeyDown" />
                                    <Button Grid.Column="2" Content="默认" Margin="4,0,0,0"
                                            Click="OnResetHotkey" />
                                    <TextBlock Grid.Column="3" Margin="6,0,0,0" VerticalAlignment="Center"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMuted}"
                                               Text="{Binding DefaultBinding, StringFormat='默认 {0}'}" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="6" Margin="0,6,0,0">
                    <Button Content="全部恢复默认" Command="{Binding ResetHotkeysCommand}" />
                </StackPanel>
            </Grid>
        </TabItem>

        <!-- ============================ 日志与诊断 ============================ -->
        <TabItem Header="日志与诊断">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="6">
                    <Grid ColumnDefinitions="140,150,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextSecondary}" Text="日志级别" />
                        <ComboBox Grid.Column="1" ItemsSource="{Binding LogLevels}"
                                  SelectedItem="{Binding LogLevel, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="140,110,*">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                   ToolTip.Tip="队列深度持续达到该值即提示"
                                   Foreground="{DynamicResource TextSecondary}" Text="诊断提示阈值" />
                        <TextBox Grid.Column="1" FontFamily="{DynamicResource FontData}"
                                 Text="{Binding DiagnosticHintThreshold, Mode=TwoWay}" />
                    </Grid>

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="note" VerticalAlignment="Center"
                                   Text="Issue 与拓扑在各自主页面/弹窗" />
                        <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="诊断信息在哪">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <TextBlock MaxWidth="320" TextWrapping="Wrap" FontSize="11"
                                               Text="Issue 汇总与过滤在活动栏「Issue」；连接关系与投递/丢弃计数在「拓扑诊断」（只读）；模块来源扫描诊断在「模块与来源」分类。" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>

        <!-- ============================ 关于 ============================ -->
        <TabItem Header="关于">
            <ScrollViewer>
                <StackPanel Margin="10" Spacing="6">
                    <TextBlock Foreground="{DynamicResource TextPrimary}" Text="何译位调试助手（HYWDebugAssistant）" />
                    <TextBlock Classes="note" Text="模块 = 独立窗口的拼图式工程调试助手（每个实例一个无边框窗口；建网 = 口上网络名同名即连）。" />

                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Classes="note" VerticalAlignment="Center"
                                   Text="用法速查与文件位置" />
                        <Button Grid.Column="1" Classes="helpIcon" ToolTip.Tip="用法速查">
                            <Button.Flyout>
                                <Flyout Placement="TopEdgeAlignedRight">
                                    <TextBlock MaxWidth="340" TextWrapping="Wrap" FontSize="11"
                                               Text="用法：拖动窗口边框移动 · 边中点/角点缩放 · 右上角图标 = 运行/停用、锁定、隐藏、移除 · 双击口标记填网络名。设置存应用目录下 settings.json（跨组合件共享）；组合件（实例/网络/配置/布局）由保存/加载组合件管理。" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </Grid>
                </StackPanel>
            </ScrollViewer>
        </TabItem>
    </TabControl>
</UserControl>
