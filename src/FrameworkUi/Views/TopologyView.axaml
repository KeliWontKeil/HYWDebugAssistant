<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
             x:Class="HYWDebugAssistant.FrameworkUi.Views.TopologyView"
             x:DataType="vm:TopologyViewModel"
             xmlns:design="using:HYWDebugAssistant.FrameworkUi.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{x:Static design:ShellDesignData.Topology}"
             d:DesignWidth="780" d:DesignHeight="620"
             FontSize="12">

    <!--
      拓扑诊断弹窗（R-4）：**只读**。
      这是界面中唯一出现代码化标识（`实例ID.口名`）的地方——它的用途就是诊断端口与连接关系。
      v1 不做跨窗口长连线（`11` §2.3），"谁连着谁"由本表 + 口上标记 + 选中高亮共同表达。
    -->
    <Grid RowDefinitions="Auto,*,Auto" Margin="10">
        <TextBlock Grid.Row="0"
                   Margin="0,0,0,6"
                   Foreground="{DynamicResource TextSecondary}"
                   Text="{Binding Summary}" />

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
            <ItemsControl ItemsSource="{Binding Rows}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:TopologyRowViewModel">
                        <Grid ColumnDefinitions="120,50,170,40,50,70,60,80" Margin="0,1">
                            <TextBlock Grid.Column="0" Text="{Binding NetworkName}"
                                       FontFamily="{DynamicResource FontData}"
                                       FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="1" Text="{Binding Kind}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="2" Text="{Binding Member}"
                                       FontFamily="{DynamicResource FontData}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Grid.Column="3" Text="{Binding Direction}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Grid.Column="4" Text="{Binding State}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" />
                            <TextBlock Grid.Column="5" Text="{Binding Delivered}"
                                       FontFamily="{DynamicResource FontData}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="6" Text="{Binding Dropped}"
                                       FontFamily="{DynamicResource FontData}"
                                       FontSize="11" Foreground="{DynamicResource TextSecondary}" />
                            <TextBlock Grid.Column="7" Text="{Binding LastDataTime}"
                                       FontFamily="{DynamicResource FontData}"
                                       FontSize="11" Foreground="{DynamicResource TextMuted}" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!--
          **占位实例（诊断）**【修正 · 用户第六轮反馈】：它属于诊断，不放在"模块清单"页；
          数据与命令仍由模块清单视图模型提供（`Catalog` 引用），此处只呈现。
        -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0" Spacing="4">
            <TextBlock Text="占位实例（模块定义缺失：保留配置与连线声明）"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextPrimary}" />

            <Grid ColumnDefinitions="*,Auto">
                <ListBox Grid.Column="0"
                         MaxHeight="96"
                         ItemsSource="{Binding Catalog.Placeholders}"
                         SelectedItem="{Binding Catalog.SelectedPlaceholder, Mode=TwoWay}">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:PlaceholderRowViewModel">
                            <TextBlock Margin="0,2"
                                       FontFamily="{DynamicResource FontData}"
                                       FontSize="11"
                                       Text="{Binding InstanceId}"
                                       Foreground="{DynamicResource TextPrimary}" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <Button Grid.Column="1"
                        Content="指定替代"
                        Margin="6,0,0,0"
                        VerticalAlignment="Top"
                        Command="{Binding Catalog.ResolveCommand}"
                        ToolTip.Tip="用「模块清单」里选中的模块替代该占位实例（版本不兼容时的补救路径）" />
            </Grid>

            <TextBlock FontSize="11"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextMuted}"
                       Text="提示：每个模块实例都有自己的窗口——运行/停用、锁定、隐藏、移除与配置都在它自己的窗口上操作。" />
        </StackPanel>
    </Grid>
</UserControl>
