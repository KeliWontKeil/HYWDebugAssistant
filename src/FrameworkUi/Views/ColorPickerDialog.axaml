<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
        xmlns:views="using:HYWDebugAssistant.FrameworkUi.Views"
        xmlns:fw="using:HYWDebugAssistant.FrameworkUi.Controls"
        xmlns:primitives="using:Avalonia.Controls.Primitives"
        x:Class="HYWDebugAssistant.FrameworkUi.Views.ColorPickerDialog"
        Title="{loc:Tr picker.title}"
        SizeToContent="WidthAndHeight"
        CanResize="False"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgModule}">

    <!--
      **紧凑调色板**（所有取色位置复用）。
      第一页：H/S 二维平面 + Hue 横条 + Value 竖条；第二页：整体 RGB + 三条 RGB 滑轨。
      色条使用自绘 GradientBar，刻意不挂普通 Slider，避免滚动条/端点控件和圆形拇指。
    -->
    <Window.Styles>
        <!-- 默认圆形选择器隐藏；位置由 ColorSpectrum 维护，自绘十字读取它。 -->
        <Style Selector="primitives|ColorSpectrum /template/ Panel#PART_SelectionEllipsePanel">
            <Setter Property="Opacity" Value="0" />
        </Style>

        <Style Selector="TabControl.compact">
            <Setter Property="Padding" Value="0" />
            <Setter Property="MinHeight" Value="0" />
        </Style>

        <Style Selector="TabControl.compact TabItem">
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style Selector="Button.candidate">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="22" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderStrong}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>

        <Style Selector="Button.candidate.selected">
            <Setter Property="BorderBrush" Value="{DynamicResource TextPrimary}" />
            <Setter Property="BorderThickness" Value="2" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="10" Spacing="7" Width="286">

        <TabControl x:Name="Tabs" Classes="compact">
            <!-- ① H/S 平面 + Hue 横条 + Value 竖条 -->
            <TabItem>
                <TabItem.Header>
                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center">
                        <Canvas Width="16" Height="16">
                            <Ellipse Canvas.Left="1" Canvas.Top="1" Width="14" Height="14"
                                     Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4" />
                            <Path Data="M8,1 A7,7 0 0 1 15,8 L8,8 Z"
                                  Fill="{DynamicResource TextSecondary}" />
                        </Canvas>
                    </Viewbox>
                </TabItem.Header>

                <Grid RowDefinitions="*,18" ColumnDefinitions="*,18"
                      RowSpacing="6" ColumnSpacing="6"
                      Width="238" Height="238" HorizontalAlignment="Center">
                    <Border Grid.Row="0" Grid.Column="0" CornerRadius="3" ClipToBounds="True"
                            BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1">
                        <Grid>
                            <primitives:ColorSpectrum x:Name="Spectrum"
                                                      Components="HueSaturation"
                                                      Shape="Box"
                                                      MinWidth="0" MinHeight="0" />
                            <Canvas x:Name="CrosshairLayer" IsHitTestVisible="False">
                                <Grid x:Name="CrosshairGlyph" Width="9" Height="9" IsHitTestVisible="False">
                                    <!-- 绝对色：简单细十字，黑白双层，不做粗重装饰。 -->
                                    <Path Data="M4.5,0 L4.5,9 M0,4.5 L9,4.5"
                                          Stroke="#B0000000" StrokeThickness="2" />
                                    <Path Data="M4.5,0 L4.5,9 M0,4.5 L9,4.5"
                                          Stroke="White" StrokeThickness="1" />
                                </Grid>
                            </Canvas>
                        </Grid>
                    </Border>

                    <fw:GradientBar x:Name="ValueBar"
                                    Grid.Row="0" Grid.Column="1"
                                    Orientation="Vertical"
                                    Minimum="0" Maximum="100"
                                    BorderBrush="{DynamicResource BorderStrong}"
                                    Cursor="Hand" />

                    <fw:GradientBar x:Name="HueBar"
                                    Grid.Row="1" Grid.Column="0"
                                    Orientation="Horizontal"
                                    Minimum="0" Maximum="360"
                                    BorderBrush="{DynamicResource BorderStrong}"
                                    Cursor="Hand" />
                </Grid>
            </TabItem>

            <!-- ② 整体 RGB + 三条 RGB 滑轨 -->
            <TabItem>
                <TabItem.Header>
                    <Viewbox Width="13" Height="13" HorizontalAlignment="Center">
                        <Canvas Width="16" Height="16">
                            <Path Data="M2,3 L14,3 M2,8 L14,8 M2,13 L14,13"
                                  Stroke="{DynamicResource TextSecondary}" StrokeThickness="1.4" />
                            <Ellipse Canvas.Left="4" Canvas.Top="1" Width="4" Height="4"
                                     Fill="{DynamicResource TextSecondary}" />
                            <Ellipse Canvas.Left="10" Canvas.Top="6" Width="4" Height="4"
                                     Fill="{DynamicResource TextSecondary}" />
                            <Ellipse Canvas.Left="6" Canvas.Top="11" Width="4" Height="4"
                                     Fill="{DynamicResource TextSecondary}" />
                        </Canvas>
                    </Viewbox>
                </TabItem.Header>

                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4" Height="238">
                    <Grid Grid.Row="0" ColumnDefinitions="*,*,*" ColumnSpacing="6">
                        <StackPanel Grid.Column="0" Spacing="2">
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="R" />
                            <TextBox x:Name="RBox" MaxLength="3" TextAlignment="Right"
                                     FontSize="11" MinHeight="26" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="G" />
                            <TextBox x:Name="GBox" MaxLength="3" TextAlignment="Right"
                                     FontSize="11" MinHeight="26" VerticalContentAlignment="Center" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="B" />
                            <TextBox x:Name="BBox" MaxLength="3" TextAlignment="Right"
                                     FontSize="11" MinHeight="26" VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="6">
                        <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10"
                                   Foreground="{DynamicResource TextSecondary}" Text="HEX" />
                        <TextBox x:Name="HexBox" Grid.Column="1" FontSize="11" MinHeight="26"
                                 MaxLength="7" />
                    </Grid>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,34"
                          RowDefinitions="*,*,*" RowSpacing="3" ColumnSpacing="6">
                        <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="R" />
                        <fw:GradientBar x:Name="RBar" Grid.Row="0" Grid.Column="1"
                                        Orientation="Horizontal" Minimum="0" Maximum="255"
                                        Height="18" BorderBrush="{DynamicResource BorderStrong}"
                                        Cursor="Hand" />
                        <TextBlock x:Name="RValue" Grid.Row="0" Grid.Column="2"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}" Text="0" />

                        <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="G" />
                        <fw:GradientBar x:Name="GBar" Grid.Row="1" Grid.Column="1"
                                        Orientation="Horizontal" Minimum="0" Maximum="255"
                                        Height="18" BorderBrush="{DynamicResource BorderStrong}"
                                        Cursor="Hand" />
                        <TextBlock x:Name="GValue" Grid.Row="1" Grid.Column="2"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}" Text="0" />

                        <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                                   FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="B" />
                        <fw:GradientBar x:Name="BBar" Grid.Row="2" Grid.Column="1"
                                        Orientation="Horizontal" Minimum="0" Maximum="255"
                                        Height="18" BorderBrush="{DynamicResource BorderStrong}"
                                        Cursor="Hand" />
                        <TextBlock x:Name="BValue" Grid.Row="2" Grid.Column="2"
                                   VerticalAlignment="Center" HorizontalAlignment="Right"
                                   FontSize="10" Foreground="{DynamicResource TextMuted}" Text="0" />
                    </Grid>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 当前色预览 + 竖线 + 候选色（第一格 = 用户当前色，其后是推荐色） -->
        <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="7">
            <Border x:Name="Preview" Grid.Column="0" Width="28" Height="28" CornerRadius="3"
                    BorderBrush="{DynamicResource BorderStrong}" BorderThickness="1" />
            <Border Grid.Column="1" Width="1" Background="{DynamicResource BorderDefault}" />
            <StackPanel Grid.Column="2" Spacing="3">
                <TextBlock FontSize="10" Foreground="{DynamicResource TextSecondary}"
                           Text="{loc:Tr picker.recommended}" />
                <ItemsControl x:Name="RecommendedColors">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="views:ColorCandidate">
                            <Button Classes="candidate"
                                    Classes.selected="{Binding IsSelected}"
                                    Background="{Binding Brush}"
                                    ToolTip.Tip="{Binding Label}"
                                    Click="OnPickCandidate" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="6">
            <Button x:Name="ResetButton" IsVisible="False" />
            <Button x:Name="ConfirmButton" Content="{loc:Tr picker.confirm}" MinWidth="72" />
            <Button x:Name="CancelButton" Content="{loc:Tr picker.cancel}" MinWidth="72" />
        </StackPanel>
    </StackPanel>
</Window>
