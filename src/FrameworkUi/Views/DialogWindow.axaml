<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
        xmlns:views="using:HYWDebugAssistant.FrameworkUi.Views"
        x:Class="HYWDebugAssistant.FrameworkUi.Views.DialogWindow"
        MinWidth="420" MinHeight="300"
        MaxWidth="1080" MaxHeight="880"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgModule}"
        FontSize="12">

    <!--
      通用弹窗宿主（R-3）：外壳的四个功能一律**弹窗**而非常驻侧栏。
      非模态：可以一边看着桌面上的模块窗口一边操作（`11` §3「非模态优先」）。
      **尺寸自适应【M1-16 / ADR-0038 D3】**：由内容决定（`SizeToContent=WidthAndHeight`），
      上限 MaxWidth/MaxHeight（超限时内容区自身滚动）—— 修掉"弹窗大小与内容不匹配"。
    -->
    <ContentControl Name="Body" />
</Window>
