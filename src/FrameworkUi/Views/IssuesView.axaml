<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HYWDebugAssistant.FrameworkUi.ViewModels"
             xmlns:ui="using:HYWDebugAssistant.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             x:Class="HYWDebugAssistant.FrameworkUi.Views.IssuesView"
             x:DataType="vm:IssuesPanelViewModel"
             xmlns:design="using:HYWDebugAssistant.FrameworkUi.Design"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             d:DataContext="{x:Static design:ShellDesignData.Issues}"
             d:DesignWidth="780" d:DesignHeight="620"
             FontSize="12">

    <UserControl.Styles>
        <Style Selector="Button.sevFilter">
            <Setter Property="MinHeight" Value="26" />
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderDefault}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="3" />
        </Style>
        <Style Selector="Button.sevFilter.active">
            <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimary}" />
            <Setter Property="Foreground" Value="{DynamicResource AccentPrimary}" />
        </Style>

        <Style Selector="Ellipse.sevDot">
            <Setter Property="Width" Value="8" />
            <Setter Property="Height" Value="8" />
            <Setter Property="Fill" Value="{DynamicResource TextMuted}" />
        </Style>
        <Style Selector="Ellipse.sevDot.error">
            <Setter Property="Fill" Value="{DynamicResource SemanticError}" />
        </Style>
        <Style Selector="Ellipse.sevDot.warning">
            <Setter Property="Fill" Value="{DynamicResource SemanticWarn}" />
        </Style>
        <Style Selector="Ellipse.sevDot.info">
            <Setter Property="Fill" Value="{DynamicResource SemanticIdle}" />
        </Style>

        <Style Selector="TextBlock.sevText">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.sevText.error">
            <Setter Property="Foreground" Value="{DynamicResource SemanticError}" />
        </Style>
        <Style Selector="TextBlock.sevText.warning">
            <Setter Property="Foreground" Value="{DynamicResource SemanticWarn}" />
        </Style>
        <Style Selector="TextBlock.sevText.info">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style Selector="TextBlock.unread">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.mutedSmall">
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}" />
        </Style>

        <!-- 选中行用淡主题色（Fluent 默认选中是强强调色，深色文字压不住） -->
        <Style Selector="ListBoxItem">
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
        </Style>
        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource OverlaySelection}" />
        </Style>
    </UserControl.Styles>

    <!--
      Issue 弹窗：列表负责扫描，详情负责完整信息。
      列表不再使用横向 ScrollViewer + 固定列宽（那会把消息列压成不可换行并被裁切）。
    -->
    <Grid RowDefinitions="Auto,Auto,Auto,Auto,*" Margin="10">

        <!-- 汇总 + 全局操作 -->
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <StackPanel Grid.Column="0" Spacing="2">
                <TextBlock Text="{Binding Summary}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusMessage}" Classes="mutedSmall" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Top">
                <Button Content="{loc:Tr issues.markAllRead}" Command="{Binding MarkAllReadCommand}"
                        IsEnabled="{Binding HasIssues}"
                        ToolTip.Tip="{loc:Tr issues.markAllRead.tip}" />
                <Button Content="{loc:Tr issues.clearAll}" Command="{Binding BeginClearCommand}"
                        IsEnabled="{Binding HasIssues}" />
            </StackPanel>
        </Grid>

        <!-- 搜索 / 类别 / 来源 / 只看未读 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
            <TextBox Width="200" PlaceholderText="{loc:Tr issues.search.placeholder}"
                     Text="{Binding SearchText, Mode=TwoWay}" />
            <ComboBox Width="130" ItemsSource="{Binding CategoryOptions}"
                      SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                      ToolTip.Tip="{loc:Tr issues.filter.category.tip}" />
            <ComboBox Width="110" ItemsSource="{Binding SourceOptions}"
                      SelectedItem="{Binding SelectedSource, Mode=TwoWay}"
                      ToolTip.Tip="{loc:Tr issues.filter.source.tip}" />
            <ui:UiToggle Content="{loc:Tr issues.filter.onlyUnread}" IsChecked="{Binding OnlyUnread, Mode=TwoWay}" />
        </StackPanel>

        <!-- 严重度过滤 + 当前显示条数 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,6,0,0">
            <ItemsControl Grid.Column="0" ItemsSource="{Binding SeverityFilters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="vm:IssueSeverityFilterViewModel">
                        <Button Classes="sevFilter" Classes.active="{Binding IsSelected}"
                                Click="OnSelectSeverity">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <TextBlock Text="{Binding Label}" />
                                <TextBlock Text="{Binding Count}" Classes="mutedSmall" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Grid.Column="1" Classes="mutedSmall" VerticalAlignment="Center"
                       Text="{Binding FilteredCountText}" />
        </Grid>

        <!-- 清空全部：非模态内联确认 -->
        <Border Grid.Row="3" IsVisible="{Binding IsConfirmingClear}"
                Margin="0,6,0,0" Padding="8,6"
                Background="{DynamicResource OverlayHighlight}"
                BorderBrush="{DynamicResource SemanticWarn}"
                BorderThickness="1" CornerRadius="3">
            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6">
                <TextBlock Grid.Column="0" Text="{loc:Tr issues.clearConfirm.message}"
                           Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{loc:Tr issues.clearConfirm.confirm}" Command="{Binding ConfirmClearCommand}" />
                <Button Grid.Column="2" Content="{loc:Tr common.cancel}" Command="{Binding CancelClearCommand}" />
            </Grid>
        </Border>

        <!-- 列表 + 详情 -->
        <Grid Grid.Row="4" ColumnDefinitions="*,1,320" Margin="0,8,0,0">
            <Border Grid.Column="0" Background="{DynamicResource BgModule}"
                    BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="3">
                <Panel>
                    <ListBox ItemsSource="{Binding Issues}"
                             SelectedItem="{Binding SelectedIssue, Mode=TwoWay}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="2"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="vm:IssueRowViewModel">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8" Margin="4,4"
                                      MinHeight="38">
                                    <Ellipse Grid.Column="0" Classes="sevDot"
                                             Classes.error="{Binding IsError}"
                                             Classes.warning="{Binding IsWarning}"
                                             Classes.info="{Binding IsInfo}"
                                             VerticalAlignment="Top" Margin="0,4,0,0" />
                                    <StackPanel Grid.Column="1" Spacing="2">
                                        <TextBlock Text="{Binding ObjectLabel}"
                                                   Classes.unread="{Binding IsUnread}"
                                                   FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding MessagePreview}"
                                                   Classes.unread="{Binding IsUnread}"
                                                   FontSize="11" Foreground="{DynamicResource TextSecondary}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" Spacing="4" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding TimeText}" Classes="mutedSmall"
                                                   HorizontalAlignment="Right" />
                                        <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentPrimary}"
                                                 HorizontalAlignment="Right"
                                                 IsVisible="{Binding IsUnread}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <TextBlock IsVisible="{Binding !HasFilteredIssues}"
                               Margin="18" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"
                               Text="{loc:Tr issues.empty.filtered}" />
                </Panel>
            </Border>

            <Rectangle Grid.Column="1" Fill="{DynamicResource BorderDefault}" />

            <Border Grid.Column="2" Background="{DynamicResource BgModule}"
                    BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="3"
                    Padding="10">
                <Panel>
                    <TextBlock IsVisible="{Binding !HasSelection}"
                               Margin="4" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMuted}"
                               Text="{loc:Tr issues.empty.noSelection}" />

                    <Grid IsVisible="{Binding HasSelection}" RowDefinitions="Auto,Auto,*,Auto">
                        <StackPanel Grid.Row="0" Spacing="4">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Text="{Binding SelectedIssue.SeverityLabel}"
                                           Classes="sevText"
                                           Classes.error="{Binding SelectedIssue.IsError}"
                                           Classes.warning="{Binding SelectedIssue.IsWarning}"
                                           Classes.info="{Binding SelectedIssue.IsInfo}" />
                                <TextBlock Text="·" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding SelectedIssue.CategoryLabel}"
                                           Foreground="{DynamicResource TextSecondary}" />
                                <TextBlock Text="·" Foreground="{DynamicResource TextMuted}" />
                                <TextBlock Text="{Binding SelectedIssue.SourceLabel}" Classes="mutedSmall"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <TextBlock Text="{Binding SelectedIssue.FullTimeText}" Classes="mutedSmall" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" Spacing="3" Margin="0,8,0,0">
                            <TextBlock Text="{loc:Tr issues.detail.label.object}" Classes="mutedSmall" />
                            <SelectableTextBlock Text="{Binding SelectedIssue.ObjectLabel}"
                                                 FontSize="11" Foreground="{DynamicResource TextPrimary}"
                                                 TextWrapping="Wrap" />
                            <SelectableTextBlock Text="{Binding SelectedIssue.ObjectPath}"
                                                 FontFamily="{DynamicResource FontData}" FontSize="10"
                                                 Foreground="{DynamicResource TextMuted}"
                                                 TextWrapping="Wrap" />
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" Margin="0,8,0,0"
                                      HorizontalScrollBarVisibility="Disabled"
                                      VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="3">
                                <TextBlock Text="{loc:Tr issues.detail.label.message}" Classes="mutedSmall" />
                                <SelectableTextBlock Text="{Binding SelectedIssue.Message}"
                                                     FontSize="11"
                                                     Foreground="{DynamicResource TextPrimary}"
                                                     TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>

                        <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="6" Margin="0,8,0,0">
                            <Button Content="{loc:Tr issues.action.copyMessage}" Click="OnCopyMessage"
                                    IsEnabled="{Binding HasSelection}" />
                            <Button Content="{loc:Tr issues.action.copyDetail}" Click="OnCopyDetail"
                                    IsEnabled="{Binding HasSelection}" />
                            <Button Content="{loc:Tr issues.action.markUnread}"
                                    IsVisible="{Binding SelectedIssue.IsRead}"
                                    Command="{Binding ToggleSelectedReadCommand}" />
                            <Button Content="{loc:Tr issues.action.markRead}"
                                    IsVisible="{Binding SelectedIssue.IsUnread}"
                                    Command="{Binding ToggleSelectedReadCommand}" />
                            <Button Content="{loc:Tr issues.action.delete}" Command="{Binding DeleteSelectedCommand}"
                                    IsEnabled="{Binding HasSelection}" />
                        </StackPanel>
                    </Grid>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
