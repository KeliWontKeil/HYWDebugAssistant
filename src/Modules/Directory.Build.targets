<Project>
  <!--
    仓库内模块：包根统一到 `artifacts/modules/<配置>`；
    归拢规则与外部作者**共用同一份** `build/module-package.targets`（单一来源）。
  -->
  <PropertyGroup>
    <ModulePackageRoot Condition="'$(ModulePackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\modules\$(Configuration)\</ModulePackageRoot>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)..\..\build\module-package.targets" />
</Project>
