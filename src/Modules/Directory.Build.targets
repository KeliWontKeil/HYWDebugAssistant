<Project>

  <!--
    模块包归拢（M1-17 / ADR-0036 D2）：模块项目**构建即产出**到统一包目录，应用构建后再镜像到应用输出。
    目的：包"永远是新的"，且模块作者不需要手工拷贝、不需要改任何脚本 —— 新增模块项目零改动。

    约定：
      · 判定"是模块项目"的依据 = 项目目录下存在 module.json（不引入额外开关）；
      · 包目录名 = $(ModulePackageName)，缺省取项目名最后一个点段（可在模块项目里显式指定更友好的名字）；
      · 每个包目录**先清空再复制**，避免新旧程序集混放导致"改了代码没生效"的假象。
  -->
  <PropertyGroup>
    <ModulePackageName Condition="'$(ModulePackageName)' == ''">$(MSBuildProjectName.Substring($([MSBuild]::Add($(MSBuildProjectName.LastIndexOf('.')), 1))))</ModulePackageName>
    <ModulePackageRoot Condition="'$(ModulePackageRoot)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\modules</ModulePackageRoot>
    <ModulePackageDirectory>$(ModulePackageRoot)\$(ModulePackageName)</ModulePackageDirectory>
  </PropertyGroup>

  <Target Name="StageModulePackage"
          AfterTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\module.json')">

    <ItemGroup>
      <ModulePackageFile Include="$(TargetDir)**\*" />
    </ItemGroup>

    <RemoveDir Directories="$(ModulePackageDirectory)" Condition="Exists('$(ModulePackageDirectory)')" />
    <MakeDir Directories="$(ModulePackageDirectory)" />
    <Copy SourceFiles="@(ModulePackageFile)"
          DestinationFolder="$(ModulePackageDirectory)\%(RecursiveDir)"
          SkipUnchangedFiles="true" />

    <Message Importance="high" Text="[module-pkg] $(ModulePackageName) → $(ModulePackageDirectory)" />
  </Target>

</Project>
