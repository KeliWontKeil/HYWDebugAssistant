<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:views="using:HYWDebugAssistant.Modules.ScaleBarVertical.Views"
               xmlns:local="using:HYWDebugAssistant.Modules.ScaleBarVertical"
               x:Class="HYWDebugAssistant.Modules.ScaleBarVertical.Views.ScaleBarVerticalView"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               InitialWidth="100" InitialHeight="400"
               MinWidth="100" MinHeight="200">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:ScaleBarVerticalModule.InPort}"
                   Direction="Receive"
                   TypeId="{x:Static local:ScaleBarVerticalModule.WaveformTypeId}"
                   Edge="Left"/>
  </ui:ModuleView.Ports>

  <!--
    文字带与横向刻度条同构：一条带 + 一根条；只是竖向模块把文字带放在条的**左侧**（沿条的长轴），
    这样宽度方向只占一列文字，模块可以收窄；文字仍不由刻度条控件画。
  -->
  <Panel>
    <Grid RowDefinitions="24,48,*" RowSpacing="2" Margin="2">
      <Grid Grid.Row="0" ColumnDefinitions="*,20" ColumnSpacing="4">
        <ui:ModuleLabel x:Name="Summary" Grid.Column="0" Classes="micro"
                        VerticalAlignment="Center" HorizontalAlignment="Right"
                        Text="{loc:Tr view.summaryPreview}"
                        ToolTip.Tip="{loc:Tr view.summaryTip}" />
        <ui:ModuleButton x:Name="SettingsButton" Grid.Column="1" Classes="icon" Width="20" Height="20"
                         HorizontalAlignment="Left"
                         Icon="{x:Static views:ScaleBarVerticalViewKeys.IconSettings}"
                         ToolTip.Tip="{loc:Tr view.settings}" />
      </Grid>

      <Grid Grid.Row="1" ColumnDefinitions="Auto,*" ColumnSpacing="4" HorizontalAlignment="Center">
        <StackPanel Grid.Column="0" Orientation="Vertical" Spacing="2" 
                    VerticalAlignment="Center" Margin="4,0,0,0">
          <ui:ModuleLabel x:Name="Title" Classes="caption" MaxWidth="64"
                          HorizontalAlignment="Center"
                          Text="{loc:Tr view.titlePreview}" />
          <ui:ModuleNumeric x:Name="Value" MaxWidth="64"
                            HorizontalAlignment="Center"
                            Source="{x:Static views:ScaleBarVerticalViewKeys.Value}"
                            Decimals="2" Text="{loc:Tr view.valuePreview}" />
          <ui:ModuleLabel x:Name="Unit" Classes="micro" MaxWidth="64"
                          HorizontalAlignment="Center"
                          Text="{loc:Tr view.unitPreview}" />
        </StackPanel>

      </Grid>

      <Grid Grid.Row="2" ColumnDefinitions="Auto,*" ColumnSpacing="4">
        <ui:ScaleBar x:Name="ScaleBar" Grid.Column="1" Margin="12,0,0,0" 
                     HorizontalAlignment="Center" VerticalAlignment="Top"
                     Orientation="Vertical"
                     Minimum="0" Maximum="100" Value="42"
                     BarThickness="18" Padding="0"
                     ShowLabels="True" FillOrigin="Zero" />
      </Grid>
    </Grid>

    <ui:ModulePopupPanel x:Name="SettingsPanel"
                         PanelType="{x:Type views:ScaleBarSettingsPanel}"
                         Title="{loc:Tr view.settings}"
                         ResetCommandName="{x:Static views:ScaleBarVerticalViewKeys.ResetSettings}" />
  </Panel>
</ui:ModuleView>
