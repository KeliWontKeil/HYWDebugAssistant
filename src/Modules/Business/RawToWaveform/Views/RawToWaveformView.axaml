<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:local="using:HYWDebugAssistant.Modules.RawToWaveform"
               x:Class="HYWDebugAssistant.Modules.RawToWaveform.Views.RawToWaveformView"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               InitialWidth="360" InitialHeight="172"
               MinWidth="360" MinHeight="172">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:RawToWaveformModule.InPort}"
                   Direction="Receive"
                   TypeId="{x:Static local:RawToWaveformModule.RawBytesTypeId}"
                   Edge="Top" />
    <ui:ModulePort Name="{x:Static local:RawToWaveformModule.OutPort}"
                   Direction="Send"
                   TypeId="{x:Static local:RawToWaveformModule.WaveformTypeId}"
                   Edge="Bottom" />
  </ui:ModuleView.Ports>

  <!--
    原始 → 波形：参数、协议说明、读数、状态、计数全部绝对定位。
    **坐标只写在这一个文件里**（唯一视图事实源，预览器直接看这里）：
      · 参数行 = 右对齐标签贴住编辑器，两者同高同中线；
      · 协议说明两行随协议切换，默认写文本帧的文案，预览器不刷新也能看到；
      · 计数行 = 标签 / 读数 + 右侧图标按钮；
      · 可隐藏的参数行只留固定空档，其余行不重排。
    具体数值以本文件的布局属性为准；内容区尺寸 = 窗口 − 描边 − 预留带（唯一算法见 `ModuleSurfaceMetrics`）。
  -->
  <Canvas ClipToBounds="True">

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="1" Width="48" Height="24"
                    Classes="caption right" Field="{x:Static local:RawToWaveformModule.ProtocolField}" />
    <ui:ModuleConfigField Canvas.Left="52" Canvas.Top="1" Width="140" Height="24"
                          Field="{x:Static local:RawToWaveformModule.ProtocolField}" />

    <ui:ModuleLabel Name="ProtocolDefinition" Canvas.Left="0" Canvas.Top="27" Width="350" Height="16"
                    Classes="hint" Text="{loc:Tr proto.textFrame.def}"
                    TextTrimming="CharacterEllipsis" ToolTip.Tip="{loc:Tr proto.textFrame.def}" />
    <ui:ModuleLabel Name="ProtocolSample" Canvas.Left="0" Canvas.Top="45" Width="350" Height="16"
                    Classes="micro" Text="{loc:Tr proto.textFrame.sample}"
                    TextTrimming="CharacterEllipsis" ToolTip.Tip="{loc:Tr proto.textFrame.sample}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="67" Width="60" Height="24"
                    Classes="caption right" Field="{x:Static local:RawToWaveformModule.GroupIdField}" />
    <ui:ModuleConfigField Canvas.Left="64" Canvas.Top="67" Width="72" Height="24"
                          Field="{x:Static local:RawToWaveformModule.GroupIdField}" />
    <ui:ModuleLabel Canvas.Left="144" Canvas.Top="67" Width="44" Height="24"
                    Classes="caption right" Field="{x:Static local:RawToWaveformModule.RateField}" />
    <ui:ModuleConfigField Canvas.Left="192" Canvas.Top="67" Width="72" Height="24"
                          Field="{x:Static local:RawToWaveformModule.RateField}" />

    <Canvas Name="TextParams" Canvas.Left="0" Canvas.Top="93" Width="300" Height="24">
      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="48" Height="24"
                      Classes="caption right" Field="{x:Static local:RawToWaveformModule.HeaderField}" />
      <ui:ModuleConfigField Canvas.Left="52" Canvas.Top="0" Width="88" Height="24"
                            Field="{x:Static local:RawToWaveformModule.HeaderField}" />
      <ui:ModuleLabel Canvas.Left="148" Canvas.Top="0" Width="36" Height="24"
                      Classes="caption right" Field="{x:Static local:RawToWaveformModule.FooterField}" />
      <ui:ModuleConfigField Canvas.Left="184" Canvas.Top="0" Width="88" Height="24"
                            Field="{x:Static local:RawToWaveformModule.FooterField}" />
    </Canvas>

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="121" Width="48" Height="20"
                    Classes="caption" Text="{loc:Tr view.channels}" />
    <ui:ModuleNumeric Canvas.Left="52" Canvas.Top="121" Width="48" Height="20" Text="0"
                      Source="{x:Static local:RawToWaveformModule.ChannelCountSource}" />
    <ui:ModuleLabel Canvas.Left="108" Canvas.Top="121" Width="250" Height="20" Classes="hint"
                    Text="{loc:Tr state.ready}"
                    Source="{x:Static local:RawToWaveformModule.StatusSource}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="150" Width="44" Height="16"
                    Classes="micro" Text="{loc:Tr view.frames}" />
    <ui:ModuleNumeric Canvas.Left="48" Canvas.Top="148" Width="48" Height="20" Text="0"
                      Source="{x:Static local:RawToWaveformModule.FramesSource}" />
    <ui:ModuleLabel Canvas.Left="104" Canvas.Top="150" Width="32" Height="16"
                    Classes="micro" Text="{loc:Tr view.dropped}" />
    <ui:ModuleNumeric Canvas.Left="140" Canvas.Top="148" Width="48" Height="20" Text="0"
                      Source="{x:Static local:RawToWaveformModule.DroppedSource}" />

    <ui:ModuleButton Classes="icon" Canvas.Left="340" Canvas.Top="148" Width="16" Height="16"
                     Icon="{x:Static local:RawToWaveformModule.ClearStatsIcon}"
                     CommandName="{x:Static local:RawToWaveformModule.ResetCommand}"
                     ToolTip.Tip="{loc:Tr view.reset}" />
  </Canvas>
</ui:ModuleView>
