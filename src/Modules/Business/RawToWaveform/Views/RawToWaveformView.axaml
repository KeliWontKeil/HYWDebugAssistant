<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:local="using:HYWDebugAssistant.Modules.RawToWaveform"
               x:Class="HYWDebugAssistant.Modules.RawToWaveform.Views.RawToWaveformView"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               InitialWidth="400" InitialHeight="200"
               MinWidth="400" MinHeight="190">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:RawToWaveformModule.InPort}"
                   Direction="Receive"
                   TypeId="{x:Static local:RawToWaveformModule.RawBytesTypeId}"
                   Edge="Top" />
    <ui:ModulePort Name="{x:Static local:RawToWaveformModule.OutPort}"
                   Direction="Send"
                   TypeId="{x:Static local:RawToWaveformModule.WaveformTypeId}"
                   Edge="Bottom" />
  </ui:ModuleView.Ports>

  <!--
    原始 → 波形：顶部一行放协议与参数，帧信息纵向堆叠并随协议折叠。
    **坐标只写在这一个文件里**（唯一视图事实源，预览器直接看这里）：
      · 协议是配置字段；组号/采样率/帧头/帧尾/前缀是输入源，逐键写、模块每拍读并应用；
      · 说明两行在参数区之下；
      · 统计只有一行（通道数量 / 已转换 / 丢弃 + 清空图标）；状态句单独贴底。
    具体数值以本文件的布局属性为准；内容区尺寸 = 窗口 − 描边 − 预留带（唯一算法见 `ModuleSurfaceMetrics`）。
  -->
  <Canvas ClipToBounds="True">

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="10" Width="42" Height="24"
                    Classes="caption right" Field="{x:Static local:RawToWaveformModule.ProtocolField}" />
    <ui:ModuleSelect Canvas.Left="44" Canvas.Top="10" Width="100" Height="24"
                     Value="{x:Static local:RawToWaveformModule.ProtocolField}"
                     SelectedKey="TextFrame">
      <ui:ModuleSelect.PreviewOptions>
        <ui:ModuleSelectOption Key="TextFrame" Label="{loc:Tr choice.textFrame}" />
        <ui:ModuleSelectOption Key="FireWater" Label="{loc:Tr choice.fireWater}" />
        <ui:ModuleSelectOption Key="JustFloat" Label="{loc:Tr choice.justFloat}" />
      </ui:ModuleSelect.PreviewOptions>
    </ui:ModuleSelect>

    <ui:ModuleLabel Canvas.Left="148" Canvas.Top="10" Width="30" Height="24"
                    Classes="caption right" Text="{loc:Tr view.groupShort}" />
    <ui:ModuleTextSurface Canvas.Left="180" Canvas.Top="10" Width="36" Height="24" Mode="Input"
                          Value="{x:Static local:RawToWaveformModule.GroupIdInput}"
                          Text="1" TextAlignment="Right"
                          CommitMode="OnChange" />

    <ui:ModuleLabel Canvas.Left="220" Canvas.Top="10" Width="44" Height="24"
                    Classes="caption right" Text="{loc:Tr field.rate}" />
    <ui:ModuleTextSurface Canvas.Left="266" Canvas.Top="10" Width="50" Height="24" Mode="Input"
                          Value="{x:Static local:RawToWaveformModule.RateInput}"
                          Text="1000" TextAlignment="Right"
                          CommitMode="OnChange" />
    <ui:ModuleLabel Canvas.Left="318" Canvas.Top="10" Width="24" Height="24"
                    Classes="caption" Text="{loc:Tr unit.hz}" />

    <ui:ModuleLabel Name="ProtocolDefinition" Canvas.Left="0" Canvas.Top="74" Width="350" Height="16"
                    Classes="hint" Text="{loc:Tr proto.textFrame.def}"
                    TextTrimming="CharacterEllipsis" ToolTip.Tip="{loc:Tr proto.textFrame.def}" />
    <ui:ModuleLabel Name="ProtocolSample" Canvas.Left="0" Canvas.Top="90" Width="350" Height="16"
                    Classes="micro " Text="{loc:Tr proto.textFrame.sample}"
                    TextTrimming="CharacterEllipsis" ToolTip.Tip="{loc:Tr proto.textFrame.sample}" />

    <StackPanel Name="ParamFlow" Canvas.Left="0" Canvas.Top="36" Width="356">

      <Canvas Name="TextParams" Width="356" Height="24">
        <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="42" Height="24"
                        Classes="caption right" Text="{loc:Tr field.header}" />
        <ui:ModuleTextSurface Canvas.Left="44" Canvas.Top="0" Width="88" Height="24" Mode="Input"
                              Value="{x:Static local:RawToWaveformModule.HeaderInput}"
                              Text="ab" CommitMode="OnChange" />
        <ui:ModuleLabel Canvas.Left="134" Canvas.Top="0" Width="42" Height="24"
                        Classes="caption right" Text="{loc:Tr field.footer}" />
        <ui:ModuleTextSurface Canvas.Left="178" Canvas.Top="0" Width="88" Height="24" Mode="Input"
                              Value="{x:Static local:RawToWaveformModule.FooterInput}"
                              Text="cd" CommitMode="OnChange" />
      </Canvas>

      <Canvas Name="FireWaterParams" Width="356" Height="24">
        <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="42" Height="24"
                        Classes="caption right" Text="{loc:Tr field.prefix}" />
        <ui:ModuleTextSurface Canvas.Left="44" Canvas.Top="0" Width="88" Height="24" Mode="Input"
                              Value="{x:Static local:RawToWaveformModule.PrefixInput}"
                              Text="" ToolTip.Tip="{loc:Tr field.prefix.hint}"
                              CommitMode="OnChange" />
      </Canvas>
    </StackPanel>

    <Canvas Canvas.Left="0" Canvas.Top="106" Width="356" Height="20">
      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="48" Height="20"
                      Classes="caption" Text="{loc:Tr view.channels}" />
      <ui:ModuleNumeric Canvas.Left="52" Canvas.Top="0" Width="44" Height="20" Text="0"
                        Source="{x:Static local:RawToWaveformModule.ChannelCountSource}" />
      <ui:ModuleLabel Canvas.Left="104" Canvas.Top="2" Width="44" Height="16"
                      Classes="caption" Text="{loc:Tr view.frames}" />
      <ui:ModuleNumeric Canvas.Left="152" Canvas.Top="0" Width="44" Height="20" Text="0"
                        Source="{x:Static local:RawToWaveformModule.FramesSource}" />
      <ui:ModuleLabel Canvas.Left="204" Canvas.Top="2" Width="32" Height="16"
                      Classes="caption" Text="{loc:Tr view.dropped}" />
      <ui:ModuleNumeric Canvas.Left="240" Canvas.Top="0" Width="44" Height="20" Text="0"
                        Source="{x:Static local:RawToWaveformModule.DroppedSource}" />
      <ui:ModuleButton Classes="icon" Canvas.Left="320" Canvas.Top="2" Width="16" Height="16"
                       Icon="{x:Static local:RawToWaveformModule.ClearStatsIcon}"
                       CommandName="{x:Static local:RawToWaveformModule.ResetCommand}"
                       ToolTip.Tip="{loc:Tr view.reset}" />
    </Canvas>

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="127" Width="356" Height="16" Classes="hint"
                    Text="{loc:Tr state.ready}"
                    Source="{x:Static local:RawToWaveformModule.StatusSource}" />
  </Canvas>
</ui:ModuleView>
