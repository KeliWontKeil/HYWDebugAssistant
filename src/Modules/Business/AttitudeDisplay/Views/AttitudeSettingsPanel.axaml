<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:views="using:HYWDebugAssistant.Modules.AttitudeDisplay.Views"
               x:Class="HYWDebugAssistant.Modules.AttitudeDisplay.Views.AttitudeSettingsPanel"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               InitialWidth="320" InitialHeight="430">

  <!-- 面板正文 = 独立视图：固定尺寸表单用 Canvas 绝对坐标，坐标只写在这里。 -->
  <Canvas ClipToBounds="True">
    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="8" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.group}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="8" Width="216" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:AttitudeDisplayViewKeys.Group}"
                          Text="0"
                          ToolTip.Tip="{loc:Tr view.groupTip}" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="38" Width="64" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.rollChannel}" />
    <ui:ModuleTextSurface Canvas.Left="74" Canvas.Top="38" Width="34" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:AttitudeDisplayViewKeys.RollChannel}"
                          Text="0"
                          ToolTip.Tip="{loc:Tr view.channelTip}" />
    <ui:ModuleLabel Canvas.Left="110" Canvas.Top="38" Width="64" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.pitchChannel}" />
    <ui:ModuleTextSurface Canvas.Left="176" Canvas.Top="38" Width="34" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:AttitudeDisplayViewKeys.PitchChannel}"
                          Text="1"
                          ToolTip.Tip="{loc:Tr view.channelTip}" />
    <ui:ModuleLabel Canvas.Left="212" Canvas.Top="38" Width="64" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.yawChannel}" />
    <ui:ModuleTextSurface Canvas.Left="278" Canvas.Top="38" Width="34" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:AttitudeDisplayViewKeys.YawChannel}"
                          Text="2"
                          ToolTip.Tip="{loc:Tr view.channelTip}" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="68" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.style}" />
    <ui:ModuleSegmentedControl Canvas.Left="96" Canvas.Top="68" Width="216" Height="22"
                               SelectedKey="cube"
                               Value="{x:Static views:AttitudeDisplayViewKeys.Style}">
      <ui:ModuleSegmentedControl.PreviewOptions>
        <ui:ModuleSegmentOption Key="axes" Label="{loc:Tr view.styleAxes}" />
        <ui:ModuleSegmentOption Key="cube" Label="{loc:Tr view.styleCube}" />
        <ui:ModuleSegmentOption Key="drone" Label="{loc:Tr view.styleDrone}" />
      </ui:ModuleSegmentedControl.PreviewOptions>
    </ui:ModuleSegmentedControl>

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="98" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.unit}" />
    <ui:ModuleSegmentedControl Canvas.Left="96" Canvas.Top="98" Width="216" Height="22"
                               SelectedKey="deg"
                               Value="{x:Static views:AttitudeDisplayViewKeys.Unit}">
      <ui:ModuleSegmentedControl.PreviewOptions>
        <ui:ModuleSegmentOption Key="deg" Label="{loc:Tr view.unitDegree}" />
        <ui:ModuleSegmentOption Key="rad" Label="{loc:Tr view.unitRadian}" />
      </ui:ModuleSegmentedControl.PreviewOptions>
    </ui:ModuleSegmentedControl>

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="128" Width="304" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.smoothing}"
                       Value="{x:Static views:AttitudeDisplayViewKeys.Smoothing}" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="158" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.smoothingMs}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="158" Width="216" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:AttitudeDisplayViewKeys.SmoothingMs}"
                          Text="120" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="188" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.zoom}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="188" Width="216" Height="22"
                          Mode="Input" TextFormat="Real" CommitMode="OnChange"
                          Value="{x:Static views:AttitudeDisplayViewKeys.Zoom}"
                          Text="1" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="218" Width="304" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.grid}"
                       Value="{x:Static views:AttitudeDisplayViewKeys.Grid}" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="248" Width="304" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.labels}"
                       Value="{x:Static views:AttitudeDisplayViewKeys.Labels}" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="278" Width="304" Height="24"
                       Content="{loc:Tr view.invertRoll}"
                       Value="{x:Static views:AttitudeDisplayViewKeys.InvertRoll}" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="308" Width="304" Height="24"
                       Content="{loc:Tr view.invertPitch}"
                       Value="{x:Static views:AttitudeDisplayViewKeys.InvertPitch}" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="338" Width="304" Height="24"
                       Content="{loc:Tr view.invertYaw}"
                       Value="{x:Static views:AttitudeDisplayViewKeys.InvertYaw}" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="368" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.lostDelay}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="368" Width="216" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:AttitudeDisplayViewKeys.LostDelay}"
                          Text="1000" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="398" Width="304" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.lostZero}"
                       Value="{x:Static views:AttitudeDisplayViewKeys.LostZero}" />
  </Canvas>
</ui:ModuleView>
