<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.TcpServer.Views"
             xmlns:local="using:HYWDebugAssistant.Modules.TcpServer"
             x:Class="HYWDebugAssistant.Modules.TcpServer.Views.TcpServerView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="400" InitialHeight="200"
             MinWidth="400" MinHeight="165">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:TcpServerModule.RxPort}"
                   Direction="Send"
                   TypeId="{x:Static local:TcpServerModule.RawBytesTypeId}"
                   Edge="Bottom" />
    <ui:ModulePort Name="{x:Static local:TcpServerModule.TxPort}"
                   Direction="Receive"
                   TypeId="{x:Static local:TcpServerModule.RawBytesTypeId}"
                   Edge="Top" />
  </ui:ModuleView.Ports>

  <!--
    TCP 服务端：参数、读数、开关、按钮全部绝对定位。
    **坐标只写在这一个文件里**：参数标签右对齐贴住编辑器、编辑器与标签同中线。
    「已连接 N 路」是三个普通文本元素，在一个声明矩形里靠右紧排（右缘不随数字宽度漂）。
    动作行 = 打开 / 关闭 / 清空：清空是图标按钮，宽度小于文字按钮。
  -->
  <Canvas ClipToBounds="True">

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="1" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:TcpServerViewKeys.LocalAddress}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="1" Width="108" Height="24"
                          Value="{x:Static views:TcpServerViewKeys.LocalAddress}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="27" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:TcpServerViewKeys.LocalPort}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="27" Width="54" Height="24"
                          Value="{x:Static views:TcpServerViewKeys.LocalPort}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="53" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:TcpServerViewKeys.MaxConnections}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="53" Width="108" Height="24"
                          Value="{x:Static views:TcpServerViewKeys.MaxConnections}" />

    <ui:ModuleLabel Canvas.Left="172" Canvas.Top="54" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.rx}" />
    <ui:ModuleNumeric Canvas.Left="210" Canvas.Top="54" Width="54" Height="20"
                      Source="{x:Static views:TcpServerViewKeys.RxCount}" Quantity="Bytes" Text="0 B" />

    <ui:ModuleLabel Canvas.Left="266" Canvas.Top="54" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.tx}" />
    <ui:ModuleNumeric Canvas.Left="304" Canvas.Top="54" Width="54" Height="20"
                      Source="{x:Static views:TcpServerViewKeys.TxCount}" Quantity="Bytes" Text="0 B" />

    <ui:ModuleLabel Canvas.Left="172" Canvas.Top="79" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.drop}" />
    <ui:ModuleNumeric Canvas.Left="210" Canvas.Top="79" Width="54" Height="20"
                      Source="{x:Static views:TcpServerViewKeys.DropCount}" Quantity="Bytes" Text="0 B" />

    <!-- 已连接数：标题 / 值 / 单位靠右紧排在一个声明矩形里。 -->
    <Grid Canvas.Left="152" Canvas.Top="30" Width="74" Height="24">
      <StackPanel Orientation="Horizontal" Spacing="2"
                  HorizontalAlignment="Right" VerticalAlignment="Center">
        <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.connections}" />
        <ui:ModuleNumeric Source="{x:Static views:TcpServerViewKeys.ConnCount}" Text="0" />
        <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.unitConnections}" />
      </StackPanel>
    </Grid>

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="104" Width="358" Height="14"
                    Text="{loc:Tr status.idle}"
                    Source="{x:Static views:TcpServerViewKeys.State}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="76" Width="65" Height="24"
                    Classes="caption right" Field="{x:Static views:TcpServerViewKeys.NoDelay}" />
    <ui:ModuleConfigField Canvas.Left="68" Canvas.Top="77" Width="120" Height="24"
                          Value="{x:Static views:TcpServerViewKeys.NoDelay}" />

          <!-- 右栏：状态灯 + 三格读数。 -->
    <ui:ModuleStatusLight Canvas.Left="180" Canvas.Top="12"
                          Source="{x:Static views:TcpServerViewKeys.Link}" />
    <ui:ModuleButton Canvas.Left="202" Canvas.Top="4" Width="72" Height="27"
                     CommandName="{x:Static views:TcpServerViewKeys.Open}" Content="{loc:Tr view.open}" />
    <ui:ModuleButton Canvas.Left="282" Canvas.Top="4" Width="72" Height="27"
                     CommandName="{x:Static views:TcpServerViewKeys.Close}" Content="{loc:Tr view.close}" />
    <ui:ModuleButton Classes="icon" Canvas.Left="340" Canvas.Top="82" Width="16" Height="16"
                     Icon="{x:Static views:TcpServerViewKeys.ClearCountersIcon}"
                     CommandName="{x:Static views:TcpServerViewKeys.ClearCounters}"
                     ToolTip.Tip="{loc:Tr view.clearCounters}" />
  </Canvas>
</ui:ModuleView>
