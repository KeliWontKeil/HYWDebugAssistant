<Project Sdk="Microsoft.NET.Sdk">

  <!--
    业务模块（第二批 #1）：串口 `hyw/serial`。
    与第三方模块**同构同路径**：只引 Sdk / Sdk.Ui / Sdk.AccessKit；不引 Access、不直接引 UI 框架、不引其他模块（AR-1 / AR-2）。
  -->
  <PropertyGroup>
    <!-- 包目录名（artifacts\modules\<Configuration>\serial\ 与应用输出 modules\serial\）—— 用户可见 -->
    <ModulePackageName>serial</ModulePackageName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Sdk\HYWDebugAssistant.Sdk.csproj" />
    <!-- 模块自带的视图：Avalonia 控件 + 视图契约（只经 Sdk.Ui 转引，不直接引 UI 框架）。 -->
    <ProjectReference Include="..\..\..\Sdk.Ui\HYWDebugAssistant.Sdk.Ui.csproj" />
    <!-- 外部接入骨架：模块只声明标准标识，适配器与参数类型由框架按标准创建/登记。 -->
    <ProjectReference Include="..\..\..\Sdk.AccessKit\HYWDebugAssistant.Sdk.AccessKit.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- 模块清单随构建输出（M1 物理形式：目录 + module.json + 实现程序集） -->
    <None Update="module.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- 模块自有资源包：随输出并被 StageModulePackage 收进包；包内 `resources/i18n/<程序集简名>/`、`resources/icons/<程序集简名>/`。 -->
    <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>


