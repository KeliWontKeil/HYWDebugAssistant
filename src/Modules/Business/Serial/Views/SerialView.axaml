<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="using:HYWDebugAssistant.Modules.Serial.Views"
             x:Class="HYWDebugAssistant.Modules.Serial.Views.SerialView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             d:DesignWidth="360" d:DesignHeight="142">

  <!--
    串口：参数、读数、状态、按钮全部绝对定位。
    **坐标只写在这一个文件里**（唯一视图事实源，预览器直接看这里）：
      · 参数行 = 标签（0..56，右对齐贴住编辑器）+ 编辑器（60..160）；
      · 行距 26、行高 24；读数行上缘 3、高 24（状态灯 10..20 与它同中线）；
      · 动作行 = 打开 168..240、关闭 248..320（72×27）+ 清空 328..352（24×24 图标）。
    内容区尺寸 = 窗口 − 描边 − 预留带（唯一算法见 `ModuleSurfaceMetrics`）。
  -->
  <Canvas ClipToBounds="True">

    <!-- 左栏：五个参数。 -->
    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="48" Height="24"
                    Classes="caption right" Field="{x:Static views:SerialViewKeys.PortName}" />
    <ui:ModuleConfigField Canvas.Left="52" Canvas.Top="0" Width="100" Height="24"
                          Field="{x:Static views:SerialViewKeys.PortName}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="26" Width="48" Height="24"
                    Classes="caption right" Field="{x:Static views:SerialViewKeys.BaudRate}" />
    <ui:ModuleConfigField Canvas.Left="52" Canvas.Top="26" Width="100" Height="24"
                          Field="{x:Static views:SerialViewKeys.BaudRate}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="52" Width="48" Height="24"
                    Classes="caption right" Field="{x:Static views:SerialViewKeys.DataBits}" />
    <ui:ModuleConfigField Canvas.Left="52" Canvas.Top="52" Width="100" Height="24"
                          Field="{x:Static views:SerialViewKeys.DataBits}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="78" Width="48" Height="24"
                    Classes="caption right" Field="{x:Static views:SerialViewKeys.StopBits}" />
    <ui:ModuleConfigField Canvas.Left="52" Canvas.Top="78" Width="100" Height="24"
                          Field="{x:Static views:SerialViewKeys.StopBits}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="104" Width="48" Height="24"
                    Classes="caption right" Field="{x:Static views:SerialViewKeys.Parity}" />
    <ui:ModuleConfigField Canvas.Left="52" Canvas.Top="104" Width="100" Height="24"
                          Field="{x:Static views:SerialViewKeys.Parity}" />

    <!-- 右栏：状态灯 + 三格读数。 -->
    <ui:ModuleStatusLight Canvas.Left="164" Canvas.Top="28"
                          Source="{x:Static views:SerialViewKeys.Link}" />

    <ui:ModuleLabel Canvas.Left="162" Canvas.Top="75" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.rx}" />
    <ui:ModuleNumeric Canvas.Left="200" Canvas.Top="75" Width="48" Height="20"
                      Source="{x:Static views:SerialViewKeys.RxCount}" Quantity="Bytes" />

    <ui:ModuleLabel Canvas.Left="250" Canvas.Top="75" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.tx}" />
    <ui:ModuleNumeric Canvas.Left="288" Canvas.Top="75" Width="48" Height="20"
                      Source="{x:Static views:SerialViewKeys.TxCount}" Quantity="Bytes" />

    <ui:ModuleLabel Canvas.Left="206" Canvas.Top="100" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.drop}" />
    <ui:ModuleNumeric Canvas.Left="246" Canvas.Top="100" Width="48" Height="20"
                      Source="{x:Static views:SerialViewKeys.DropCount}" Quantity="Bytes" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="128" Width="358" Height="14"
                    Source="{x:Static views:SerialViewKeys.State}" />

    <ui:ModuleButton Canvas.Left="186" Canvas.Top="16" Width="72" Height="36"
                     CommandName="{x:Static views:SerialViewKeys.Open}" Content="{loc:Tr view.open}" />
    <ui:ModuleButton Canvas.Left="268" Canvas.Top="16" Width="72" Height="36"
                     CommandName="{x:Static views:SerialViewKeys.Close}" Content="{loc:Tr view.close}" />
    <ui:ModuleButton Classes="icon" Canvas.Left="316" Canvas.Top="102" Width="16" Height="16"
                     Icon="{x:Static views:SerialViewKeys.ClearCountersIcon}"
                     CommandName="{x:Static views:SerialViewKeys.ClearCounters}"
                     ToolTip.Tip="{loc:Tr view.clearCounters}" />
  </Canvas>
</ui:ModuleView>
