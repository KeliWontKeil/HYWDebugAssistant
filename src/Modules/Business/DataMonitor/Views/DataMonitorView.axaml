<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.DataMonitor.Views"
             xmlns:local="using:HYWDebugAssistant.Modules.DataMonitor"
             x:Class="HYWDebugAssistant.Modules.DataMonitor.Views.DataMonitorView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="360" InitialHeight="288"
             MinWidth="360" MinHeight="288">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:DataMonitorModule.InPort}"
                   Direction="Receive"
                   TypeId="{x:Static local:DataMonitorModule.RawBytesTypeId}"
                   Edge="Top" />
  </ui:ModuleView.Ports>

  <!--
    数据显示器：日志区自适应；「缓冲已满」提示占**固定高度的一行**，只换文字不换布局；
    底部动作/开关/状态条的高度只由它自己的 Canvas 声明。
  -->
  <Grid RowDefinitions="*,Auto,Auto">

    <ui:ModuleTextSurface Mode="Display" Grid.Row="0"
                          Source="{x:Static views:DataMonitorViewKeys.Log}" />

    <ui:ModuleLabel Grid.Row="1" Height="16" Source="{x:Static views:DataMonitorViewKeys.BufferFull}" />

    <Canvas Grid.Row="2" Height="106" ClipToBounds="True">
      <ui:ModuleButton Canvas.Left="0" Canvas.Top="2" Width="84" Height="27"
                       CommandName="{x:Static views:DataMonitorViewKeys.Clear}" Content="{loc:Tr view.clear}" />
      <ui:ModuleButton Canvas.Left="96" Canvas.Top="2" Width="84" Height="27"
                       CommandName="{x:Static views:DataMonitorViewKeys.Save}" Content="{loc:Tr view.save}" />

      <ui:ModuleToggle Canvas.Left="0" Canvas.Top="34" Width="36" Height="24"
                       Source="{x:Static views:DataMonitorViewKeys.Paused}" />
      <ui:ModuleLabel Canvas.Left="40" Canvas.Top="34" Width="56" Height="24" Classes="caption"
                      VerticalAlignment="Center" Text="{loc:Tr view.paused}" />
      <ui:ModuleToggle Canvas.Left="96" Canvas.Top="34" Width="36" Height="24" IsChecked="True"
                       Source="{x:Static views:DataMonitorViewKeys.Wrap}" />
      <ui:ModuleLabel Canvas.Left="136" Canvas.Top="34" Width="68" Height="24" Classes="caption"
                      VerticalAlignment="Center" Text="{loc:Tr view.wrap}" />
      <ui:ModuleToggle Canvas.Left="96" Canvas.Top="62" Width="36" Height="24"
                       Source="{x:Static views:DataMonitorViewKeys.HexView}" />
      <ui:ModuleLabel Canvas.Left="136" Canvas.Top="62" Width="48" Height="24" Classes="caption"
                      VerticalAlignment="Center" Text="{loc:Tr view.hex}" />
      <ui:ModuleToggle Canvas.Left="0" Canvas.Top="62" Width="36" Height="24" IsChecked="True"
                       Source="{x:Static views:DataMonitorViewKeys.Timestamp}" />
      <ui:ModuleLabel Canvas.Left="40" Canvas.Top="62" Width="48" Height="24" Classes="caption"
                      VerticalAlignment="Center" Text="{loc:Tr view.timestamp}" />

      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="88" Width="250" Height="16"
                      Text="{loc:Tr view.statusPreview}"
                      Source="{x:Static views:DataMonitorViewKeys.Status}" />
    </Canvas>
  </Grid>
</ui:ModuleView>
