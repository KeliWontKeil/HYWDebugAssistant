<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.HexStringConverter.Views"
             x:Class="HYWDebugAssistant.Modules.HexStringConverter.Views.HexStringConverterView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="400" InitialHeight="300"
             MinWidth="400" MinHeight="200">

  <!--
    转换器：上下两半等分（内容区尺寸由模块声明给出，不在这里写死）。
    每半 = 一个页签控件；页签头固定，选中页内容内部再等分为“输入文字区 / 结果文字区”。
    结果放在页签内容里，页签头就不会参与这两块文字的等分。
  -->
  <Grid RowDefinitions="Auto,*,6,Auto,*">

    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.textToHex}" />
      <ui:ModuleLabel Width="64" Classes="caption right" Text="{loc:Tr view.newline}" />
      <ui:ModuleCheckBox Width="26" Height="24" IsChecked="True"
                         Value="{x:Static views:HexStringConverterViewKeys.NewlineCr}"
                         Content="{loc:Tr view.newlineCr}" />
      <ui:ModuleCheckBox Width="26" Height="24" IsChecked="True"
                         Value="{x:Static views:HexStringConverterViewKeys.NewlineLf}"
                         Content="{loc:Tr view.newlineLf}" />
    </StackPanel>

    <ui:ModuleTabs Grid.Row="1" StateKey="{x:Static views:HexStringConverterViewKeys.CharPagesKey}">
      <TabItem Header="1">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" EscapeInput="True" Value="{x:Static views:HexStringConverterViewKeys.Char1}" EnterNewlineValue="{x:Static views:HexStringConverterViewKeys.EnterNewline}" Multiline="True" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display" ShowNewlineMarks="False"
                            Text="{loc:Tr view.hexResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.HexResult}" />
        </Grid>
      </TabItem>
      <TabItem Header="2">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" EscapeInput="True" Value="{x:Static views:HexStringConverterViewKeys.Char2}" EnterNewlineValue="{x:Static views:HexStringConverterViewKeys.EnterNewline}" Multiline="True" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display" ShowNewlineMarks="False"
                            Text="{loc:Tr view.hexResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.HexResult}" />
        </Grid>
      </TabItem>
      <TabItem Header="3">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" EscapeInput="True" Value="{x:Static views:HexStringConverterViewKeys.Char3}" EnterNewlineValue="{x:Static views:HexStringConverterViewKeys.EnterNewline}" Multiline="True" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display" ShowNewlineMarks="False"
                            Text="{loc:Tr view.hexResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.HexResult}" />
        </Grid>
      </TabItem>
      <TabItem Header="4">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" EscapeInput="True" Value="{x:Static views:HexStringConverterViewKeys.Char4}" EnterNewlineValue="{x:Static views:HexStringConverterViewKeys.EnterNewline}" Multiline="True" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display" ShowNewlineMarks="False"
                            Text="{loc:Tr view.hexResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.HexResult}" />
        </Grid>
      </TabItem>
      <TabItem Header="5">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" EscapeInput="True" Value="{x:Static views:HexStringConverterViewKeys.Char5}" EnterNewlineValue="{x:Static views:HexStringConverterViewKeys.EnterNewline}" Multiline="True" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display" ShowNewlineMarks="False"
                            Text="{loc:Tr view.hexResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.HexResult}" />
        </Grid>
      </TabItem>
    </ui:ModuleTabs>

    <ui:ModuleLabel Grid.Row="3" Classes="caption" Text="{loc:Tr view.hexToText}" />

    <ui:ModuleTabs Grid.Row="4" StateKey="{x:Static views:HexStringConverterViewKeys.HexPagesKey}">
      <TabItem Header="1">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexStringConverterViewKeys.Hex1}" Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display"
                            Text="{loc:Tr view.charResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.CharResult}" />
        </Grid>
      </TabItem>
      <TabItem Header="2">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexStringConverterViewKeys.Hex2}" Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display"
                            Text="{loc:Tr view.charResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.CharResult}" />
        </Grid>
      </TabItem>
      <TabItem Header="3">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexStringConverterViewKeys.Hex3}" Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display"
                            Text="{loc:Tr view.charResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.CharResult}" />
        </Grid>
      </TabItem>
      <TabItem Header="4">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexStringConverterViewKeys.Hex4}" Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display"
                            Text="{loc:Tr view.charResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.CharResult}" />
        </Grid>
      </TabItem>
      <TabItem Header="5">
        <Grid RowDefinitions="*,*">
          <ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexStringConverterViewKeys.Hex5}" Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" />
          <ui:ModuleTextSurface Grid.Row="1" Mode="Display"
                            Text="{loc:Tr view.charResultPreview}"
                            Source="{x:Static views:HexStringConverterViewKeys.CharResult}" />
        </Grid>
      </TabItem>
    </ui:ModuleTabs>
  </Grid>
</ui:ModuleView>
