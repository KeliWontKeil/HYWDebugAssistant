<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="using:HYWDebugAssistant.Modules.Udp.Views"
             x:Class="HYWDebugAssistant.Modules.Udp.Views.UdpView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             d:DesignWidth="360" d:DesignHeight="124">

  <!--
    UDP（内容区 358×142）：本地/目标参数、读数、广播开关、按钮全部绝对定位。
    **坐标只写在这一个文件里**：参数标签 0..56（右对齐贴住编辑器）、编辑器 60..150，行距 26、行高 24。
    动作行 = 打开 168..240、关闭 248..320（72×27）+ 清空 328..352（24×24 图标）。
  -->
  <Canvas ClipToBounds="True">

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.LocalAddress}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="0" Width="90" Height="24"
                          Field="{x:Static views:UdpViewKeys.LocalAddress}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="26" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.LocalPort}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="26" Width="90" Height="24"
                          Field="{x:Static views:UdpViewKeys.LocalPort}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="52" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.RemoteAddress}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="52" Width="90" Height="24"
                          Field="{x:Static views:UdpViewKeys.RemoteAddress}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="78" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.RemotePort}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="78" Width="90" Height="24"
                          Field="{x:Static views:UdpViewKeys.RemotePort}" />

    <!-- 右栏：状态灯 + 三格读数。 -->
    <ui:ModuleStatusLight Canvas.Left="162" Canvas.Top="10"
                          Source="{x:Static views:UdpViewKeys.Link}" />

    <ui:ModuleLabel Canvas.Left="174" Canvas.Top="3" Width="12" Height="24"
                    Classes="caption right" Text="{loc:Tr view.rx}" />
    <ui:ModuleNumeric Canvas.Left="188" Canvas.Top="3" Width="40" Height="24"
                      Source="{x:Static views:UdpViewKeys.RxCount}" Quantity="Bytes" />

    <ui:ModuleLabel Canvas.Left="230" Canvas.Top="3" Width="12" Height="24"
                    Classes="caption right" Text="{loc:Tr view.tx}" />
    <ui:ModuleNumeric Canvas.Left="244" Canvas.Top="3" Width="40" Height="24"
                      Source="{x:Static views:UdpViewKeys.TxCount}" Quantity="Bytes" />

    <ui:ModuleLabel Canvas.Left="286" Canvas.Top="3" Width="24" Height="24"
                    Classes="caption right" Text="{loc:Tr view.drop}" />
    <ui:ModuleNumeric Canvas.Left="312" Canvas.Top="3" Width="40" Height="24"
                      Source="{x:Static views:UdpViewKeys.DropCount}" Quantity="Bytes" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="108" Width="358" Height="14"
                    Source="{x:Static views:UdpViewKeys.State}" />

    <ui:ModuleLabel Canvas.Left="168" Canvas.Top="40" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.Broadcast}" />
    <ui:ModuleConfigField Canvas.Left="228" Canvas.Top="40" Width="120" Height="24"
                          Field="{x:Static views:UdpViewKeys.Broadcast}" />

    <ui:ModuleButton Canvas.Left="168" Canvas.Top="70" Width="72" Height="27"
                     CommandName="{x:Static views:UdpViewKeys.Open}" Content="{loc:Tr view.open}" />
    <ui:ModuleButton Canvas.Left="248" Canvas.Top="70" Width="72" Height="27"
                     CommandName="{x:Static views:UdpViewKeys.Close}" Content="{loc:Tr view.close}" />
    <ui:ModuleButton Classes="icon" Canvas.Left="328" Canvas.Top="71" Width="24" Height="24"
                     Icon="{x:Static views:UdpViewKeys.ClearCountersIcon}"
                     CommandName="{x:Static views:UdpViewKeys.ClearCounters}"
                     ToolTip.Tip="{loc:Tr view.clearCounters}" />
  </Canvas>
</ui:ModuleView>
