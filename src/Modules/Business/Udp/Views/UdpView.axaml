<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.Udp.Views"
             xmlns:local="using:HYWDebugAssistant.Modules.Udp"
             x:Class="HYWDebugAssistant.Modules.Udp.Views.UdpView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="360" InitialHeight="122"
             MinWidth="360" MinHeight="122">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:UdpModule.RxPort}"
                   Direction="Send"
                   TypeId="{x:Static local:UdpModule.RawBytesTypeId}"
                   Edge="Bottom" />
    <ui:ModulePort Name="{x:Static local:UdpModule.TxPort}"
                   Direction="Receive"
                   TypeId="{x:Static local:UdpModule.RawBytesTypeId}"
                   Edge="Top" />
  </ui:ModuleView.Ports>

  <!--
    UDP：本地/目标参数、读数、广播开关、按钮全部绝对定位。
    **坐标只写在这一个文件里**：参数标签右对齐贴住编辑器、编辑器与标签同中线。
    动作行 = 打开 / 关闭 / 清空：清空是图标按钮，宽度小于文字按钮。
  -->
  <Canvas ClipToBounds="True">

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="1" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.LocalAddress}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="1" Width="108" Height="24"
                          Field="{x:Static views:UdpViewKeys.LocalAddress}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="27" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.LocalPort}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="27" Width="54" Height="24"
                          Field="{x:Static views:UdpViewKeys.LocalPort}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="53" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.RemoteAddress}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="53" Width="108" Height="24"
                          Field="{x:Static views:UdpViewKeys.RemoteAddress}" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="79" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.RemotePort}" />
    <ui:ModuleConfigField Canvas.Left="60" Canvas.Top="79" Width="54" Height="24"
                          Field="{x:Static views:UdpViewKeys.RemotePort}" />

    <!-- 右栏：状态灯 + 三格读数。 -->
    <ui:ModuleStatusLight Canvas.Left="184" Canvas.Top="16"
                          Source="{x:Static views:UdpViewKeys.Link}" />

    <ui:ModuleLabel Canvas.Left="172" Canvas.Top="60" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.rx}" />
    <ui:ModuleNumeric Canvas.Left="210" Canvas.Top="60" Width="54" Height="20"
                      Source="{x:Static views:UdpViewKeys.RxCount}" Quantity="Bytes" Text="0 B" />

    <ui:ModuleLabel Canvas.Left="266" Canvas.Top="60" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.tx}" />
    <ui:ModuleNumeric Canvas.Left="304" Canvas.Top="60" Width="54" Height="20"
                      Source="{x:Static views:UdpViewKeys.TxCount}" Quantity="Bytes" Text="0 B" />

    <ui:ModuleLabel Canvas.Left="172" Canvas.Top="85" Width="36" Height="20"
                    Classes="caption right" Text="{loc:Tr view.drop}" />
    <ui:ModuleNumeric Canvas.Left="210" Canvas.Top="85" Width="54" Height="20"
                      Source="{x:Static views:UdpViewKeys.DropCount}" Quantity="Bytes" Text="0 B" />

    <ui:ModuleLabel Canvas.Left="0" Canvas.Top="108" Width="358" Height="14"
                    Text="{loc:Tr status.idle}"
                    Source="{x:Static views:UdpViewKeys.State}" />

    <ui:ModuleLabel Canvas.Left="172" Canvas.Top="34" Width="56" Height="24"
                    Classes="caption right" Field="{x:Static views:UdpViewKeys.Broadcast}" />
    <ui:ModuleConfigField Canvas.Left="232" Canvas.Top="35" Width="120" Height="24"
                          Field="{x:Static views:UdpViewKeys.Broadcast}" />

    <ui:ModuleButton Canvas.Left="206" Canvas.Top="8" Width="72" Height="25"
                     CommandName="{x:Static views:UdpViewKeys.Open}" Content="{loc:Tr view.open}" />
    <ui:ModuleButton Canvas.Left="284" Canvas.Top="8" Width="72" Height="25"
                     CommandName="{x:Static views:UdpViewKeys.Close}" Content="{loc:Tr view.close}" />
    <ui:ModuleButton Classes="icon" Canvas.Left="340" Canvas.Top="87" Width="16" Height="16"
                     Icon="{x:Static views:UdpViewKeys.ClearCountersIcon}"
                     CommandName="{x:Static views:UdpViewKeys.ClearCounters}"
                     ToolTip.Tip="{loc:Tr view.clearCounters}" />
  </Canvas>
</ui:ModuleView>
