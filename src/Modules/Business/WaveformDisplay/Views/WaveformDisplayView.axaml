<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.WaveformDisplay.Views"
             x:Class="HYWDebugAssistant.Modules.WaveformDisplay.Views.WaveformDisplayView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="960" InitialHeight="580"
             MinWidth="960" MinHeight="580">

  <!--
    图表/数据轴/右栏随窗口伸缩；其下的输入与按钮是固定控件，全部绝对定位。
    坐标只写在本文件；代码不设置位置，也不按内容改行高。
    数据轴轨道占满自身宽度（不复制图表绘图区的 PlotInset.Left 轴预留）。
  -->
  <Grid RowDefinitions="*,90,14" Margin="2">
    <Grid Grid.Row="0" ColumnDefinitions="*,200" Margin="0,2,0,0">
      <Grid Grid.Column="0" RowDefinitions="*,32">
        <Panel Grid.Row="0">
          <ui:ChartSurface x:Name="Chart" Margin="2" PlotInset="50,20,4,20"
                           ShowCursors="True" ShowYCursors="True"
                           YCursorALabel="m" YCursorBLabel="n"
                           XStart="0" XEnd="255" XStep="1" XAxisKind="Index"
                           XTickStep="0" YTickStep="0" YMin="-1" YMax="1" />
          <!-- 仅预览可见的图表槽位外框：运行期由附加属性隐藏，不参与布局、命中或 PNG 捕获。 -->
          <Border x:Name="ChartLayoutFrame" BorderThickness="1"
                  BorderBrush="{DynamicResource TextMuted}" IsHitTestVisible="False"
                  ui:PreviewOnly.IsEnabled="True" />
        </Panel>
        <ui:RangeSelector x:Name="Range" Grid.Row="1" Height="32" Margin="0,1,0,0"
                          TrackHeight="12" ShowTicks="True" ShowTickLabels="True"
                          Minimum="0" Maximum="255" RangeStart="0" RangeEnd="255"
                          TickStep="0" XAxisKind="Index" />
      </Grid>

      <Border Grid.Column="1" Margin="4,0,0,0" Padding="0" Background="{DynamicResource BgChrome}"
              BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="2">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="GroupCardsPanel" Spacing="0" />
        </ScrollViewer>
      </Border>
    </Grid>

    <Canvas Grid.Row="1" Height="86" ClipToBounds="True">
      <!-- X 行：范围、刻度、起止、跟踪、自定义频率；数值单位只由 AxisModeSelect 决定。 -->
      <ui:ModuleSelect x:Name="AxisModeSelect" Canvas.Left="0" Canvas.Top="44" Width="80" Height="22"
                       SelectedKey="index" />

      <ui:ModuleLabel Canvas.Left="84" Canvas.Top="29" Width="54" Height="22" Classes="caption right"
                      Text="{loc:Tr view.xTick}" />
      <ui:ModuleTextSurface x:Name="XTickInput" Canvas.Left="140" Canvas.Top="29" Width="42" Height="24"
                            Mode="Input" Text="0"
                            Source="{x:Static views:WaveformDisplayViewKeys.XTick}" />
      <ui:ModuleLabel Canvas.Left="186" Canvas.Top="29" Width="72" Height="22" Classes="caption right"
                      Text="{loc:Tr view.xStart}" />
      <ui:ModuleTextSurface x:Name="XStartInput" Canvas.Left="260" Canvas.Top="29" Width="56" Height="24"
                            Mode="Input" Text="0"
                            Source="{x:Static views:WaveformDisplayViewKeys.XStart}" />
      <ui:ModuleLabel Canvas.Left="320" Canvas.Top="29" Width="72" Height="22" Classes="caption right"
                      Text="{loc:Tr view.xEnd}" />
      <ui:ModuleTextSurface x:Name="XEndInput" Canvas.Left="394" Canvas.Top="29" Width="56" Height="24"
                            Mode="Input" Text="255"
                            Source="{x:Static views:WaveformDisplayViewKeys.XEnd}" />

      <ui:ModuleToggle Canvas.Left="572" Canvas.Top="29" Width="36" Height="24" IsChecked="True"
                       Source="{x:Static views:WaveformDisplayViewKeys.Follow}" />
      <ui:ModuleLabel Canvas.Left="610" Canvas.Top="29" Width="30" Height="24" Classes="caption"
                      Text="{loc:Tr view.follow}" />
      <ui:ModuleLabel Canvas.Left="452" Canvas.Top="29" Width="56" Height="24" Classes="caption right"
                      Text="{loc:Tr view.followRange}" />
      <ui:ModuleTextSurface x:Name="FollowRangeInput" Canvas.Left="510" Canvas.Top="29" Width="56" Height="24"
                            Mode="Input" Text="256"
                            Source="{x:Static views:WaveformDisplayViewKeys.FollowRange}" />

      <ui:ModuleToggle x:Name="UseCustomRateToggle" Canvas.Left="400" Canvas.Top="0" Width="36" Height="24"
                       Source="{x:Static views:WaveformDisplayViewKeys.UseCustomRate}"
                       ToolTip.Tip="{loc:Tr view.customRateTip}" />
      <ui:ModuleLabel Canvas.Left="438" Canvas.Top="0" Width="90" Height="24" Classes="caption"
                      Text="{loc:Tr view.useCustomRate}" />
      <ui:ModuleLabel Canvas.Left="260" Canvas.Top="0" Width="70" Height="24" Classes="caption right"
                      Text="{loc:Tr view.CustomRate}" />
      <ui:ModuleTextSurface x:Name="CustomRateInput" Canvas.Left="332" Canvas.Top="0" Width="64" Height="24"
                            Mode="Input" Text="100"
                            Source="{x:Static views:WaveformDisplayViewKeys.CustomRate}" />

      <!-- Y 行：范围、刻度、起止,自动y -->
      <ui:ModuleLabel Canvas.Left="84" Canvas.Top="54" Width="54" Height="22" Classes="caption right"
                      Text="{loc:Tr view.yTick}" />
      <ui:ModuleTextSurface x:Name="YTickInput" Canvas.Left="140" Canvas.Top="54" Width="42" Height="22"
                            Mode="Input" Text="0"
                            Source="{x:Static views:WaveformDisplayViewKeys.YTick}" />
      <ui:ModuleLabel Canvas.Left="186" Canvas.Top="54" Width="72" Height="22" Classes="caption right"
                      Text="{loc:Tr view.yMin}" />
      <ui:ModuleTextSurface x:Name="YMinInput" Canvas.Left="260" Canvas.Top="54" Width="56" Height="22"
                            Mode="Input" Text="-1"
                            Source="{x:Static views:WaveformDisplayViewKeys.YMin}" />
      <ui:ModuleLabel Canvas.Left="320" Canvas.Top="54" Width="72" Height="22" Classes="caption right"
                      Text="{loc:Tr view.yMax}" />
      <ui:ModuleTextSurface x:Name="YMaxInput" Canvas.Left="394" Canvas.Top="54" Width="56" Height="22"
                            Mode="Input" Text="1"
                            Source="{x:Static views:WaveformDisplayViewKeys.YMax}" />

      <ui:ModuleToggle Canvas.Left="460" Canvas.Top="54" Width="36" Height="22" IsChecked="True"
                       Source="{x:Static views:WaveformDisplayViewKeys.YAuto}" />
      <ui:ModuleLabel Canvas.Left="498" Canvas.Top="54" Width="56" Height="22" Classes="caption"
                      Text="{loc:Tr view.yAuto}" />

      <!-- 动作：固定坐标，不随窗口宽度漂移。 -->
      <ui:ModuleButton Canvas.Left="2" Canvas.Top="0" Width="74" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.ResetGroup}"
                       Content="{loc:Tr view.reset}" />
      <ui:ModuleButton Canvas.Left="80" Canvas.Top="0" Width="74" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.Clear}"
                       Content="{loc:Tr view.clear}" />
      <ui:ModuleToggle Canvas.Left="184" Canvas.Top="0" Width="36" Height="22" IsChecked="True"
                       Source="{x:Static views:WaveformDisplayViewKeys.Cursors}" />
      <ui:ModuleLabel Canvas.Left="222" Canvas.Top="0" Width="36" Height="22" Classes="caption"
                      Text="{loc:Tr view.cursors}" />

      <ui:ModuleToggle x:Name="KeepInactiveToggle" Canvas.Left="682" Canvas.Top="32" Width="36" Height="22"
                       IsChecked="True"
                       Source="{x:Static views:WaveformDisplayViewKeys.KeepInactive}" />
      <ui:ModuleLabel Canvas.Left="720" Canvas.Top="32" Width="108" Height="22" Classes="caption"
                      Text="{loc:Tr view.keepInactive}" />
      <ui:ModuleLabel Canvas.Left="834" Canvas.Top="32" Width="48" Height="22" Classes="caption right"
                      Text="{loc:Tr view.historyLimit}" />
      <ui:ModuleLabel x:Name="HistoryUsageLabel" Canvas.Left="682" Canvas.Top="60" Width="150" Height="22"
                      Classes="hint" VerticalAlignment="Center"
                      Text="{loc:Tr view.historyUsagePreview}" />
      <ui:ModuleTextSurface x:Name="HistoryLimitInput" Canvas.Left="884" Canvas.Top="32" Width="56" Height="22"
                            Mode="Input" Text="0"
                            Source="{x:Static views:WaveformDisplayViewKeys.HistoryLimit}" />
      

      <ui:ModuleButton Canvas.Left="680" Canvas.Top="0" Width="74" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.SaveSelection}"
                       Content="{loc:Tr view.saveSelection}" />
      <ui:ModuleButton Canvas.Left="758" Canvas.Top="0" Width="74" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.SaveAll}"
                       Content="{loc:Tr view.saveAll}" />
      <ui:ModuleButton Canvas.Left="836" Canvas.Top="0" Width="74" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.SaveImage}"
                       Content="{loc:Tr view.saveImage}" />
    </Canvas>

    <Canvas Grid.Row="2" Height="14" ClipToBounds="True">
      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="580" Height="14"
                      Text="{loc:Tr status.ready}"
                      Source="{x:Static views:WaveformDisplayViewKeys.Status}" />
      <ui:ModuleLabel x:Name="RangeStatus" Canvas.Left="600" Canvas.Top="0" Width="342" Height="14"
                      Classes="hint right" VerticalAlignment="Center"
                      Text="{loc:Tr view.rangeStatusPreview}" />
    </Canvas>
  </Grid>
</ui:ModuleView>
