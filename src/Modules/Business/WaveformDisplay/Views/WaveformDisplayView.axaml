<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.WaveformDisplay.Views"
             x:Class="HYWDebugAssistant.Modules.WaveformDisplay.Views.WaveformDisplayView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="960" InitialHeight="540"
             MinWidth="960" MinHeight="540">

  <!--
    图表/数据轴/右栏随窗口伸缩；其下的输入与按钮是固定控件，全部绝对定位。
    坐标只写在本文件；代码不设置位置，也不按内容改行高。
    数据轴轨道占满自身宽度（不复制图表绘图区的 40 DIP 轴预留）。
  -->
  <Grid RowDefinitions="*,64,14" Margin="2">
    <Grid Grid.Row="0" ColumnDefinitions="*,200" Margin="0,2,0,0">
      <Grid Grid.Column="0" RowDefinitions="*,32">
        <ui:ChartSurface x:Name="Chart" Grid.Row="0" ShowCursors="True" ShowYCursors="True"
                         YCursorALabel="m" YCursorBLabel="n" />
        <ui:RangeSelector x:Name="Range" Grid.Row="1" Height="32" Margin="0,1,0,0"
                          TrackHeight="12" ShowTicks="True" ShowTickLabels="True" />
      </Grid>

      <Border Grid.Column="1" Margin="4,0,0,0" Padding="0" Background="{DynamicResource BgChrome}"
              BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="2">
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="GroupCardsPanel" Spacing="0" />
        </ScrollViewer>
      </Border>
    </Grid>

    <Canvas Grid.Row="1" Height="64" ClipToBounds="True">
      <!-- X 行：范围、刻度、起止。 -->
      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="1" Width="34" Height="22" Classes="caption right"
                      Text="{loc:Tr view.xAxisMode}" />
      <ui:ModuleSelect x:Name="AxisModeSelect" Canvas.Left="37" Canvas.Top="1" Width="74" Height="22" />
      <ui:ModuleLabel Canvas.Left="116" Canvas.Top="1" Width="48" Height="22" Classes="caption right"
                      Text="{loc:Tr view.followRange}" />
      <ui:ModuleTextSurface x:Name="FollowRangeInput" Canvas.Left="167" Canvas.Top="1" Width="56" Height="22"
                            Mode="Input" Source="{x:Static views:WaveformDisplayViewKeys.FollowRange}" />
      <ui:ModuleLabel Canvas.Left="226" Canvas.Top="1" Width="16" Height="22" Classes="caption"
                      Text="{loc:Tr view.unitSamples}" />
      <ui:ModuleLabel Canvas.Left="246" Canvas.Top="1" Width="34" Height="22" Classes="caption right"
                      Text="{loc:Tr view.xTick}" />
      <ui:ModuleTextSurface x:Name="XTickInput" Canvas.Left="283" Canvas.Top="1" Width="42" Height="22"
                            Mode="Input" Source="{x:Static views:WaveformDisplayViewKeys.XTick}" />
      <ui:ModuleLabel Canvas.Left="330" Canvas.Top="1" Width="34" Height="22" Classes="caption right"
                      Text="{loc:Tr view.xStart}" />
      <ui:ModuleTextSurface x:Name="XStartInput" Canvas.Left="367" Canvas.Top="1" Width="56" Height="22"
                            Mode="Input" Source="{x:Static views:WaveformDisplayViewKeys.XStart}" />
      <ui:ModuleLabel Canvas.Left="428" Canvas.Top="1" Width="34" Height="22" Classes="caption right"
                      Text="{loc:Tr view.xEnd}" />
      <ui:ModuleTextSurface x:Name="XEndInput" Canvas.Left="465" Canvas.Top="1" Width="56" Height="22"
                            Mode="Input" Source="{x:Static views:WaveformDisplayViewKeys.XEnd}" />

      <!-- Y 行：自动、范围、刻度、跟随、游标。 -->
      <ui:ModuleToggle Canvas.Left="0" Canvas.Top="29" Width="74" Height="22"
                       Source="{x:Static views:WaveformDisplayViewKeys.YAuto}"
                       Text="{loc:Tr view.yAuto}" />
      <ui:ModuleLabel Canvas.Left="78" Canvas.Top="29" Width="34" Height="22" Classes="caption right"
                      Text="{loc:Tr view.yMin}" />
      <ui:ModuleTextSurface x:Name="YMinInput" Canvas.Left="115" Canvas.Top="29" Width="52" Height="22"
                            Mode="Input" Source="{x:Static views:WaveformDisplayViewKeys.YMin}" />
      <ui:ModuleLabel Canvas.Left="172" Canvas.Top="29" Width="34" Height="22" Classes="caption right"
                      Text="{loc:Tr view.yMax}" />
      <ui:ModuleTextSurface x:Name="YMaxInput" Canvas.Left="209" Canvas.Top="29" Width="52" Height="22"
                            Mode="Input" Source="{x:Static views:WaveformDisplayViewKeys.YMax}" />
      <ui:ModuleLabel Canvas.Left="266" Canvas.Top="29" Width="34" Height="22" Classes="caption right"
                      Text="{loc:Tr view.yTick}" />
      <ui:ModuleTextSurface x:Name="YTickInput" Canvas.Left="303" Canvas.Top="29" Width="42" Height="22"
                            Mode="Input" Source="{x:Static views:WaveformDisplayViewKeys.YTick}" />
      <ui:ModuleToggle Canvas.Left="350" Canvas.Top="29" Width="70" Height="22"
                       Source="{x:Static views:WaveformDisplayViewKeys.Follow}"
                       Text="{loc:Tr view.follow}" />
      <ui:ModuleToggle Canvas.Left="423" Canvas.Top="29" Width="70" Height="22"
                       Source="{x:Static views:WaveformDisplayViewKeys.Cursors}"
                       Text="{loc:Tr view.cursors}" />

      <!-- 动作：固定坐标，不随窗口宽度漂移。 -->
      <ui:ModuleButton Canvas.Left="540" Canvas.Top="1" Width="52" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.Clear}"
                       Content="{loc:Tr view.clear}" />
      <ui:ModuleButton Canvas.Left="595" Canvas.Top="1" Width="52" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.ResetGroup}"
                       Content="{loc:Tr view.reset}" />
      <ui:ModuleButton Canvas.Left="650" Canvas.Top="1" Width="74" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.SaveSelection}"
                       Content="{loc:Tr view.saveSelection}" />
      <ui:ModuleButton Canvas.Left="728" Canvas.Top="1" Width="74" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.SaveAll}"
                       Content="{loc:Tr view.saveAll}" />
      <ui:ModuleButton Canvas.Left="806" Canvas.Top="1" Width="74" Height="22"
                       CommandName="{x:Static views:WaveformDisplayViewKeys.SaveImage}"
                       Content="{loc:Tr view.saveImage}" />

      <ui:ModuleToggle x:Name="KeepInactiveToggle" Canvas.Left="540" Canvas.Top="29" Width="128" Height="22"
                       Source="{x:Static views:WaveformDisplayViewKeys.KeepInactive}"
                       Text="{loc:Tr view.keepInactive}" />
      <ui:ModuleLabel Canvas.Left="672" Canvas.Top="29" Width="48" Height="22" Classes="caption right"
                      Text="{loc:Tr view.historyLimit}" />
      <ui:ModuleTextSurface x:Name="HistoryLimitInput" Canvas.Left="723" Canvas.Top="29" Width="56" Height="22"
                            Mode="Input" Source="{x:Static views:WaveformDisplayViewKeys.HistoryLimit}" />
      <ui:ModuleLabel Canvas.Left="782" Canvas.Top="29" Width="16" Height="22" Classes="caption"
                      Text="{loc:Tr view.unitSamples}" />
      <TextBlock x:Name="HistoryUsageLabel" Canvas.Left="802" Canvas.Top="29" Width="150" Height="22"
                 FontSize="10" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                 Foreground="{DynamicResource TextSecondary}" />
    </Canvas>

    <Canvas Grid.Row="2" Height="14" ClipToBounds="True">
      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="520" Height="14"
                      Source="{x:Static views:WaveformDisplayViewKeys.Status}" />
      <TextBlock x:Name="RangeStatus" Canvas.Left="700" Canvas.Top="0" Width="252" Height="14"
                 FontSize="10" TextAlignment="Right" VerticalAlignment="Center"
                 Foreground="{DynamicResource TextSecondary}" />
    </Canvas>
  </Grid>
</ui:ModuleView>
