<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.HexSender.Views"
             xmlns:local="using:HYWDebugAssistant.Modules.HexSender"
             x:Class="HYWDebugAssistant.Modules.HexSender.Views.HexSenderView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="400" InitialHeight="200"
             MinWidth="400" MinHeight="150">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:HexSenderModule.OutPort}"
                   Direction="Send"
                   TypeId="{x:Static local:HexSenderModule.RawBytesTypeId}"
                   Edge="Bottom" />
  </ui:ModuleView.Ports>

  <!--
    HEX 发送器：多页输入区自适应；动作/状态条的高度只由它自己的 Canvas 声明。
    动作条里的元素仍是绝对坐标：间隔单位 `ms` 与「已发送」的单位 `条` 都是普通文本标签。
    发送按钮的小箭头切换回车发送档位（每实例可覆盖，首次取框架设置）。
  -->
  <Grid RowDefinitions="Auto,*,Auto">

    <ui:ModuleLabel Grid.Row="0" Classes="caption" Text="{loc:Tr view.inputLabel}" />

    <ui:ModuleTabs Grid.Row="1" StateKey="{x:Static views:HexSenderViewKeys.PagesStateKey}">
      <TabItem Header="1"><ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexSenderViewKeys.Hex1}"
                                                SubmitKeyValue="{x:Static views:HexSenderViewKeys.SubmitKey}"
                                                SubmitCommandName="{x:Static views:HexSenderViewKeys.Send}"
                                                Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" /></TabItem>
      <TabItem Header="2"><ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexSenderViewKeys.Hex2}"
                                                SubmitKeyValue="{x:Static views:HexSenderViewKeys.SubmitKey}"
                                                SubmitCommandName="{x:Static views:HexSenderViewKeys.Send}"
                                                Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" /></TabItem>
      <TabItem Header="3"><ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexSenderViewKeys.Hex3}"
                                                SubmitKeyValue="{x:Static views:HexSenderViewKeys.SubmitKey}"
                                                SubmitCommandName="{x:Static views:HexSenderViewKeys.Send}"
                                                Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" /></TabItem>
      <TabItem Header="4"><ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexSenderViewKeys.Hex4}"
                                                SubmitKeyValue="{x:Static views:HexSenderViewKeys.SubmitKey}"
                                                SubmitCommandName="{x:Static views:HexSenderViewKeys.Send}"
                                                Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" /></TabItem>
      <TabItem Header="5"><ui:ModuleTextSurface Mode="Input" Value="{x:Static views:HexSenderViewKeys.Hex5}"
                                                SubmitKeyValue="{x:Static views:HexSenderViewKeys.SubmitKey}"
                                                SubmitCommandName="{x:Static views:HexSenderViewKeys.Send}"
                                                Multiline="True" ShowNewlineMarks="False" CommitMode="OnChange" /></TabItem>
    </ui:ModuleTabs>

    <Canvas Grid.Row="2" Height="52" ClipToBounds="True">
      <ui:ModuleButton Canvas.Left="0" Canvas.Top="4" Width="84" Height="27"
                       Appearance="Accent"
                       MenuValue="{x:Static views:HexSenderViewKeys.SubmitKey}"
                       CommandName="{x:Static views:HexSenderViewKeys.Send}" Content="{loc:Tr view.send}" />
      <ui:ModuleToggle Canvas.Left="96" Canvas.Top="4" Width="36" Height="24"
                       Value="{x:Static views:HexSenderViewKeys.Continuous}" />
      <ui:ModuleLabel Canvas.Left="135" Canvas.Top="4" Width="52" Height="24" Classes="caption"
                      VerticalAlignment="Center" Text="{loc:Tr view.continuous}" />

      <!-- 间隔：输入框一条矩形，单位 `ms` 是紧挨着的普通标签。 -->
      <ui:ModuleTextSurface Canvas.Left="190" Canvas.Top="4" Width="48" Height="24" Mode="Input"
                            Value="{x:Static views:HexSenderViewKeys.Interval}" TextAlignment="Right" CommitMode="OnChange" />
      <ui:ModuleLabel Canvas.Left="240" Canvas.Top="4" Width="20" Height="24"
                      Classes="caption" Text="{loc:Tr view.intervalUnit}" />

      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="36" Width="260" Height="16"
                      Text="{loc:Tr view.statusPreview}"
                      Source="{x:Static views:HexSenderViewKeys.Status}" />

      <!--
        已发送：标题 / 值 / 单位是三个普通文本元素，在一个**声明矩形**里靠右紧排 ——
        三者相对这个矩形的右缘（值变宽时整体左移，右缘不动）。
      -->
      <Grid Canvas.Left="262" Canvas.Top="36" Width="92" Height="16">
        <StackPanel Orientation="Horizontal" Spacing="2"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.sentTitle}" />
          <ui:ModuleNumeric Source="{x:Static views:HexSenderViewKeys.Sent}" Text="0" />
          <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.sentUnit}" />
        </StackPanel>
      </Grid>
    </Canvas>
  </Grid>
</ui:ModuleView>
