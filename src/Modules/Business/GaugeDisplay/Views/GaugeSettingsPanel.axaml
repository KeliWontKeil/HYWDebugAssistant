<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:views="using:HYWDebugAssistant.Modules.GaugeDisplay.Views"
               x:Class="HYWDebugAssistant.Modules.GaugeDisplay.Views.GaugeSettingsPanel"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               InitialWidth="300" InitialHeight="340">

  <!--
    面板正文 = 一张独立视图：预览器可以直接打开这个文件单独看表单，不必被塞进模块视图里。
    尺寸只写在这里（表单区尺寸）；标题行与窗口由 ModulePopupPanel 负责。
  -->
  <Grid Margin="8" ColumnDefinitions="84,*" ColumnSpacing="4" RowSpacing="4"
        RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
    <Grid Grid.Row="0" Grid.ColumnSpan="2" ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="4">
      <ui:ModuleLabel Grid.Column="0" Classes="caption right" VerticalAlignment="Center"
                      Text="{loc:Tr view.group}" />
      <ui:ModuleConfigField Grid.Column="1" Height="22"
                            Value="{x:Static views:GaugeDisplayViewKeys.Group}"
                            Editor="Number" InitialValue="0"
                            ToolTip.Tip="{loc:Tr view.groupTip}" />
      <ui:ModuleLabel Grid.Column="2" Classes="caption right" VerticalAlignment="Center"
                      Text="{loc:Tr view.channel}" />
      <ui:ModuleConfigField Grid.Column="3" Height="22"
                            Value="{x:Static views:GaugeDisplayViewKeys.Channel}"
                            Editor="Number" InitialValue="0"
                            ToolTip.Tip="{loc:Tr view.channelTip}" />
    </Grid>

    <ui:ModuleLabel Grid.Row="1" Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.minimum}" />
    <ui:ModuleConfigField Grid.Row="1" Grid.Column="1" Height="22"
                          Value="{x:Static views:GaugeDisplayViewKeys.Minimum}"
                          Editor="Number" InitialValue="0" />

    <ui:ModuleLabel Grid.Row="2" Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.maximum}" />
    <ui:ModuleConfigField Grid.Row="2" Grid.Column="1" Height="22"
                          Value="{x:Static views:GaugeDisplayViewKeys.Maximum}"
                          Editor="Number" InitialValue="100" />

    <ui:ModuleCheckBox Grid.Row="3" Grid.ColumnSpan="2" IsChecked="True"
                       Content="{loc:Tr view.autoZero}"
                       Value="{x:Static views:GaugeDisplayViewKeys.AutoZero}" />

    <ui:ModuleLabel Grid.Row="4" Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.zeroDelay}" />
    <ui:ModuleConfigField Grid.Row="4" Grid.Column="1" Height="22"
                          Value="{x:Static views:GaugeDisplayViewKeys.ZeroDelay}"
                          Editor="Number" InitialValue="800" />

    <ui:ModuleLabel Grid.Row="5" Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.dialText}" />
    <ui:ModuleConfigField Grid.Row="5" Grid.Column="1" Height="22"
                          Value="{x:Static views:GaugeDisplayViewKeys.Title}"
                          Editor="Text" InitialValue="" />

    <ui:ModuleLabel Grid.Row="6" Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.unit}" />
    <ui:ModuleConfigField Grid.Row="6" Grid.Column="1" Height="22"
                          Value="{x:Static views:GaugeDisplayViewKeys.Unit}"
                          Editor="Text" InitialValue="" />

    <ui:ModuleCheckBox Grid.Row="7" Grid.ColumnSpan="2" IsChecked="True"
                       Content="{loc:Tr view.smoothing}"
                       Value="{x:Static views:GaugeDisplayViewKeys.Smoothing}" />

    <ui:ModuleLabel Grid.Row="8" Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.smoothingMs}" />
    <ui:ModuleConfigField Grid.Row="8" Grid.Column="1" Height="22"
                          Value="{x:Static views:GaugeDisplayViewKeys.SmoothingMs}"
                          Editor="Number" InitialValue="120" />

    <ui:ModuleLabel Grid.Row="9" Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.decimals}" />
    <ui:ModuleConfigField Grid.Row="9" Grid.Column="1" Height="22"
                          Value="{x:Static views:GaugeDisplayViewKeys.Decimals}"
                          Editor="Number" InitialValue="2" />
  </Grid>
</ui:ModuleView>
