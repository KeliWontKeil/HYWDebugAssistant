<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:views="using:HYWDebugAssistant.Modules.GaugeDisplay.Views"
               x:Class="HYWDebugAssistant.Modules.GaugeDisplay.Views.GaugeSettingsPanel"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               InitialWidth="300" InitialHeight="338">

  <!--
    面板正文 = 一张独立视图：预览器可以直接打开这个文件单独看表单。
    固定尺寸表单用 Canvas 绝对坐标：坐标只写在这里，行距与列宽由本文件统一决定。
  -->
  <Canvas ClipToBounds="True">
    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="8" Width="20" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.group}" />
    <ui:ModuleTextSurface Canvas.Left="32" Canvas.Top="8" Width="64" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.Group}"
                          Text="0"
                          ToolTip.Tip="{loc:Tr view.groupTip}" />
    <ui:ModuleLabel Canvas.Left="104" Canvas.Top="8" Width="36" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.channel}" />
    <ui:ModuleTextSurface Canvas.Left="144" Canvas.Top="8" Width="148" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.Channel}"
                          Text="0"
                          ToolTip.Tip="{loc:Tr view.channelTip}" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="38" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.minimum}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="38" Width="196" Height="22"
                          Mode="Input" TextFormat="Real" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.Minimum}"
                          Text="0" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="68" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.maximum}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="68" Width="196" Height="22"
                          Mode="Input" TextFormat="Real" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.Maximum}"
                          Text="100" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="98" Width="284" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.fillFromZero}"
                       Value="{x:Static views:GaugeDisplayViewKeys.FillFromZero}" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="128" Width="284" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.autoZero}"
                       Value="{x:Static views:GaugeDisplayViewKeys.AutoZero}" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="158" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.zeroDelay}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="158" Width="196" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.ZeroDelay}"
                          Text="800" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="188" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.dialText}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="188" Width="196" Height="22"
                          Mode="Input" TextFormat="Text" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.Title}"
                          Text="" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="218" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.unit}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="218" Width="196" Height="22"
                          Mode="Input" TextFormat="Text" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.Unit}"
                          Text="" />

    <ui:ModuleCheckBox Canvas.Left="8" Canvas.Top="248" Width="284" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.smoothing}"
                       Value="{x:Static views:GaugeDisplayViewKeys.Smoothing}" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="278" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.smoothingMs}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="278" Width="196" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.SmoothingMs}"
                          Text="120" />

    <ui:ModuleLabel Canvas.Left="8" Canvas.Top="308" Width="84" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.decimals}" />
    <ui:ModuleTextSurface Canvas.Left="96" Canvas.Top="308" Width="196" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:GaugeDisplayViewKeys.Decimals}"
                          Text="2" />
  </Canvas>
</ui:ModuleView>
