<Project Sdk="Microsoft.NET.Sdk">

  <!--
    业务模块：图片框 `hyw/image-frame`（工作区美化）。
    只引 Sdk / Sdk.Ui；无端口、无角色、无按钮，图片区域用右键菜单更换。
  -->
  <PropertyGroup>
    <ModulePackageName>image-frame</ModulePackageName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Sdk\HYWDebugAssistant.Sdk.csproj" />
    <ProjectReference Include="..\..\..\Sdk.Ui\HYWDebugAssistant.Sdk.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="module.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
