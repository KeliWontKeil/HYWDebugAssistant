<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.TextSender.Views"
             xmlns:local="using:HYWDebugAssistant.Modules.TextSender"
             x:Class="HYWDebugAssistant.Modules.TextSender.Views.TextSenderView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="400" InitialHeight="200"
             MinWidth="400" MinHeight="200">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:TextSenderModule.OutPort}"
                   Direction="Send"
                   TypeId="{x:Static local:TextSenderModule.RawBytesTypeId}"
                   Edge="Bottom" />
  </ui:ModuleView.Ports>

  <!--
    文本发送器：上方多页输入区自适应；下方动作/状态条的高度只由它自己的 Canvas 声明。
    动作条里的元素仍是绝对坐标：间隔单位 `ms` 与「已发送」的单位 `条` 都是普通文本标签，
    各有自己的矩形 —— 单位不是控件的属性。
    发送格式第三行：文本输入始终按 C 转义输入；CR/LF 两个开关只作用于真实回车（开什么输出什么）。
  -->
  <Grid RowDefinitions="Auto,*,Auto">

    
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
      <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.inputLabel}" />
              <!-- 发送格式：文本输入始终按 C 转义；CR、LF 两个勾选只控制真实回车。 -->
      <ui:ModuleLabel Width="64" Height="24" Classes="caption right"
                      VerticalAlignment="Center" Text="{loc:Tr view.newline}" />
      <ui:ModuleCheckBox  Width="26" Height="24" IsChecked="True" Margin="0,1,0,0"
                         Value="{x:Static views:TextSenderViewKeys.NewlineCr}"
                         Content="{loc:Tr view.newlineCr}" />
      <ui:ModuleCheckBox Width="26" Height="24" IsChecked="True" Margin="0,1,0,0"
                         Value="{x:Static views:TextSenderViewKeys.NewlineLf}"
                         Content="{loc:Tr view.newlineLf}" />
    </StackPanel>

    <ui:ModuleTabs Grid.Row="1" StateKey="{x:Static views:TextSenderViewKeys.PagesStateKey}">
      <TabItem Header="1"><ui:ModuleTextSurface Mode="Input" TextFormat="Text" Value="{x:Static views:TextSenderViewKeys.Text1}"
                                                ShowInputHint="True"
                                                EscapeInput="True"
                                                SubmitKeyValue="{x:Static views:TextSenderViewKeys.SubmitKey}"
                                                EnterNewlineValue="{x:Static views:TextSenderViewKeys.EnterNewline}"
                                                SubmitCommandName="{x:Static views:TextSenderViewKeys.Send}"
                                                Multiline="True" CommitMode="OnChange" /></TabItem>
      <TabItem Header="2"><ui:ModuleTextSurface Mode="Input" TextFormat="Text" Value="{x:Static views:TextSenderViewKeys.Text2}"
                                                ShowInputHint="True"
                                                EscapeInput="True"
                                                SubmitKeyValue="{x:Static views:TextSenderViewKeys.SubmitKey}"
                                                EnterNewlineValue="{x:Static views:TextSenderViewKeys.EnterNewline}"
                                                SubmitCommandName="{x:Static views:TextSenderViewKeys.Send}"
                                                Multiline="True" CommitMode="OnChange" /></TabItem>
      <TabItem Header="3"><ui:ModuleTextSurface Mode="Input" TextFormat="Text" Value="{x:Static views:TextSenderViewKeys.Text3}"
                                                ShowInputHint="True"
                                                EscapeInput="True"
                                                SubmitKeyValue="{x:Static views:TextSenderViewKeys.SubmitKey}"
                                                EnterNewlineValue="{x:Static views:TextSenderViewKeys.EnterNewline}"
                                                SubmitCommandName="{x:Static views:TextSenderViewKeys.Send}"
                                                Multiline="True" CommitMode="OnChange" /></TabItem>
      <TabItem Header="4"><ui:ModuleTextSurface Mode="Input" TextFormat="Text" Value="{x:Static views:TextSenderViewKeys.Text4}"
                                                ShowInputHint="True"
                                                EscapeInput="True"
                                                SubmitKeyValue="{x:Static views:TextSenderViewKeys.SubmitKey}"
                                                EnterNewlineValue="{x:Static views:TextSenderViewKeys.EnterNewline}"
                                                SubmitCommandName="{x:Static views:TextSenderViewKeys.Send}"
                                                Multiline="True" CommitMode="OnChange" /></TabItem>
      <TabItem Header="5"><ui:ModuleTextSurface Mode="Input" TextFormat="Text" Value="{x:Static views:TextSenderViewKeys.Text5}"
                                                ShowInputHint="True"
                                                EscapeInput="True"
                                                SubmitKeyValue="{x:Static views:TextSenderViewKeys.SubmitKey}"
                                                EnterNewlineValue="{x:Static views:TextSenderViewKeys.EnterNewline}"
                                                SubmitCommandName="{x:Static views:TextSenderViewKeys.Send}"
                                                Multiline="True" CommitMode="OnChange" /></TabItem>
    </ui:ModuleTabs>

    <Canvas Grid.Row="2" Height="52" ClipToBounds="True">
      <ui:ModuleButton Canvas.Left="0" Canvas.Top="4" Width="84" Height="27"
                       Appearance="Accent"
                       MenuValue="{x:Static views:TextSenderViewKeys.SubmitKey}"
                       CommandName="{x:Static views:TextSenderViewKeys.Send}" Content="{loc:Tr view.send}" />
      <ui:ModuleToggle Canvas.Left="96" Canvas.Top="4" Width="36" Height="24"
                       Value="{x:Static views:TextSenderViewKeys.Continuous}" />
      <ui:ModuleLabel Canvas.Left="135" Canvas.Top="4" Width="52" Height="24" Classes="caption"
                      VerticalAlignment="Center" Text="{loc:Tr view.continuous}" />

      <!-- 间隔：输入框一条矩形，单位 `ms` 是紧挨着的普通标签。 -->
      <ui:ModuleTextSurface Canvas.Left="188" Canvas.Top="4" Width="48" Height="24" Mode="Input" TextFormat="NonNegativeWhole"
                            Value="{x:Static views:TextSenderViewKeys.Interval}" TextAlignment="Right" CommitMode="OnChange" />
      <ui:ModuleLabel Canvas.Left="237" Canvas.Top="4" Width="20" Height="24"
                      Classes="caption" Text="{loc:Tr view.intervalUnit}" />

      <!--
        已发送：标题 / 值 / 单位是三个普通文本元素，在一个**声明矩形**里靠右紧排 ——
        三者相对这个矩形的右缘（值变宽时整体左移，右缘不动）。
      -->
      <Grid Canvas.Left="262" Canvas.Top="36" Width="92" Height="16">
        <StackPanel Orientation="Horizontal" Spacing="2"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.sentTitle}" />
          <ui:ModuleNumeric Source="{x:Static views:TextSenderViewKeys.Sent}" Text="0" />
          <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.sentUnit}" />
        </StackPanel>
      </Grid>

      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="36" Width="260" Height="16"
                      Text="{loc:Tr view.statusPreview}"
                      Source="{x:Static views:TextSenderViewKeys.Status}" />

    </Canvas>
  </Grid>
</ui:ModuleView>
