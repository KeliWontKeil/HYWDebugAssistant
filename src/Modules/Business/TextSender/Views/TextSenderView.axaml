<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="using:HYWDebugAssistant.Modules.TextSender.Views"
             x:Class="HYWDebugAssistant.Modules.TextSender.Views.TextSenderView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             d:DesignWidth="360" d:DesignHeight="192">

  <!--
    文本发送器（内容区 358×192）：上方多页输入区自适应；下方动作/状态条固定 70 高。
    动作条里的元素仍是绝对坐标：间隔单位 `ms` 与「已发送」的单位 `条` 都是普通文本标签，
    各有自己的矩形 —— 单位不是控件的属性。
  -->
  <Grid RowDefinitions="Auto,*,70">

    <ui:ModuleLabel Grid.Row="0" Classes="caption" Text="{loc:Tr view.inputLabel}" />

    <ui:ModuleTabs Grid.Row="1" StateKey="{x:Static views:TextSenderViewKeys.PagesStateKey}">
      <TabItem Header="1"><ui:ModuleTextSurface Mode="Input" Source="{x:Static views:TextSenderViewKeys.Text1}" Multiline="True" /></TabItem>
      <TabItem Header="2"><ui:ModuleTextSurface Mode="Input" Source="{x:Static views:TextSenderViewKeys.Text2}" Multiline="True" /></TabItem>
      <TabItem Header="3"><ui:ModuleTextSurface Mode="Input" Source="{x:Static views:TextSenderViewKeys.Text3}" Multiline="True" /></TabItem>
      <TabItem Header="4"><ui:ModuleTextSurface Mode="Input" Source="{x:Static views:TextSenderViewKeys.Text4}" Multiline="True" /></TabItem>
      <TabItem Header="5"><ui:ModuleTextSurface Mode="Input" Source="{x:Static views:TextSenderViewKeys.Text5}" Multiline="True" /></TabItem>
    </ui:ModuleTabs>

    <Canvas Grid.Row="2" Height="70" ClipToBounds="True">
      <ui:ModuleButton Canvas.Left="0" Canvas.Top="4" Width="64" Height="27"
                       CommandName="{x:Static views:TextSenderViewKeys.Send}" Content="{loc:Tr view.send}" />
      <ui:ModuleToggle Canvas.Left="82" Canvas.Top="5" Width="100" Height="24"
                       Source="{x:Static views:TextSenderViewKeys.Continuous}" Text="{loc:Tr view.continuous}" />

      <!-- 间隔：输入框一条矩形，单位 `ms` 是紧挨着的普通标签。 -->
      <ui:ModuleTextSurface Canvas.Left="190" Canvas.Top="4" Width="48" Height="24" Mode="Input"
                            Source="{x:Static views:TextSenderViewKeys.Interval}" TextAlignment="Right" />
      <ui:ModuleLabel Canvas.Left="240" Canvas.Top="4" Width="20" Height="24"
                      Classes="caption" Text="{loc:Tr view.intervalUnit}" />

      <ui:ModuleLabel Canvas.Left="0" Canvas.Top="36" Width="358" Height="16"
                      Source="{x:Static views:TextSenderViewKeys.Status}" />

      <!--
        已发送：标题 / 值 / 单位是三个普通文本元素，在一个**声明矩形**里靠右紧排 ——
        三者相对这个矩形的右缘（值变宽时整体左移，右缘不动）。
      -->
      <Grid Canvas.Left="262" Canvas.Top="4" Width="92" Height="24">
        <StackPanel Orientation="Horizontal" Spacing="2"
                    HorizontalAlignment="Right" VerticalAlignment="Center">
          <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.sentTitle}" />
          <ui:ModuleNumeric Source="{x:Static views:TextSenderViewKeys.Sent}" />
          <ui:ModuleLabel Classes="caption" Text="{loc:Tr view.sentUnit}" />
        </StackPanel>
      </Grid>
    </Canvas>
  </Grid>
</ui:ModuleView>
