<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:views="using:HYWDebugAssistant.Modules.WaveformGenerator.Views"
             xmlns:local="using:HYWDebugAssistant.Modules.WaveformGenerator"
             x:Class="HYWDebugAssistant.Modules.WaveformGenerator.Views.WaveformGeneratorView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             InitialWidth="960" InitialHeight="320"
             MinWidth="960" MinHeight="320">

  <ui:ModuleView.Ports>
    <ui:ModulePort Name="{x:Static local:WaveformGeneratorModule.OutPort}"
                   Direction="Send"
                   TypeId="{x:Static local:WaveformGeneratorModule.WaveformTypeId}"
                   Edge="Bottom" />
  </ui:ModuleView.Ports>

  <!--
    三列：左侧图表吸收剩余宽度，中间参数表单固定宽度，右侧发送区固定宽度。
    参数表单中的标签/输入框/按钮全部绝对定位；组段与通道段始终存在，无选中通道时只禁用通道段。
    预览器不调用 Refresh，因此任何“只有运行时才会出现”的控件都不能靠 IsVisible 隐藏。
  -->
  <Grid RowDefinitions="*,14" Margin="2">
    <Grid Grid.Row="0" ColumnDefinitions="*,560,140">
      <Border Grid.Column="0" Background="{DynamicResource BgChrome}"
              BorderBrush="{DynamicResource BorderDefault}" BorderThickness="0" CornerRadius="2"
              Padding="0">
        <Panel>
          <ui:ChartSurface x:Name="Chart" Margin="2" PlotInset="28,20,10,20"
                           ShowCursors="False" ShowYCursors="False"
                           XStart="0" XEnd="1" XStep="1" XAxisKind="Index"
                           XTickStep="0" YTickStep="0" YMin="-1" YMax="1" />
          <!-- 仅预览可见的图表槽位外框：运行期由附加属性隐藏，不参与布局、命中或 PNG 捕获。 -->
          <Border x:Name="ChartLayoutFrame" BorderThickness="1"
                  BorderBrush="{DynamicResource TextMuted}" IsHitTestVisible="False"
                  ui:PreviewOnly.IsEnabled="True" />
        </Panel>
      </Border>

      <Border Grid.Column="1" Margin="4,0" Padding="2" Background="{DynamicResource BgChrome}"
              BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="2">
        <Canvas Width="540" Height="288" ClipToBounds="True">
          <!-- 1. 组选择。 -->
          <ui:ModuleLabel Canvas.Left="0" Canvas.Top="0" Width="42" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.channelGroup}" />
          <ScrollViewer Canvas.Left="46" Canvas.Top="0" Width="450" Height="22"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ui:ModuleSegmentedControl x:Name="GroupChips" Height="22" SelectedKey="0">
              <ui:ModuleSegmentedControl.PreviewOptions>
                <ui:ModuleSegmentOption Key="0" Label="G1" />
                <ui:ModuleSegmentOption Key="1" Label="G2" />
              </ui:ModuleSegmentedControl.PreviewOptions>
            </ui:ModuleSegmentedControl>
          </ScrollViewer>
          <ui:ModuleButton Canvas.Left="498" Canvas.Top="2" Width="18" Height="18" Classes="icon"
                           CommandName="{x:Static views:WaveformGeneratorViewKeys.AddGroup}"
                           Icon="{x:Static views:WaveformGeneratorViewKeys.IconAdd}"
                           ToolTip.Tip="{loc:Tr view.addGroup}" />
          <ui:ModuleButton Canvas.Left="518" Canvas.Top="2" Width="18" Height="18" Classes="icon"
                           CommandName="{x:Static views:WaveformGeneratorViewKeys.RemoveGroup}"
                           Icon="{x:Static views:WaveformGeneratorViewKeys.IconTrash}"
                           ToolTip.Tip="{loc:Tr view.removeGroup}" />

          <!-- 2. 组参数：频率/周期/每周期点数属于组，所有通道共享。 -->
          <ui:ModuleLabel Canvas.Left="0" Canvas.Top="26" Width="42" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.groupName}" />
          <ui:ModuleTextSurface x:Name="GroupNameInput" Canvas.Left="46" Canvas.Top="26" Width="180" Height="22"
                                Mode="Input" Text="G1"
                                CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.GroupName}" />
          <ui:ModuleLabel Canvas.Left="236" Canvas.Top="26" Width="42" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.groupId}" />
          <ui:ModuleTextSurface x:Name="GroupIdInput" Canvas.Left="282" Canvas.Top="26" Width="72" Height="22"
                                Mode="Input" Text="1"
                                CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.GroupId}" />
          <ui:ModuleToggle Canvas.Left="452" Canvas.Top="26" Width="36" Height="22" IsChecked="True"
                           Value="{x:Static views:WaveformGeneratorViewKeys.GroupEnabled}" />
          <ui:ModuleLabel Canvas.Left="490" Canvas.Top="26" Width="48" Height="22" Classes="caption"
                          VerticalAlignment="Center" Text="{loc:Tr view.enabled}" />

          <ui:ModuleLabel Canvas.Left="0" Canvas.Top="52" Width="42" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.frequency}" />
          <ui:ModuleTextSurface x:Name="FrequencyInput" Canvas.Left="46" Canvas.Top="52" Width="50" Height="22"
                                Mode="Input" Text="10"
                                CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.Frequency}" />
          <ui:ModuleLabel Canvas.Left="100" Canvas.Top="52" Width="16" Height="22" Classes="caption"
                          VerticalAlignment="Center" Text="{loc:Tr view.unitHz}" />
          <ui:ModuleLabel Canvas.Left="122" Canvas.Top="52" Width="38" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.period}" />
          <ui:ModuleTextSurface x:Name="PeriodInput" Canvas.Left="164" Canvas.Top="52" Width="50" Height="22"
                                Mode="Input" Text="0.1"
                                CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.Period}" />
          <ui:ModuleLabel Canvas.Left="218" Canvas.Top="52" Width="16" Height="22" Classes="caption"
                          VerticalAlignment="Center" Text="{loc:Tr view.unitSecond}" />
          <ui:ModuleLabel Canvas.Left="240" Canvas.Top="52" Width="60" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.resolution}" />
          <ui:ModuleTextSurface x:Name="ResolutionInput" Canvas.Left="304" Canvas.Top="52" Width="52" Height="22"
                                Mode="Input" Text="100"
                                CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.Resolution}" />
          <ui:ModuleLabel Canvas.Left="360" Canvas.Top="52" Width="42" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.groupRate}" />
          <ui:ModuleLabel x:Name="GroupRateLabel" Canvas.Left="406" Canvas.Top="52" Width="134" Height="22"
                          Classes="caption" VerticalAlignment="Center"
                          Text="{loc:Tr view.groupRatePreview}" />

          <Border Canvas.Left="0" Canvas.Top="80" Width="540" Height="1"
                  Background="{DynamicResource BorderDefault}" />

          <!-- 3. 通道选择。 -->
          <ui:ModuleLabel Canvas.Left="0" Canvas.Top="88" Width="42" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.channel}" />
          <ScrollViewer Canvas.Left="46" Canvas.Top="88" Width="450" Height="22"
                        HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <ui:ModuleSegmentedControl x:Name="ChannelChips" Height="22" SelectedKey="0">
              <ui:ModuleSegmentedControl.PreviewOptions>
                <ui:ModuleSegmentOption Key="0" Label="CH1" />
                <ui:ModuleSegmentOption Key="1" Label="CH2" />
              </ui:ModuleSegmentedControl.PreviewOptions>
            </ui:ModuleSegmentedControl>
          </ScrollViewer>
          <ui:ModuleButton Canvas.Left="498" Canvas.Top="90" Width="18" Height="18" Classes="icon"
                           CommandName="{x:Static views:WaveformGeneratorViewKeys.AddChannel}"
                           Icon="{x:Static views:WaveformGeneratorViewKeys.IconAdd}"
                           ToolTip.Tip="{loc:Tr view.addChannel}" />
          <ui:ModuleButton Canvas.Left="518" Canvas.Top="90" Width="18" Height="18" Classes="icon"
                           CommandName="{x:Static views:WaveformGeneratorViewKeys.RemoveChannel}"
                           Icon="{x:Static views:WaveformGeneratorViewKeys.IconTrash}"
                           ToolTip.Tip="{loc:Tr view.removeChannel}" />

          <!-- 4. 通道名/启用 + 波形选择。 -->
          <ui:ModuleLabel Canvas.Left="0" Canvas.Top="114" Width="42" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.channelName}" />
          <ui:ModuleTextSurface x:Name="ChannelNameInput" Canvas.Left="46" Canvas.Top="114" Width="180" Height="22"
                                Mode="Input" Text="CH1"
                                CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.ChannelName}" />
          <ui:ModuleToggle x:Name="ChannelEnabledToggle" Canvas.Left="452" Canvas.Top="114" Width="36" Height="22"
                           IsChecked="True"
                           Value="{x:Static views:WaveformGeneratorViewKeys.ChannelEnabled}" />
          <ui:ModuleLabel Canvas.Left="490" Canvas.Top="114" Width="48" Height="22" Classes="caption"
                          VerticalAlignment="Center" Text="{loc:Tr view.enabled}" />

          <ui:ModuleLabel Canvas.Left="0" Canvas.Top="142" Width="42" Height="26" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.waveform}" />
          <ui:ModuleSegmentedControl x:Name="WaveformType" Canvas.Left="46" Canvas.Top="142" Width="494" Height="26"
                                     ShowLabels="True" IconSize="14" Value="{x:Static views:WaveformGeneratorViewKeys.Waveform}" SelectedKey="sine">
            <ui:ModuleSegmentedControl.PreviewOptions>
              <ui:ModuleSegmentOption Key="sine" Label="{loc:Tr waveform.sine}" IconKey="icon.wave.sine" />
              <ui:ModuleSegmentOption Key="square" Label="{loc:Tr waveform.square}" IconKey="icon.wave.square" />
              <ui:ModuleSegmentOption Key="triangle" Label="{loc:Tr waveform.triangle}" IconKey="icon.wave.triangle" />
              <ui:ModuleSegmentOption Key="saddle" Label="{loc:Tr waveform.saddle}" IconKey="icon.wave.saddle" />
              <ui:ModuleSegmentOption Key="spwm" Label="SPWM" IconKey="icon.wave.spwm" />
              <ui:ModuleSegmentOption Key="svpwm" Label="SVPWM" IconKey="icon.wave.svpwm" />
              <ui:ModuleSegmentOption Key="noise" Label="{loc:Tr waveform.noise}" IconKey="icon.wave.noise" />
            </ui:ModuleSegmentedControl.PreviewOptions>
          </ui:ModuleSegmentedControl>

          <!--
            5. 波形参数：固定宽度单元按行排列；XAML 默认全显（预览可定位），
            运行期由视图按当前波形隐藏不适用行/单元。行隐藏时由 StackPanel 收起，不留空行。
          -->
          <StackPanel x:Name="ParameterRows" Canvas.Left="0" Canvas.Top="176" Width="540" Spacing="4">
            <Grid x:Name="BaseParameterRow" Height="24" ColumnDefinitions="180,180,180">
              <Grid Grid.Column="0" Width="180" Height="24" ColumnDefinitions="72,64,44">
                <ui:ModuleLabel Grid.Column="0" Classes="caption right" VerticalAlignment="Center"
                                Text="{loc:Tr view.offset}" />
                <ui:ModuleTextSurface x:Name="OffsetInput" Grid.Column="1" Height="22"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Mode="Input" Text="0"
                                      CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.Offset}" />
              </Grid>
              <Grid Grid.Column="1" Width="180" Height="24" ColumnDefinitions="72,64,44">
                <ui:ModuleLabel Grid.Column="0" Classes="caption right" VerticalAlignment="Center"
                                Text="{loc:Tr view.amplitude}" />
                <ui:ModuleTextSurface x:Name="AmplitudeInput" Grid.Column="1" Height="22"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Mode="Input" Text="1"
                                      CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.Amplitude}" />
              </Grid>
              <Grid x:Name="PhaseCell" Grid.Column="2" Width="180" Height="24"
                    ColumnDefinitions="72,64,44">
                <ui:ModuleLabel Grid.Column="0" Classes="caption right" VerticalAlignment="Center"
                                Text="{loc:Tr view.phase}" />
                <ui:ModuleTextSurface x:Name="PhaseInput" Grid.Column="1" Height="22"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Mode="Input" Text="0"
                                      CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.Phase}" />
                <ui:ModuleLabel Grid.Column="2" Classes="caption" VerticalAlignment="Center"
                                Text="{loc:Tr view.unitDegree}" />
              </Grid>
            </Grid>

            <Grid x:Name="DutyParameterRow" Height="24" ColumnDefinitions="180,180,180">
              <Grid Grid.Column="0" Width="180" Height="24" ColumnDefinitions="72,64,44">
                <ui:ModuleLabel Grid.Column="0" Classes="caption right" VerticalAlignment="Center"
                                Text="{loc:Tr view.duty}" />
                <ui:ModuleTextSurface x:Name="DutyInput" Grid.Column="1" Height="22"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Mode="Input" Text="0.5"
                                      CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.Duty}" />
              </Grid>
            </Grid>

            <Grid x:Name="CarrierParameterRow" Height="24" ColumnDefinitions="180,180,180">
              <Grid Grid.Column="0" Width="180" Height="24" ColumnDefinitions="72,64,44">
                <ui:ModuleLabel Grid.Column="0" Classes="caption right" VerticalAlignment="Center"
                                Text="{loc:Tr view.carrierFrequency}" />
                <ui:ModuleTextSurface x:Name="CarrierFrequencyInput" Grid.Column="1" Height="22"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Mode="Input" Text="100"
                                      CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.CarrierFrequency}" />
                <ui:ModuleLabel Grid.Column="2" Classes="caption" VerticalAlignment="Center"
                                Text="{loc:Tr view.unitHz}" />
              </Grid>
              <Grid Grid.Column="1" Width="180" Height="24" ColumnDefinitions="72,64,44">
                <ui:ModuleLabel Grid.Column="0" Classes="caption right" VerticalAlignment="Center"
                                Text="{loc:Tr view.modulationIndex}" />
                <ui:ModuleTextSurface x:Name="ModulationIndexInput" Grid.Column="1" Height="22"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Mode="Input" Text="0.8"
                                      CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.ModulationIndex}" />
              </Grid>
              <Grid Grid.Column="2" Width="180" Height="24" ColumnDefinitions="72,64,44">
                <ui:ModuleLabel Grid.Column="0" Classes="caption right" VerticalAlignment="Center"
                                Text="{loc:Tr view.carrierPhase}" />
                <ui:ModuleTextSurface x:Name="CarrierPhaseInput" Grid.Column="1" Height="22"
                                      HorizontalAlignment="Stretch" VerticalAlignment="Center" Mode="Input" Text="0"
                                      CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.CarrierPhase}" />
                <ui:ModuleLabel Grid.Column="2" Classes="caption" VerticalAlignment="Center"
                                Text="{loc:Tr view.unitDegree}" />
              </Grid>
            </Grid>
          </StackPanel>
        </Canvas>
      </Border>

      <Border Grid.Column="2" Background="{DynamicResource BgChrome}"
              BorderBrush="{DynamicResource BorderDefault}" BorderThickness="1" CornerRadius="2"
              Padding="3">
        <Canvas Width="132" Height="294" ClipToBounds="True">
          <ui:ModuleLabel Canvas.Left="0" Canvas.Top="45" Width="58" Height="22" Classes="caption right"
                          VerticalAlignment="Center" Text="{loc:Tr view.periods}" />
          <ui:ModuleTextSurface x:Name="PeriodsInput" Canvas.Left="60" Canvas.Top="45" Width="50" Height="22"
                                Mode="Input" Text="5"
                                CommitMode="OnChange" Value="{x:Static views:WaveformGeneratorViewKeys.OneShotPeriods}" />

          <ui:ModuleLabel x:Name="EstimateLabel" Canvas.Left="0" Canvas.Top="70" Width="140"
                          Classes="micro wrap" Text="{loc:Tr view.estimatePreview}" />
          <ui:ModuleLabel x:Name="TotalEstimateLabel" Canvas.Left="0" Canvas.Top="88" Width="140"
                          Classes="micro wrap" Text="{loc:Tr view.totalEstimatePreview}" />

          <ui:ModuleButton Canvas.Left="6" Canvas.Top="140" Width="120" Height="22"
                           CommandName="{x:Static views:WaveformGeneratorViewKeys.StartContinuous}"
                           Content="{loc:Tr view.startContinuous}" />
          <ui:ModuleButton Canvas.Left="6" Canvas.Top="104" Width="120" Height="22"
                           CommandName="{x:Static views:WaveformGeneratorViewKeys.SendOnce}"
                           Content="{loc:Tr view.send}" />
          <ui:ModuleButton Canvas.Left="6" Canvas.Top="170" Width="120" Height="22"
                           CommandName="{x:Static views:WaveformGeneratorViewKeys.Stop}"
                           Content="{loc:Tr view.stop}" />
        </Canvas>
      </Border>
    </Grid>

    <ui:ModuleLabel Grid.Row="1" Height="14" Margin="0,1,0,0"
                    Text="{loc:Tr status.ready}"
                    Source="{x:Static views:WaveformGeneratorViewKeys.Status}" />
  </Grid>
</ui:ModuleView>
