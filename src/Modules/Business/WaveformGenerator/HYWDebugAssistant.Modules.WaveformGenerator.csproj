<Project Sdk="Microsoft.NET.Sdk">

  <!--
    业务模块（第三批）：波形发生器 `hyw/waveform-generator`。
    与第三方模块同构同路径：只引 Sdk / Sdk.Ui；不引 Access、不直接引 UI 框架、不引其他模块（AR-1 / AR-2）。
  -->
  <PropertyGroup>
    <ModulePackageName>waveform-generator</ModulePackageName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\Sdk\HYWDebugAssistant.Sdk.csproj" />
    <ProjectReference Include="..\..\..\Sdk.Ui\HYWDebugAssistant.Sdk.Ui.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="module.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="resources\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
