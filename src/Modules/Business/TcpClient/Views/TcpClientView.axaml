<ui:ModuleView xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
             xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:views="using:HYWDebugAssistant.Modules.TcpClient.Views"
             x:Class="HYWDebugAssistant.Modules.TcpClient.Views.TcpClientView"
             x:CompileBindings="True"
             x:DataType="contracts:IModuleViewContext"
             d:DesignWidth="358" d:DesignHeight="142">

  <!--
    TCP 客户端（内容区 358×142）：连接参数、读数、开关、按钮全部绝对定位。
    固定尺寸控件不参与流式拉伸；窗口伸缩只影响需要自适应的区域。
  -->
  <Canvas ClipToBounds="True">

    <ui:ModuleConfigField Canvas.Left="0" Canvas.Top="0" Width="160" Height="24"
                          Field="{x:Static views:TcpClientViewKeys.RemoteHost}" />
    <ui:ModuleConfigField Canvas.Left="0" Canvas.Top="26" Width="160" Height="24"
                          Field="{x:Static views:TcpClientViewKeys.RemotePort}" />
    <ui:ModuleConfigField Canvas.Left="0" Canvas.Top="52" Width="160" Height="24"
                          Field="{x:Static views:TcpClientViewKeys.ConnectTimeout}" />

    <ui:ModuleStatusLight Canvas.Left="168" Canvas.Top="2" Width="10" Height="10"
                          Source="{x:Static views:TcpClientViewKeys.Link}" />
    <ui:ModuleNumeric Canvas.Left="184" Canvas.Top="0" Width="60" Height="30"
                      Source="{x:Static views:TcpClientViewKeys.RxCount}" Unit="B" Title="收" />
    <ui:ModuleNumeric Canvas.Left="246" Canvas.Top="0" Width="60" Height="30"
                      Source="{x:Static views:TcpClientViewKeys.TxCount}" Unit="B" Title="发" />
    <ui:ModuleNumeric Canvas.Left="308" Canvas.Top="0" Width="50" Height="30"
                      Source="{x:Static views:TcpClientViewKeys.DropCount}" Unit="B" Title="丢弃" />

    <ui:ModuleLabel Canvas.Left="168" Canvas.Top="30" Width="190" Height="16"
                    Source="{x:Static views:TcpClientViewKeys.State}" />

    <ui:ModuleConfigField Canvas.Left="168" Canvas.Top="52" Width="180" Height="24"
                          Field="{x:Static views:TcpClientViewKeys.NoDelay}" />

    <ui:ModuleButton Canvas.Left="168" Canvas.Top="96" Width="88" Height="27"
                     CommandName="{x:Static views:TcpClientViewKeys.Open}" Content="连接" />
    <ui:ModuleButton Canvas.Left="264" Canvas.Top="96" Width="88" Height="27"
                     CommandName="{x:Static views:TcpClientViewKeys.Close}" Content="断开" />
  </Canvas>
</ui:ModuleView>
