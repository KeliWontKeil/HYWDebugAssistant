<ui:ModuleView xmlns="https://github.com/avaloniaui"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:ui="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:loc="using:HYWDebugAssistant.Sdk.Ui.Controls"
               xmlns:contracts="using:HYWDebugAssistant.Sdk.Ui"
               xmlns:views="using:HYWDebugAssistant.Modules.ScaleBarHorizontal.Views"
               x:Class="HYWDebugAssistant.Modules.ScaleBarHorizontal.Views.ScaleBarSettingsPanel"
               x:CompileBindings="True"
               x:DataType="contracts:IModuleViewContext"
               InitialWidth="170" InitialHeight="192">

  <!-- 面板正文 = 独立视图：固定尺寸表单用 Canvas 绝对坐标，坐标只写在这里。 -->
  <Canvas ClipToBounds="True">
    <ui:ModuleLabel Canvas.Left="4" Canvas.Top="0" Width="32" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.group}" />
    <ui:ModuleTextSurface Canvas.Left="38" Canvas.Top="0" Width="32" Height="22"
                          Mode="Input" TextFormat="PositiveWhole" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.Group}"
                          Text="1"
                          ToolTip.Tip="{loc:Tr view.groupTip}" />
    <ui:ModuleLabel Canvas.Left="72" Canvas.Top="0" Width="36" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.channel}" />
    <ui:ModuleTextSurface Canvas.Left="110" Canvas.Top="0" Width="32" Height="22"
                          Mode="Input" TextFormat="PositiveWhole" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.Channel}"
                          Text="1"
                          ToolTip.Tip="{loc:Tr view.channelTip}" />

    <ui:ModuleLabel Canvas.Left="4" Canvas.Top="24" Width="32" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.minimum}" />
    <ui:ModuleTextSurface Canvas.Left="38" Canvas.Top="24" Width="32" Height="22"
                          Mode="Input" TextFormat="Real" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.Minimum}"
                          Text="0" />

    <ui:ModuleLabel Canvas.Left="72" Canvas.Top="24" Width="36" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.maximum}" />
    <ui:ModuleTextSurface Canvas.Left="110" Canvas.Top="24" Width="32" Height="22"
                          Mode="Input" TextFormat="Real" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.Maximum}"
                          Text="100" />

    <ui:ModuleLabel Canvas.Left="4" Canvas.Top="48" Width="48" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.decimals}" />
    <ui:ModuleTextSurface Canvas.Left="54" Canvas.Top="48" Width="24" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.Decimals}"
                          Text="2" />

    <ui:ModuleLabel Canvas.Left="80" Canvas.Top="48" Width="36" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.color}" />
    <ui:ModuleColorField Canvas.Left="118" Canvas.Top="48" Width="44" Height="22"
                         Value="{x:Static views:ScaleBarHorizontalViewKeys.Color}"
                         DefaultBrushToken="{x:Static ui:ScaleBar.DefaultFillToken}"
                         DialogTitle="{loc:Tr view.colorTitle}"
                         ResetText="{loc:Tr view.colorReset}"
                         ToolTip.Tip="{loc:Tr view.color}" />

    <ui:ModuleCheckBox Canvas.Left="4" Canvas.Top="71" Width="80" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.fillFromZero}"
                       Value="{x:Static views:ScaleBarHorizontalViewKeys.FillFromZero}" />

    <ui:ModuleCheckBox Canvas.Left="86" Canvas.Top="71" Width="80" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.autoZero}"
                       Value="{x:Static views:ScaleBarHorizontalViewKeys.AutoZero}" />

    <ui:ModuleLabel Canvas.Left="4" Canvas.Top="96" Width="76" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.zeroDelay}" />
    <ui:ModuleTextSurface Canvas.Left="82" Canvas.Top="96" Width="54" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.ZeroDelay}"
                          Text="800" />

    <ui:ModuleLabel Canvas.Left="4" Canvas.Top="120" Width="36" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.barText}" />
    <ui:ModuleTextSurface Canvas.Left="42" Canvas.Top="120" Width="120" Height="22"
                          Mode="Input" TextFormat="Text" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.Title}"
                          Text="" />

    <ui:ModuleLabel Canvas.Left="4" Canvas.Top="144" Width="36" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.unit}" />
    <ui:ModuleTextSurface Canvas.Left="42" Canvas.Top="144" Width="120" Height="22"
                          Mode="Input" TextFormat="Text" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.Unit}"
                          Text="" />

    <ui:ModuleCheckBox Canvas.Left="4" Canvas.Top="167" Width="64" Height="24"
                       IsChecked="True"
                       Content="{loc:Tr view.smoothing}"
                       Value="{x:Static views:ScaleBarHorizontalViewKeys.Smoothing}" />

    <ui:ModuleLabel Canvas.Left="70" Canvas.Top="168" Width="54" Height="22"
                    Classes="caption right" VerticalAlignment="Center"
                    Text="{loc:Tr view.smoothingMs}" />
    <ui:ModuleTextSurface Canvas.Left="126" Canvas.Top="168" Width="38" Height="22"
                          Mode="Input" TextFormat="NonNegativeWhole" CommitMode="OnChange"
                          Value="{x:Static views:ScaleBarHorizontalViewKeys.SmoothingMs}"
                          Text="120" />

  </Canvas>
</ui:ModuleView>
