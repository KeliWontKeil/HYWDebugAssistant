<Project Sdk="Microsoft.NET.Sdk">

  <!--
    组合根（AR-11 唯一白名单）：Program/Main + DI 组装 + 装配序（Core → UI → 主窗口）
    唯一同时可见 L4 内部与 L5 的位置；**不得承载业务/机制逻辑**（ADR-0027 §2.5）
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Ui\HYWDebugAssistant.Ui.csproj" />
    <ProjectReference Include="..\FrameworkUi\HYWDebugAssistant.FrameworkUi.csproj" />
    <ProjectReference Include="..\Core\HYWDebugAssistant.Core.csproj" />
    <ProjectReference Include="..\Core.Api\HYWDebugAssistant.Core.Api.csproj" />

    <!--
      外部接入的框架侧实现（适配器 + 参数类型 + 内置标准目录）：**只有组合根引用**（AR-3 / AR-12）。
      Sdk.AccessKit 是模块侧骨架的宿主副本：随宿主提供，模块包不带。
    -->
    <ProjectReference Include="..\Access\HYWDebugAssistant.Access.csproj" />
    <ProjectReference Include="..\Sdk.AccessKit\HYWDebugAssistant.Sdk.AccessKit.csproj" />

    <!--
      **只表达构建顺序**：应用要把模块包镜像到输出目录，必须在模块包归拢之后。
      `ReferenceOutputAssembly=false` ⇒ 不产生程序集引用（AR-12 仍然成立），
      只是让 MSBuild 先构建这些模块项目；不要把这几条当成"应用依赖模块"。
    -->
    <ProjectReference Include="..\Modules\Business\DataMonitor\HYWDebugAssistant.Modules.DataMonitor.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Modules\Business\HexSender\HYWDebugAssistant.Modules.HexSender.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Modules\Business\HexStringConverter\HYWDebugAssistant.Modules.HexStringConverter.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Modules\Business\Serial\HYWDebugAssistant.Modules.Serial.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Modules\Business\TcpClient\HYWDebugAssistant.Modules.TcpClient.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Modules\Business\TcpServer\HYWDebugAssistant.Modules.TcpServer.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Modules\Business\TextSender\HYWDebugAssistant.Modules.TextSender.csproj" ReferenceOutputAssembly="false" Private="false" />
    <ProjectReference Include="..\Modules\Business\Udp\HYWDebugAssistant.Modules.Udp.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <!-- 组合根依赖注入（ADR-0024 选型清单：Microsoft.Extensions.DependencyInjection） -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <!-- 允许测试项目访问组合根内部类型（冒烟测试） -->
    <InternalsVisibleTo Include="HYWDebugAssistant.Tests" />
  </ItemGroup>

  <!--
    **出厂种子镜像**（阶段 C）：仓库 `resources\**`（只读出厂种子，当前只有主题包）
    原样复制到 `<应用输出>\resources\`。程序启动时由投放器把 `resources\seeds\` 合并进程序目录；
    用户数据（`settings\` / `workspace\` / `logs\` …）**不进发布、也不由构建写入**。
  -->
  <Target Name="StageResources" AfterTargets="Build">
    <ItemGroup>
      <ResourceSeedFile Include="$(MSBuildThisFileDirectory)..\..\resources\**\*" />
    </ItemGroup>

    <RemoveDir Directories="$(OutDir)resources" Condition="Exists('$(OutDir)resources')" />
    <MakeDir Directories="$(OutDir)resources" Condition="'@(ResourceSeedFile)' != ''" />
    <Copy SourceFiles="@(ResourceSeedFile)"
          DestinationFolder="$(OutDir)resources\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(ResourceSeedFile)' != ''" />

    <Message Importance="high"
             Text="[resources] @(ResourceSeedFile->'%(RecursiveDir)'->Distinct()) → $(OutDir)resources"
             Condition="'@(ResourceSeedFile)' != ''" />
  </Target>

  <!--
    **内置模块包镜像**（M1-17 / ADR-0036 D2）：模块项目构建已把包归拢到
    `artifacts\modules\<Configuration>\`，应用构建后再把它们镜像到
    `<应用输出>\modules\` —— 应用启动默认扫描该目录，内置模块开箱可用。
    该目录是**构建产物**（每次构建重建），不要手工往里放东西。
  -->
  <Target Name="MirrorBuiltInModulePackages" AfterTargets="Build">
    <ItemGroup>
      <BuiltInModuleFile Include="$(MSBuildThisFileDirectory)..\..\artifacts\modules\$(Configuration)\**\*" />
    </ItemGroup>

    <RemoveDir Directories="$(OutDir)modules" Condition="Exists('$(OutDir)modules')" />
    <MakeDir Directories="$(OutDir)modules" Condition="'@(BuiltInModuleFile)' != ''" />
    <Copy SourceFiles="@(BuiltInModuleFile)"
          DestinationFolder="$(OutDir)modules\%(RecursiveDir)"
          SkipUnchangedFiles="true"
          Condition="'@(BuiltInModuleFile)' != ''" />

    <Message Importance="high"
             Text="[built-in-modules] @(BuiltInModuleFile->'%(RecursiveDir)'->Distinct()) → $(OutDir)modules"
             Condition="'@(BuiltInModuleFile)' != ''" />
  </Target>

</Project>
