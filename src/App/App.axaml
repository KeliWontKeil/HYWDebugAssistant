<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HYWDebugAssistant.App.App"
             xmlns:local="using:HYWDebugAssistant.Ui"
             RequestedThemeVariant="Light">
             <!-- 默认浅色（C9-2）；深色主题后续由设置切换（V2）。 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 视觉 token（颜色角色 / 字体 / 尺寸；09 §2–§5） -->
                <ResourceInclude Source="avares://HYWDebugAssistant.Ui/Styles/Tokens.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!--
          **调色板控件的 Fluent 主题**：`Avalonia.Controls.ColorPicker` 里的 `ColorView`/`ColorPicker`
          **自带模板但要显式挂载**（`FluentTheme` 不含它的样式）—— 不挂的后果不是报错，而是
          **控件没有模板 ⇒ 什么都不画**。第三十四轮实测：调色板窗口只剩标题+提示+按钮，看起来像个"复位提示"。
        -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <!-- 统一控件尺寸与图标按钮样式（M1-16 / ADR-0040 D4） -->
        <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/Controls.axaml" />
    </Application.Styles>
</Application>
