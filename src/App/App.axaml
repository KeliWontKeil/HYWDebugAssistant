<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HYWDebugAssistant.App.App"
             xmlns:local="using:HYWDebugAssistant.Ui"
             RequestedThemeVariant="Light">
             <!-- 默认浅色（C9-2）；深色主题后续由设置切换（V2）。 -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 视觉 token（颜色角色 / 字体 / 尺寸） -->
                <ResourceInclude Source="avares://HYWDebugAssistant.Ui/Styles/Tokens.axaml" />
                <!-- 模块内容区的共用几何（预留带 / 文本行高） -->
                <ResourceInclude Source="avares://HYWDebugAssistant.Ui/Styles/ModuleMetrics.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <!--
          **调色板控件的 Fluent 主题**：`Avalonia.Controls.ColorPicker` 里的 `ColorView`/`ColorPicker`
          **自带模板但要显式挂载**（`FluentTheme` 不含它的样式）—— 不挂的后果不是报错，而是
          **控件没有模板 ⇒ 什么都不画**。第三十四轮实测：调色板窗口只剩标题+提示+按钮，看起来像个"复位提示"。
        -->
        <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
        <!-- 统一控件尺寸与图标按钮样式（M1-16 / ADR-0040 D4） -->
        <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/Controls.axaml" />
        <!--
          **按钮的壳与五态**：必须排在 `FluentTheme`（与 `Controls.axaml`）**之后** ——
          Fluent 有一条按模板部件名匹配的指针态样式，声明在前的会被它盖掉（实测：那条会给
          `ContentPresenter#PART_ContentPresenter` 刷半透明黑，屏幕上就是"我们的色发灰"）。
        -->
        <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/ButtonChrome.axaml" />
        <!--
          **Fluent 桥接表**：把模板自带的那些颜色（按钮文字 / 滚动条 / 下拉 / 列表选中 / 文本选中与光标 /
          禁用态 / 浮出层表面）接到角色 token 上。**必须排在最后**（同名属性"后声明者赢"）；
          桥接的是**控件属性**而不是猜 Fluent 的资源键名，理由见该文件头部说明。
        -->
        <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/FluentBridge.axaml" />
        <!--
          **模块控件库的默认观感**（`Sdk.Ui`）：控件自己的字号/间距/灯体尺寸。
          排在最后：它只在本库的类名上写这些，不与外壳或 Fluent 桥接争选择器；
          颜色仍走上面的 token（`DynamicResource`），换主题时这里一个字都不用改。
        -->
        <StyleInclude Source="avares://HYWDebugAssistant.Sdk.Ui/Themes/Controls.axaml" />
        <!--
          **输入控件的绘制**（`TextBox` / `ComboBox` / `ComboBoxItem` 的框、焦点圈、错误圈、候选项）：
          必须排在**最后**（在 `Sdk.Ui/Controls.axaml` 之后），用它覆盖 Fluent 的绘制；
          尺寸/字号仍由前面的 `Controls.axaml` 与 `Sdk.Ui` 给。
        -->
        <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/InputChrome.axaml" />
    </Application.Styles>
</Application>
