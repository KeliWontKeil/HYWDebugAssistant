<Project Sdk="Microsoft.NET.Sdk">

  <!--
    L1 契约层（模块作者唯一引用面）：分层与依赖见 docs/zh/concepts/layers.md
    硬约束：零框架依赖 —— 不得引任何 ProjectReference / PackageReference（AR-9 / C1-4）
    内容：模块特性与声明基元、生命周期钩子接口、上下文服务面、契约形状声明、上报 API
  -->
  <PropertyGroup>
    <!--
      NuGet 包：包版本 = 产品四段版本（由根 `version.props` 派生），不单独设 PackageVersion /
      AssemblyVersion —— 一个构建只允许一个版本字符串。
    -->
    <IsPackable>true</IsPackable>
    <PackageId>HYWDebugAssistant.Sdk</PackageId>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Description>HYWDebugAssistant 模块契约层（L1）：模块声明、生命周期、上下文服务面与上报 API。</Description>
    <!--
      模块作者拿不到框架源码：包内 XML 文档就是 API 的**唯一语义来源**（IDE 悬停即读）。
      随包发布 ⇒ 打开文档生成，`.xml` 由 `dotnet pack` 自动放进 `lib/net10.0/`。
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

</Project>
