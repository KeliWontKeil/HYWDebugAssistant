<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="HYWDebugAssistant.PreviewHost.PreviewApp"
             RequestedThemeVariant="Light">

  <!--
    **预览宿主不是产品 App**：只装模块视图需要的真实主题与 token，
    让预览器看到和运行时同一套控件外观。模块本身的窗口/端口/运行时不在预览范围内。
  -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://HYWDebugAssistant.Ui/Styles/Tokens.axaml" />
        <ResourceInclude Source="avares://HYWDebugAssistant.Ui/Styles/ModuleMetrics.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/Controls.axaml" />
    <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/ButtonChrome.axaml" />
    <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/FluentBridge.axaml" />
    <StyleInclude Source="avares://HYWDebugAssistant.Sdk.Ui/Themes/Controls.axaml" />
    <!-- 输入控件的绘制：与产品 App 同一份、同样排在最后。 -->
    <StyleInclude Source="avares://HYWDebugAssistant.Ui/Styles/InputChrome.axaml" />
  </Application.Styles>
</Application>
