<Project Sdk="Microsoft.NET.Sdk">

  <!--
    **XAML 预览器的可执行目标**。

    模块是类库，且由 App 动态扫描包加载，**没有任何可执行项目引用它们**；
    Avalonia 预览器因此无法为模块 `Views/*.axaml` 找到可用目标，显示
    "No Previewable Target"。本宿主只负责引用模块、提供 App/主题，让预览器
    在目标下拉框里有一个真实可执行项目可选；它不是产品入口，也不参与 App 发布。
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>HYWDebugAssistant.PreviewHost</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Ui\HYWDebugAssistant.Ui.csproj" />
    <!-- 外部标准 → 配置类型（预览器据此把 [ModuleViewDesignData(标准标识)] 画成字段）。 -->
    <ProjectReference Include="..\..\src\Access\HYWDebugAssistant.Access.csproj" />
    <!--
      **按目录发现模块**（不是手写清单）：新增模块项目只进 slnx 与目录，预览目标自动包含它。
      手写清单的代价是"新模块在预览器里永远没有目标"，而且没人会记得回来补。
    -->
    <ProjectReference Include="..\..\src\Modules\Business\*\*.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

</Project>
